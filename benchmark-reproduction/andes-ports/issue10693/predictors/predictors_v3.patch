+  // Prototype (#10693 step 2): extraction evidence, SVM-only (PIPECHO_EXTRA_PREDICTORS).
+  const auto m0_width = [](const Feature& f) -> double {
+    const auto& hulls = f.getConvexHulls();
+    if (hulls.empty()) { return 0.0; }
+    const auto bb = hulls[0].getBoundingBox();
+    return bb.isEmpty() ? 0.0 : bb.maxPosition()[0] - bb.minPosition()[0];
+  };
+  s.ffid_quality = acceptor.getOverallQuality();
+  const double wa = m0_width(acceptor), wd = m0_width(donor);
+  s.width_ratio = (wa > 0.0 && wd > 0.0) ? std::fabs(std::log2(wa / wd)) : 0.0;
+  s.n_traces = static_cast<double>(acceptor.getConvexHulls().size());
+
   return s;
 }
 
