+START_SECTION((static Size residueClass(const std::string& residues, bool prefix, Size ordinal)))
+{
+  using Model = FragmentIonLikelihoodModel;
+  TEST_EQUAL(Model::residueClass("ADPK", true, 2), 1)  // b2 | P
+  TEST_EQUAL(Model::residueClass("ADPK", false, 2), 1) // y2 = PK, same cleavage
+  TEST_EQUAL(Model::residueClass("AEGK", true, 2), 2)  // E | G
+  TEST_EQUAL(Model::residueClass("AEGK", false, 2), 2)
+  TEST_EQUAL(Model::residueClass("AGGK", true, 2), 0)
+  TEST_EQUAL(Model::residueClass("AGGK", true, 4), 0)  // no cleavage after the last residue
+  TEST_EQUAL(Model::residueClass("AGGK", false, 0), 0)
+  TEST_EQUAL(Model::residueClass("", true, 1), 0)
+}
+END_SECTION
+
+START_SECTION((void setResidueContext(bool on)))
+{
+  // Without residue context every ion of a position shares its probabilities, so the residues do not matter;
+  // with it, the proline cleavage learns its own outcome distribution.
+  const AASequence peptide = AASequence::fromString("ADPKLGEVK");
+  const std::string residues = peptide.toUnmodifiedString();
+  TheoreticalSpectrumGenerator tsg;
+  Param p = tsg.getParameters();
+  p.setValue("add_metainfo", "true");
+  tsg.setParameters(p);
+  PeakSpectrum theo;
+  tsg.getSpectrum(theo, peptide, 1, 1);
+  // Observed: only y7 (cleavage D|P) is present, intense.
+  MSSpectrum spec;
+  for (Size i = 0; i < theo.size(); ++i)
+  {
+    if (theo.getStringDataArrays()[0][i] == "y7+") { Peak1D peak(theo[i].getMZ(), 100.0f); spec.push_back(peak); }
+  }
+  spec.push_back(Peak1D(150.0, 1.0f));
+  spec.sortByPosition();
+  const std::vector<Size> ranks = FragmentIonLikelihoodModel::intensityRanks(spec);
+  FragmentIonLikelihoodModel plain, with_residues;
+  with_residues.setResidueContext(true);
+  TEST_EQUAL(with_residues.residueContext(), true)
+  for (Size i = 0; i < 30; ++i)
+  {
+    plain.addObservations(spec, ranks, theo, peptide.size(), 2, 0.02, false, false, residues);
+    with_residues.addObservations(spec, ranks, theo, peptide.size(), 2, 0.02, false, false, residues);
+  }
+  plain.finalize();
+  with_residues.finalize();
+  FragmentIonLikelihoodModel::Context proline = FragmentIonLikelihoodModel::contextOf(false, 2, 1, 7, peptide.size());
+  FragmentIonLikelihoodModel::Context other = proline;
+  proline.residue_class = 1;
+  // Without residue context both classes of the position are the same cell distribution.
+  TEST_REAL_SIMILAR(plain.presenceProbability(proline), plain.presenceProbability(other))
+  // With it, the always observed proline cleavage is more likely present than the class it was split from.
+  TEST_EQUAL(with_residues.presenceProbability(proline) > plain.presenceProbability(proline), true)
+}
+END_SECTION
