+  Size FragmentIonLikelihoodModel::residueClass(const std::string& residues, bool prefix, Size ordinal)
+  {
+    // The cleavage that forms the ion lies between residues left and left + 1 (0-based).
+    const Size n = residues.size();
+    if (ordinal == 0 || ordinal >= n) return 0;
+    const Size left = prefix ? ordinal - 1 : n - ordinal - 1;
+    if (residues[left + 1] == 'P') return 1;
+    if (residues[left] == 'D' || residues[left] == 'E') return 2;
+    return 0;
+  }
