{
  "name": "openms",
  "version-string": "3.6.0",
  "dependencies": [
    {
      "name": "arrow",
      "default-features": false,
      "features": [
        "compute",
        "dataset",
        "filesystem",
        "json",
        "parquet"
      ]
    },
    "boost-accumulators",
    "boost-algorithm",
    "boost-array",
    "boost-asio",
    "boost-assign",
    "boost-bimap",
    "boost-bind",
    "boost-config",
    "boost-container",
    "boost-container-hash",
    "boost-date-time",
    "boost-dynamic-bitset",
    "boost-foreach",
    "boost-function",
    "boost-graph",
    "boost-headers",
    "boost-heap",
    "boost-interprocess",
    "boost-iostreams",
    "boost-iterator",
    "boost-lexical-cast",
    "boost-math",
    "boost-multi-index",
    "boost-numeric-conversion",
    "boost-process",
    "boost-random",
    "boost-range",
    "boost-regex",
    "boost-serialization",
    "boost-smart-ptr",
    "boost-sort",
    "boost-spirit",
    "boost-type-traits",
    "boost-unordered",
    "boost-variant",
    "bzip2",
    "coin-or-cbc",
    "coin-or-cgl",
    "coin-or-clp",
    "coin-or-osi",
    "coinutils",
    "curl",
    "eigen3",
    "libsvm",
    "libxml2",
    "libzip",
    "xerces-c",
    "zlib"
  ],
  "features": {
    "hdf5": {
      "description": "HDF5 C and C++ libraries for builds configured with -DWITH_HDF5=ON.",
      "dependencies": [
        {
          "name": "hdf5",
          "features": [
            "cpp"
          ]
        }
      ]
    },
    "lp-glpk": {
      "description": "GLPK solver dependency for builds configured with -DLP_SOLVER=GLPK.",
      "dependencies": [
        {
          "name": "glpk",
          "default-features": false
        }
      ]
    },
    "lp-highs": {
      "description": "HiGHS solver dependency for builds configured with -DLP_SOLVER=HIGHS.",
      "dependencies": [
        "highs"
      ]
    }
  }
}
