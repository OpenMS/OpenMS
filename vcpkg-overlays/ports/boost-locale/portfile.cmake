# Copy of the boost-locale port of the vcpkg baseline (generated by
# scripts/boost/generate-ports.ps1) plus fix-cmake-4.5-source-group.patch.
#
# CMake 4.5 checks the root of source_group(TREE) per path component; before,
# it was a string prefix. Boost.Locale 1.91 (and 1.92) passes
# include/boost/locale.hpp to the include/boost/locale tree, which CMake 4.5
# rejects ("... is not a prefix of file ..."), so the port fails to configure.
# The patch is boostorg/locale@1d07074 + boostorg/locale@f51b58c from develop.
# Remove this overlay once the vcpkg baseline has a Boost.Locale release with
# that fix.

vcpkg_from_github(
    OUT_SOURCE_PATH SOURCE_PATH
    REPO boostorg/locale
    REF boost-${VERSION}
    SHA512 bcdd96e856facc8d585c696066757ae8138283bad6b1d14a1ab3083b53098d997ed42de6f4498aec47f365d6e2c3387376dd8436792d3809760287e131cd4e11
    HEAD_REF master
    PATCHES
        fix-cmake-4.5-source-group.patch
)

set(FEATURE_OPTIONS "")
include("${CMAKE_CURRENT_LIST_DIR}/features.cmake")
if(CMAKE_HOST_SYSTEM_NAME STREQUAL "Linux" AND VCPKG_TARGET_IS_MINGW)
    # mingw cross compile toolchain lacks std conv support
    list(APPEND FEATURE_OPTIONS "-DBOOST_LOCALE_ENABLE_STD=OFF")
endif()
boost_configure_and_install(
    SOURCE_PATH "${SOURCE_PATH}"
    OPTIONS ${FEATURE_OPTIONS}
)
