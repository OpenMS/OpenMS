{
    "version": 3,
    "configurePresets": [
        {
            "name": "base",
            "hidden": true,
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/${presetName}",
            "architecture": {
                "value": "x64",
                "strategy": "external"
            },
            "cacheVariables": {
                "BOOST_USE_STATIC": "OFF",
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
                "CMAKE_COLOR_DIAGNOSTICS": "ON"
            }
        },
        {
            "name": "linux",
            "displayName": "Linux (vcpkg)",
            "description": "Builds with core dependencies from the pinned vcpkg manifest",
            "inherits": "base",
            "cacheVariables": {
                "OPENMS_USE_VCPKG": "ON",
                "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/vcpkg/scripts/buildsystems/vcpkg.cmake",
                "VCPKG_TARGET_TRIPLET": "x64-linux-dynamic"
            },
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Linux"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "debug",
            "hidden": true,
            "configuration": "Debug"
        },
        {
            "name": "release",
            "hidden": true,
            "configuration": "Release"
        },
        {
            "name": "linux-debug",
            "displayName": "Debug",
            "configurePreset": "linux",
            "inherits": "debug"
        },
        {
            "name": "linux-release",
            "displayName": "Release",
            "configurePreset": "linux",
            "inherits": "release"
        }
    ]
}