    "testPresets": [
        {
            "name": "test-base",
            "hidden": true,
            "output": {
                "outputOnFailure": true
            },
            "execution": {
                "noTestsAction": "error"
            }
        },
        {
            "name": "test-base-ci",
            "hidden": true,
            "execution": {
                "jobs": 4
            }
        },
        {
            "name": "linux-x64-debug",
            "configurePreset": "linux-x64-debug",
