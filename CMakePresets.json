{
    "version": 3,
    "configurePresets": [
        {
            "name": "base",
            "hidden": true,
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/${presetName}",
            "cacheVariables": {
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
                "CMAKE_COLOR_DIAGNOSTICS": "ON",
                "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/vcpkg/scripts/buildsystems/vcpkg.cmake",
                "OPENMS_USE_VCPKG": "ON",
                "BOOST_USE_STATIC": "OFF"
            }
        },
        {
            "name": "linux-base",
            "hidden": true,
            "inherits": "base",
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Linux"
            }
        },
        {
            "name": "macos-base",
            "hidden": true,
            "inherits": "base",
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Darwin"
            }
        },
        {
            "name": "windows-base",
            "hidden": true,
            "inherits": "base",
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Windows"
            }
        },
        {
            "name": "linux-x64-base",
            "hidden": true,
            "inherits": "linux-base",
            "cacheVariables": {
                "VCPKG_TARGET_TRIPLET": "x64-linux-dynamic"
            }
        },
        {
            "name": "linux-arm64-base",
            "hidden": true,
            "inherits": "linux-base",
            "cacheVariables": {
                "VCPKG_TARGET_TRIPLET": "arm64-linux-dynamic"
            }
        },
        {
            "name": "macos-arm64-base",
            "hidden": true,
            "inherits": "macos-base",
            "cacheVariables": {
                "VCPKG_TARGET_TRIPLET": "arm64-osx-dynamic-sysroot"
            }
        },
        {
            "name": "windows-x64-base",
            "hidden": true,
            "inherits": "windows-base",
            "cacheVariables": {
                "VCPKG_TARGET_TRIPLET": "x64-windows-static-md-release",
                "BOOST_USE_STATIC": "ON"
            }
        },
        {
            "name": "debug-base",
            "hidden": true,
            "inherits": "base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "release-base",
            "hidden": true,
            "inherits": "base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        },
        {
            "name": "relwithdebinfo-base",
            "hidden": true,
            "inherits": "base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "RelWithDebInfo"
            }
        },
        {
            "name": "ci-base",
            "hidden": true,
            "cacheVariables": {
                "WITH_GUI": "OFF",
                "BUILD_TOPP_TOOLS": "OFF",
                "WITH_THERMO_RAW":"ON",
                "ENABLE_THERMO_RAW_TESTS": "ON",
                "ENABLE_TUTORIALS": "OFF",
                "WITH_ONNX": "ON",
                "WITH_OPENTIMS":"ON",
                "ENABLE_OPENTIMS_TESTS": "OFF",
                "WITH_WNETALIGN": "ON",
                "USE_EXTERNAL_JSON": "ON",
                "USE_EXTERNAL_SQLITECPP": "ON",
                "USE_EXTERNAL_SIMDE": "ON",
                "USE_EXTERNAL_ISOSPEC":"ON",
                "USE_EXTERNAL_EOLBSPLINE":"ON",
                "WITH_HDF5": "OFF",
                "PYOPENMS":"OFF",
                "VCPKG_MANIFEST_FEATURES":"isospec;eol-bspline;simde;nlohmann-json;sqlitecpp;wnetalign;openms-thermo-bridge;opentims;onnxruntime"
            }
        },
        {
            "name": "linux-x64-debug",
            "displayName": "Linux x64 Debug",
            "description": "OpenMS with vcpkg dependencies on Linux x64 Debug",
            "inherits": [
                "linux-x64-base",
                "debug-base"
            ]
        },
        {
            "name": "linux-x64-relwithdebinfo",
            "displayName": "Linux x64 RelWithDebInfo",
            "description": "OpenMS with vcpkg dependencies on Linux x64 RelWithDebInfo",
            "inherits": [
                "linux-x64-base",
                "relwithdebinfo-base"
            ]
        },
        {
            "name": "linux-x64-release",
            "displayName": "Linux x64 Release",
            "description": "OpenMS with vcpkg dependencies on Linux x64 Release",
            "inherits": [
                "linux-x64-base",
                "release-base"
            ]
        },
        {
            "name": "linux-arm64-debug",
            "displayName": "Linux arm64 Debug",
            "description": "OpenMS with vcpkg dependencies on Linux arm64 Debug",
            "inherits": [
                "linux-arm64-base",
                "debug-base"
            ]
        },
        {
            "name": "linux-arm64-relwithdebinfo",
            "displayName": "Linux arm64 RelWithDebInfo",
            "description": "OpenMS with vcpkg dependencies on Linux arm64 RelWithDebInfo",
            "inherits": [
                "linux-arm64-base",
                "relwithdebinfo-base"
            ]
        },
        {
            "name": "linux-arm64-release",
            "displayName": "Linux arm64 Release",
            "description": "OpenMS with vcpkg dependencies on Linux arm64 Release",
            "inherits": [
                "linux-arm64-base",
                "release-base"
            ]
        },
        {
            "name": "macos-arm64-debug",
            "displayName": "MacOS arm64 Debug",
            "description": "OpenMS with vcpkg dependencies on MacOS arm64 Debug",
            "inherits": [
                "macos-arm64-base",
                "debug-base"
            ]
        },
        {
            "name": "macos-arm64-relwithdebinfo",
            "displayName": "MacOS arm64 RelWithDebInfo",
            "description": "OpenMS with vcpkg dependencies on MacOS arm64 RelWithDebInfo",
            "inherits": [
                "macos-arm64-base",
                "relwithdebinfo-base"
            ]
        },
        {
            "name": "macos-arm64-release",
            "displayName": "MacOS arm64 Release",
            "description": "OpenMS with vcpkg dependencies on MacOS arm64 Release",
            "inherits": [
                "macos-arm64-base",
                "release-base"
            ]
        },
        {
            "name": "windows-x64-debug",
            "displayName": "Windows x64 Debug",
            "description": "OpenMS with vcpkg dependencies on Windows x64 Debug",
            "inherits": [
                "windows-x64-base",
                "debug-base"
            ]
        },
        {
            "name": "windows-x64-relwithdebinfo",
            "displayName": "Windows x64 RelWithDebInfo",
            "description": "OpenMS with vcpkg dependencies on Windows x64 RelWithDebInfo",
            "inherits": [
                "windows-x64-base",
                "relwithdebinfo-base"
            ]
        },
        {
            "name": "windows-x64-release",
            "displayName": "Windows x64 Release",
            "description": "OpenMS with vcpkg dependencies on Windows x64 Release",
            "inherits": [
                "windows-x64-base",
                "release-base"
            ]
        },
        {
            "name": "linux-x64-ci",
            "displayName": "Linux x64 CI",
            "description": "OpenMS CI preset with vcpkg dependencies on Linux x64",
            "inherits": [
                "linux-x64-base",
                "release-base",
                "ci-base"
            ]
        },
        {
            "name": "linux-arm64-ci",
            "displayName": "Linux arm64 CI",
            "description": "OpenMS CI preset with vcpkg dependencies on Linux arm64",
            "inherits": [
                "linux-arm64-base",
                "release-base",
                "ci-base"
            ],
            "cacheVariables": {
                "ENABLE_DOCS": "OFF",
                "WITH_THERMO_RAW":"OFF",
                "ENABLE_THERMO_RAW_TESTS": "OFF"
            }
        },
        {
            "name": "macos-arm64-ci",
            "displayName": "macOS arm64 CI",
            "description": "OpenMS CI preset with vcpkg dependencies on macOS arm64",
            "inherits": [
                "macos-arm64-base",
                "release-base",
                "ci-base"
            ],
            "cacheVariables": {
                "ENABLE_DOCS": "OFF"
            }
        },
        {
            "name": "windows-x64-ci",
            "displayName": "Windows x64 CI",
            "description": "OpenMS CI preset with vcpkg dependencies on Windows x64",
            "inherits": [
                "windows-x64-base",
                "release-base",
                "ci-base"
            ],
            "cacheVariables": {
                "ENABLE_DOCS": "OFF"
            }
        }
    ],
