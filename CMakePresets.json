{
    "version": 3,
    "configurePresets": [
        {
            "name": "base",
            "hidden": true,
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/${presetName}",
            "cacheVariables": {
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
                "CMAKE_COLOR_DIAGNOSTICS": "ON",
                "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/vcpkg/scripts/buildsystems/vcpkg.cmake",
                "OPENMS_USE_VCPKG": "ON"
            }
        },
        {
            "name": "linux-base",
            "hidden": true,
            "inherits": "base",
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Linux"
            }
        },
        {
            "name": "macos-base",
            "hidden": true,
            "inherits": "base",
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Darwin"
            }
        },
        {
            "name": "windows-base",
            "hidden": true,
            "inherits": "base",
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Windows"
            }
        },
        {
            "name": "linux-x64-base",
            "hidden": true,
            "inherits": "linux-base",
            "cacheVariables": {
                "VCPKG_TARGET_TRIPLET": "x64-linux-dynamic"
            }
        },
        {
            "name": "linux-arm64-base",
            "hidden": true,
            "inherits": "linux-base",
            "cacheVariables": {
                "VCPKG_TARGET_TRIPLET": "arm64-linux-dynamic"
            }
        },
        {
            "name": "macos-arm64-base",
            "hidden": true,
            "inherits": "macos-base",
            "description": "OpenMP_ROOT is where Homebrew on Apple silicon keeps its keg-only libomp (tools/ci/deps-macos.sh installs it). Apple's Clang ships no OpenMP runtime, so without it OpenMS falls back to -fopenmp-simd and runs single-threaded. Pass -DOpenMP_ROOT=$(brew --prefix libomp) for another Homebrew prefix.",
            "cacheVariables": {
                "VCPKG_TARGET_TRIPLET": "arm64-osx-dynamic-sysroot",
                "OpenMP_ROOT": "/opt/homebrew/opt/libomp"
            }
        },
        {
            "name": "windows-x64-base",
            "hidden": true,
            "inherits": "windows-base",
            "description": "Windows x64 settings that do not depend on the build type. VCPKG_TARGET_TRIPLET is deliberately NOT set here: unlike Linux and macOS, whose triplets build every dependency in both debug and release form and so suit any configuration, the Windows triplets differ in exactly that respect, so each preset below has to name the one that matches its build type."
        },
        {
            "name": "debug-base",
            "hidden": true,
            "inherits": "base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "release-base",
            "hidden": true,
            "inherits": "base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        },
        {
            "name": "relwithdebinfo-base",
            "hidden": true,
            "inherits": "base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "RelWithDebInfo"
            }
        },
        {
            "name": "ci-base",
            "hidden": true,
            "cacheVariables": {
                "OPENMS_TEST_INSTALLED_CONSUMER": "ON",
                "MT_REQUIRE_OPENMP": "ON",
                "WITH_GUI": "ON",
                "ENABLE_DOCS": "ON",
                "WITH_THERMO_RAW":"ON",
                "ENABLE_THERMO_RAW_TESTS": "OFF",
                "ENABLE_TUTORIALS": "OFF",
                "WITH_ONNX": "ON",
                "WITH_OPENTIMS":"ON",
                "ENABLE_OPENTIMS_TESTS": "OFF",
                "WITH_WNETALIGN": "OFF",
                "USE_EXTERNAL_JSON": "ON",
                "USE_EXTERNAL_SQLITECPP": "ON",
                "USE_EXTERNAL_SIMDE": "ON",
                "USE_EXTERNAL_ISOSPEC":"ON",
                "USE_EXTERNAL_EOLBSPLINE":"ON",
                "WITH_HDF5": "OFF",
                "PYOPENMS":"OFF",
                "VCPKG_MANIFEST_FEATURES":"isospec;eol-bspline;simde;nlohmann-json;sqlitecpp;openms-thermo-bridge;opentims;onnxruntime"
            }
        },
        {
            "name": "linux-x64-debug",
            "displayName": "Linux x64 Debug",
            "description": "OpenMS with vcpkg dependencies on Linux x64 Debug",
            "inherits": [
                "linux-x64-base",
                "debug-base"
            ]
        },
        {
            "name": "linux-x64-relwithdebinfo",
            "displayName": "Linux x64 RelWithDebInfo",
            "description": "OpenMS with vcpkg dependencies on Linux x64 RelWithDebInfo",
            "inherits": [
                "linux-x64-base",
                "relwithdebinfo-base"
            ]
        },
        {
            "name": "linux-x64-release",
            "displayName": "Linux x64 Release",
            "description": "OpenMS with vcpkg dependencies on Linux x64 Release",
            "inherits": [
                "linux-x64-base",
                "release-base"
            ]
        },
        {
            "name": "linux-arm64-debug",
            "displayName": "Linux arm64 Debug",
            "description": "OpenMS with vcpkg dependencies on Linux arm64 Debug",
            "inherits": [
                "linux-arm64-base",
                "debug-base"
            ]
        },
        {
            "name": "linux-arm64-relwithdebinfo",
            "displayName": "Linux arm64 RelWithDebInfo",
            "description": "OpenMS with vcpkg dependencies on Linux arm64 RelWithDebInfo",
            "inherits": [
                "linux-arm64-base",
                "relwithdebinfo-base"
            ]
        },
        {
            "name": "linux-arm64-release",
            "displayName": "Linux arm64 Release",
            "description": "OpenMS with vcpkg dependencies on Linux arm64 Release",
            "inherits": [
                "linux-arm64-base",
                "release-base"
            ]
        },
        {
            "name": "macos-arm64-debug",
            "displayName": "MacOS arm64 Debug",
            "description": "OpenMS with vcpkg dependencies on MacOS arm64 Debug",
            "inherits": [
                "macos-arm64-base",
                "debug-base"
            ]
        },
        {
            "name": "macos-arm64-relwithdebinfo",
            "displayName": "MacOS arm64 RelWithDebInfo",
            "description": "OpenMS with vcpkg dependencies on MacOS arm64 RelWithDebInfo",
            "inherits": [
                "macos-arm64-base",
                "relwithdebinfo-base"
            ]
        },
        {
            "name": "macos-arm64-release",
            "displayName": "MacOS arm64 Release",
            "description": "OpenMS with vcpkg dependencies on MacOS arm64 Release",
            "inherits": [
                "macos-arm64-base",
                "release-base"
            ]
        },
        {
            "name": "windows-x64-debug",
            "displayName": "Windows x64 Debug",
            "description": "OpenMS with vcpkg dependencies on Windows x64 Debug. A Debug build links the debug CRT (/MDd) and must not be mixed with release dependencies, so it uses x64-windows-static-md, which sets no VCPKG_BUILD_TYPE and therefore builds every dependency in both debug and release form. There is no working debug-only alternative: ports install their headers from the release half. The Debug build links the debug half, so this preset's first configure is slower than the other Windows presets. It is also the preset to use for a multi-configuration Visual Studio solution, being the only one whose dependencies cover both configurations.",
            "inherits": [
                "windows-x64-base",
                "debug-base"
            ],
            "cacheVariables": {
                "VCPKG_TARGET_TRIPLET": "x64-windows-static-md"
            }
        },
        {
            "name": "windows-x64-relwithdebinfo",
            "displayName": "Windows x64 RelWithDebInfo",
            "description": "OpenMS with vcpkg dependencies on Windows x64 RelWithDebInfo. RelWithDebInfo links the release CRT (/MD), so the release-only triplet is sufficient and avoids building every dependency twice.",
            "inherits": [
                "windows-x64-base",
                "relwithdebinfo-base"
            ],
            "cacheVariables": {
                "VCPKG_TARGET_TRIPLET": "x64-windows-static-md-release"
            }
        },
        {
            "name": "windows-x64-release",
            "displayName": "Windows x64 Release",
            "description": "OpenMS with vcpkg dependencies on Windows x64 Release. Release links the release CRT (/MD), so the release-only triplet is sufficient and avoids building every dependency twice.",
            "inherits": [
                "windows-x64-base",
                "release-base"
            ],
            "cacheVariables": {
                "VCPKG_TARGET_TRIPLET": "x64-windows-static-md-release"
            }
        },
        {
            "name": "wasm32-emscripten-release",
            "displayName": "WebAssembly (Emscripten) Release",
            "description": "The OpenMS libraries and their JavaScript bindings (src/openms_wasm) for WebAssembly, with vcpkg dependencies built for the wasm32-emscripten triplet (vcpkg-overlays/triplets). Needs the Emscripten SDK in the environment (source emsdk_env.sh, which sets EMSDK). vcpkg-overlays/emscripten adds the ports that need changes for WebAssembly; native builds do not use it. cmake/emscripten.cmake sets the defaults of this build.",
            "inherits": [
                "base",
                "release-base"
            ],
            "cacheVariables": {
                "VCPKG_TARGET_TRIPLET": "wasm32-emscripten",
                "VCPKG_CHAINLOAD_TOOLCHAIN_FILE": "$env{EMSDK}/upstream/emscripten/cmake/Modules/Platform/Emscripten.cmake",
                "VCPKG_OVERLAY_PORTS": "${sourceDir}/vcpkg-overlays/emscripten/ports"
            }
        },
        {
            "name": "wasm32-emscripten-mt-release",
            "displayName": "WebAssembly (Emscripten) Release, multi-threaded",
            "description": "Like wasm32-emscripten-release, but with threads: OpenMP (Emscripten's libomp) and std::thread on WebAssembly threads (Web Workers sharing memory). The dependencies are built for the wasm32-emscripten-mt triplet. The JavaScript module is published as @openms/openms-wasm-mt; in browsers it needs a cross-origin isolated page for more than one thread (see src/openms_wasm/README.md).",
            "inherits": "wasm32-emscripten-release",
            "cacheVariables": {
                "VCPKG_TARGET_TRIPLET": "wasm32-emscripten-mt",
                "OPENMS_WASM_THREADS": "ON"
            }
        },
        {
            "name": "wasm32-emscripten-mt-onnx-release",
            "displayName": "WebAssembly (Emscripten) Release, multi-threaded, with ONNX Runtime",
            "description": "Like wasm32-emscripten-mt-release, with ONNX Runtime (WITH_ONNX) in the module for machine-learning models, e.g. the PeptDeep features of ProSE (peptdeep:enable). vcpkg builds ONNX Runtime for WebAssembly (vcpkg-overlays/emscripten/ports/onnxruntime); the PeptDeep models are copied to models/ of the package (see src/openms_wasm/README.md).",
            "inherits": "wasm32-emscripten-mt-release",
            "cacheVariables": {
                "WITH_ONNX": "ON",
                "VCPKG_MANIFEST_FEATURES": "onnxruntime"
            }
        },
        {
            "name": "wasm64-emscripten-mt-release",
            "displayName": "WebAssembly (Emscripten) Release, multi-threaded, 64-bit memory",
            "description": "Like wasm32-emscripten-mt-release, with 64-bit memory (Memory64, wasm64): the module can address more than the 4 GiB of wasm32, up to 16 GiB (the limit of browsers; Safari does not support Memory64). The dependencies are built for the wasm64-emscripten-mt triplet. -m64 (64-bit memory) is in CMAKE_C_FLAGS and CMAKE_CXX_FLAGS because Emscripten's toolchain file takes the pointer size from them (cmake/emscripten.cmake).",
            "inherits": "wasm32-emscripten-mt-release",
            "cacheVariables": {
                "VCPKG_TARGET_TRIPLET": "wasm64-emscripten-mt",
                "OPENMS_WASM_MEMORY64": "ON",
                "CMAKE_C_FLAGS": "-m64",
                "CMAKE_CXX_FLAGS": "-m64"
            }
        },
        {
            "name": "linux-x64-ci",
            "displayName": "Linux x64 CI",
            "description": "OpenMS CI preset with vcpkg dependencies on Linux x64",
            "inherits": [
                "linux-x64-base",
                "release-base",
                "ci-base"
            ],
            "cacheVariables": {
                "OPENMS_VERIFY_INTERFACE_HEADER_SETS": "ON"
            }
        },
        {
            "name": "linux-arm64-ci",
            "displayName": "Linux arm64 CI",
            "description": "OpenMS CI preset with vcpkg dependencies on Linux arm64",
            "inherits": [
                "linux-arm64-base",
                "release-base",
                "ci-base"
            ]
        },
        {
            "name": "macos-arm64-ci",
            "displayName": "macOS arm64 CI",
            "description": "OpenMS CI preset with vcpkg dependencies on macOS arm64",
            "inherits": [
                "macos-arm64-base",
                "release-base",
                "ci-base"
            ]
        },
        {
            "name": "windows-x64-ci",
            "displayName": "Windows x64 CI",
            "description": "OpenMS CI preset with vcpkg dependencies on Windows x64. Builds Release, so the release-only triplet is sufficient and avoids building every dependency twice.",
            "inherits": [
                "windows-x64-base",
                "release-base",
                "ci-base"
            ],
            "cacheVariables": {
                "VCPKG_TARGET_TRIPLET": "x64-windows-static-md-release"
            }
        }
    ],
    "buildPresets": [
