<?xml version="1.0" encoding="UTF-8"?>
<!--
  Copyright (c) 2002-present, OpenMS Inc. - EKU Tuebingen, ETH Zurich, and FU Berlin
  (XML comments cannot contain a double hyphen, hence the single dash here.)
  SPDX-License-Identifier: BSD-3-Clause

  Hand-authored WiX sources for everything the MSI needs beyond the plain file
  payload. CPack's WIX generator emits the directory/file/component tree from
  our install() rules; this file adds what the NSIS template used to do by hand:

    * PATH entries for bin/ and each installed THIRDPARTY tool directory
      (replaces EnvVarUpdate.nsh; MSI's Environment table handles append,
      removal on uninstall and rollback natively, with no 8k-string limit and
      therefore no need for the patched 'special build' of NSIS)
    * Start menu shortcuts (replaces CreateSMGroupShortcut)
    * File-type registration for the TOPPView/TOPPAS extensions
      (replaces IncludeScript_Misc.nsh's RegisterExtension)

  Configured by cmake/package_wix.cmake at CMake configure time; linked into
  the package via CPACK_WIX_EXTRA_SOURCES.

  Note on Root="HKMU": HKMU resolves to HKLM for a perMachine package and to
  HKCU for a perUser one, so these fragments do not have to change if the
  install scope is ever revisited.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">

  <!-- ############################ PATH ############################ -->
  <Fragment>
    <ComponentGroup Id="OpenMSEnvironment" Directory="INSTALL_ROOT">
      <Component Id="OpenMS_Path_Bin">
        <RegistryValue Root="HKMU" Key="@OPENMS_WIX_REGKEY@\Components"
                       Name="PathBin" Type="integer" Value="1" KeyPath="yes"/>
        <Environment Id="OpenMSPathBin" Name="PATH" Value="[INSTALL_ROOT]@OPENMS_WIX_BIN_DIR_W@"
                     Action="set" Part="last" Permanent="no" System="@OPENMS_WIX_ENV_SYSTEM@"/>
      </Component>
@OPENMS_WIX_THIRDPARTY_PATH_COMPONENTS@
    </ComponentGroup>
  </Fragment>

  <!-- ####################### Start menu ########################### -->
  <Fragment>
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="OpenMSMenuFolder" Name="@OPENMS_WIX_MENU_FOLDER@"/>
    </StandardDirectory>

    <ComponentGroup Id="OpenMSShortcuts">
      <Component Id="OpenMS_Shortcuts" Directory="OpenMSMenuFolder">
        <RegistryValue Root="HKMU" Key="@OPENMS_WIX_REGKEY@\Components"
                       Name="Shortcuts" Type="integer" Value="1" KeyPath="yes"/>

        <Shortcut Id="sc_TOPPView" Name="TOPPView"
                  Target="[INSTALL_ROOT]@OPENMS_WIX_BIN_DIR_W@\TOPPView.exe"
                  WorkingDirectory="INSTALL_ROOT"/>
        <Shortcut Id="sc_TOPPAS" Name="TOPPAS"
                  Target="[INSTALL_ROOT]@OPENMS_WIX_BIN_DIR_W@\TOPPAS.exe"
                  WorkingDirectory="INSTALL_ROOT"/>
        <Shortcut Id="sc_INIFileEditor" Name="INIFileEditor"
                  Target="[INSTALL_ROOT]@OPENMS_WIX_BIN_DIR_W@\INIFileEditor.exe"
                  WorkingDirectory="INSTALL_ROOT"/>
        <Shortcut Id="sc_TOPPShell" Name="TOPP command line"
                  Target="[INSTALL_ROOT]@OPENMS_WIX_BIN_DIR_W@\command.bat"
                  WorkingDirectory="INSTALL_ROOT"/>

        <RemoveFolder Id="rm_OpenMSMenuFolder" Directory="OpenMSMenuFolder" On="uninstall"/>
      </Component>
    </ComponentGroup>
  </Fragment>

  <!-- ################### File associations ######################## -->
  <!--
    Written as explicit registry values rather than <ProgId>/<Extension>.
    <Verb> wants a TargetFile pointing at a File element, and the File ids for
    TOPPView.exe/TOPPAS.exe are generated by CPack at packaging time
    (CM_FP_<mangled path>), so they cannot be referenced from a hand-authored
    fragment. Registry values give the same result, are removed on uninstall
    just the same, and do not depend on CPack's id mangling.
  -->
  <Fragment>
    <ComponentGroup Id="OpenMSFileAssociations" Directory="INSTALL_ROOT">
@OPENMS_WIX_FILE_ASSOCIATION_COMPONENTS@
    </ComponentGroup>
  </Fragment>

</Wix>
