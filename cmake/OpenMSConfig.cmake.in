@PACKAGE_INIT@

### CMake package configuration of OpenMS for external code.
### Configured by the OpenMS build system from <OpenMS>/cmake/OpenMSConfig.cmake.in.
###
### The installed package is layered: an installation contains the core layer and
### optionally the CLI layer on top of it (see cmake/install_macros.cmake for the
### install components of each layer). The GUI layer is built by the repository
### OpenMS-TOPP-GUI and installed into the same prefix with a CMake package of its
### own, OpenMSGUI (lib/cmake/OpenMSGUI, or CMake/ on Windows).
### find_package(OpenMS CONFIG) provides the imported targets of the layers present:
###   OpenMS::OpenMS         the OpenMS library                   (component Core, always)
###   OpenMS::OpenSwathAlgo  the OpenSWATH algorithm library      (component OpenSwathAlgo, always)
###   OpenMS::OpenMS_CLI     the TOPP tool framework (TOPPBase, ToolHandler, ...); a
###                          TOPP-style tool links this            (component CLI; install
###                          components library_cli and cmake_cli)
###   OpenMS::OpenMS_GUI     the GUI library of OpenMS-TOPP-GUI    (component GUI; when its
###                          OpenMSGUI package of this version is installed next to this
###                          file, also without requesting the component)
### and, for projects written against earlier releases, the un-namespaced aliases
### OpenMS and OpenSwathAlgo, plus OpenMS_CLI and OpenMS_GUI when those layers are
### present. A core-only installation (install
### components library, OpenMS_headers, OpenSwathAlgo_headers, thirdparty_headers,
### share and cmake, e.g. what the pyOpenMS wheels are built against) provides the
### first two targets; requesting COMPONENTS CLI fails on it. Requesting COMPONENTS GUI
### (or OPTIONAL_COMPONENTS GUI) loads the OpenMSGUI package, which also finds the Qt6
### modules the GUI library links. Without it, the GUI layer's targets are included
### without a Qt lookup, and a consumer that links OpenMS::OpenMS_GUI finds Qt6 itself
### (set OpenMS_IGNORE_GUI_LAYER to TRUE before find_package to leave them out, e.g. in
### OpenMS-TOPP-GUI itself, which builds that target).
###
### Variables:
###   OpenMS_VERSION                        version of this installation (X.Y.Z)
###   OpenMS_VERSION_FULLSTRING             full version string of this installation, as
###                                         used in package names: X.Y.Z for a release,
###                                         X.Y.Z-pre-<prerelease> otherwise
###   OpenMS_VERSION_PRERELEASE             prerelease identifier (<branch>-<date>; empty
###                                         for a release)
###   OpenMS_CLI_FOUND                      the CLI layer is part of this installation
###   OpenMS_GUI_FOUND                      the GUI component was requested and the
###                                         OpenMSGUI package was found
###   OpenMS_WITH_GUI                       the GUI layer is part of this installation
###                                         (OpenMS::OpenMS_GUI exists)
###   OpenMS_WITH_HDF5, OpenMS_WITH_OPENTIMS, OpenMS_WITH_THERMO_RAW, OpenMS_WITH_ONNX,
###   OpenMS_WITH_OPENMP, OpenMS_WITH_WNETALIGN, OpenMS_BUILD_TOPP_TOOLS
###                                         build options of this installation
###   OPENMS_DATA_DIR (= OPENMS_SHARE_DIR), OPENMS_LIB_DIR, OPENMS_BIN_DIR, OPENMS_DOC_DIR
###                                         directories of this installation

# Consumers use exported header file sets and share the build's CMake minimum.
if(CMAKE_VERSION VERSION_LESS 3.24)
  set(OpenMS_FOUND FALSE)
  set(OpenMS_NOT_FOUND_MESSAGE
      "OpenMS requires CMake 3.24 or newer in the consuming project (running ${CMAKE_VERSION}).")
  return()
endif()

#------------------------------------------------------------------------------
# Directories of this installation.
# They expand PACKAGE_PREFIX_DIR, which @PACKAGE_INIT@ derived from the location
# of this file. Every package configuration generated with
# configure_package_config_file() (Eigen3Config.cmake among them) resets that
# variable to its own prefix when a dependency lookup below includes it, so the
# directories have to be evaluated before any dependency is searched.
set(OPENMS_DATA_DIR "@PACKAGE_INSTALL_SHARE_DIR@")
set(OPENMS_SHARE_DIR "${OPENMS_DATA_DIR}")
set(OPENMS_BIN_DIR "@PACKAGE_INSTALL_BIN_DIR@")
set(OPENMS_DOC_DIR "@PACKAGE_INSTALL_DOC_DIR@")
set(OPENMS_LIB_DIR "@PACKAGE_INSTALL_LIB_DIR@")
# only for the OpenMP lookup below
set(_openms_include_dir "@PACKAGE_INSTALL_INCLUDE_DIR@")

set(OpenMS_VERSION_FULLSTRING "@OPENMS_PACKAGE_VERSION_FULLSTRING@")
set(OpenMS_VERSION_PRERELEASE "@OPENMS_PACKAGE_VERSION_PRERELEASE_IDENTIFIER@")

#------------------------------------------------------------------------------
# Build options of this installation
set(OpenMS_WITH_HDF5 "@WITH_HDF5@")
set(OpenMS_WITH_OPENTIMS "@WITH_OPENTIMS@")
set(OpenMS_WITH_THERMO_RAW "@WITH_THERMO_RAW@")
set(OpenMS_WITH_ONNX "@WITH_ONNX@")
set(OpenMS_WITH_OPENMP "@OPENMP_FOUND@")
set(OpenMS_WITH_WNETALIGN "@WITH_WNETALIGN@")
set(OpenMS_BUILD_TOPP_TOOLS "@BUILD_TOPP_TOOLS@")

#------------------------------------------------------------------------------
# Dependencies that are part of the public link interface of the imported targets.
# Everything else OpenMS links is PRIVATE: the installed shared library resolves it
# through its own RPATH/soname, and consumers need neither the CMake packages nor
# the development files of those libraries (CURL, libxml2, libsvm, SQLite,
# HDF5, Arrow, ...).

include(CMakeFindDependencyMacro)

# Boost is private: no installed header includes it, so consumers of the shared
# library need no Boost development files. A static export keeps its private link
# dependencies, among them the header-only Boost::boost target, so only then is
# Boost resolved. The version OpenMS was built against is the minimum (falling back
# to the minimum OpenMS itself requires should a build not record it).
if(NOT "@BUILD_SHARED_LIBS@")
  set(_openms_boost_version "@Boost_VERSION@")
  if(NOT _openms_boost_version)
    set(_openms_boost_version 1.81.0)
  endif()
  find_dependency(Boost ${_openms_boost_version})
  # libxml2's own package config first, as OpenMS itself found it: only it carries
  # the link dependencies of a static libxml2 (and LIBXML_STATIC on Windows).
  # A config package that is found but fails (e.g. a missing dependency of its own)
  # is an error, not a reason to fall back to the module.
  find_package(LibXml2 2.13 CONFIG QUIET NAMES LibXml2 libxml2)
  if(NOT LibXml2_FOUND AND LibXml2_NOT_FOUND_MESSAGE)
    set(OpenMS_FOUND FALSE)
    set(OpenMS_NOT_FOUND_MESSAGE
        "The libxml2 package configuration failed: ${LibXml2_NOT_FOUND_MESSAGE}")
    return()
  elseif(NOT LibXml2_FOUND)
    find_dependency(LibXml2 2.13 MODULE)
  endif()
  unset(_openms_boost_version)
endif()

# Eigen: a consumer of the shared library OpenMS ships needs nothing of it. No
# installed header includes Eigen -- DATASTRUCTURES/MatrixEigen.h, the one that does,
# is internal and not installed -- and CMake omits the PRIVATE dependencies of a
# SHARED library from the exported link interface, so OpenMSTargets.cmake names no
# Eigen target at all. A STATIC build is the exception: CMake keeps its private
# dependencies as $<LINK_ONLY:Eigen3::Eigen>, which has to resolve to a target in the
# consuming project. So the lookup follows the library configuration the producer
# recorded instead of running for every consumer; the OpenMS build sets
# BUILD_SHARED_LIBS unconditionally, so it normally does not run at all.
#
# Two-step lookup as in cmake/cmake_findExternalLibs.cmake: the version range admits
# Eigen 5 where the package version file understands ranges (CMake issue 24581). The
# fallback is deliberately a plain minimum: a version file written with
# SameMajorVersion compatibility rejects the range 3.4.0...<6 even for Eigen 3.4
# itself, because both ends of a range must lie in the same major version. An
# Eigen3::Eigen target that the consuming project defines itself (e.g. a vendored
# Eigen) is accepted as is, like in the OpenMS build; its version is that project's call.
#
# Deliberately a private helper rather than a documented OpenMS_* variable: a
# consumer that needs to know how this installation was built reads it off the
# imported target, get_target_property(OpenMS::OpenMS TYPE), which reports
# SHARED_LIBRARY or STATIC_LIBRARY and cannot drift from what was installed. The
# recorded value exists only because the targets file is included further below,
# after the dependency lookups, so the property is not available here yet.
set(_openms_built_shared_libs "@BUILD_SHARED_LIBS@")
if(NOT _openms_built_shared_libs)
  set(_openms_eigen3_version "@Eigen3_VERSION@")
  if(NOT _openms_eigen3_version)
    set(_openms_eigen3_version 3.4.0)
  endif()
  find_package(Eigen3 ${_openms_eigen3_version}...<6 QUIET)
  if(NOT TARGET Eigen3::Eigen)
    find_dependency(Eigen3 ${_openms_eigen3_version})
  endif()
  unset(_openms_eigen3_version)
endif()
unset(_openms_built_shared_libs)

# OpenMP: OpenMP::OpenMP_CXX is PUBLIC in an OpenMS built with OpenMP.
#
# The macOS package and SDK bundle the OpenMP runtime (lib/libomp.dylib) and install its
# omp.h with the headers (cmake/package_general.cmake). FindOpenMP of the consuming project
# is pointed at both: a program that loads a second OpenMP runtime next to the one
# libOpenMS uses aborts ("OMP: Error #15"). The cache entries are only filled in when
# empty, so a project that chose its own libomp keeps it, with a warning.
if(OpenMS_WITH_OPENMP AND APPLE AND EXISTS "${OPENMS_LIB_DIR}/libomp.dylib"
   AND EXISTS "${_openms_include_dir}/omp.h")
  set(_openms_libomp "${OPENMS_LIB_DIR}/libomp.dylib")
  if(NOT OpenMP_libomp_LIBRARY)
    set(OpenMP_libomp_LIBRARY "${_openms_libomp}" CACHE FILEPATH
        "Path to the libomp library for OpenMP" FORCE)
    foreach(_openms_omp_language IN ITEMS C CXX)
      if(NOT OpenMP_${_openms_omp_language}_INCLUDE_DIR)
        set(OpenMP_${_openms_omp_language}_INCLUDE_DIR "${_openms_include_dir}" CACHE PATH
            "Directory of omp.h" FORCE)
      endif()
    endforeach()
    unset(_openms_omp_language)
  elseif(NOT OpenMP_libomp_LIBRARY STREQUAL _openms_libomp AND NOT OpenMS_FIND_QUIETLY)
    message(WARNING
        "OpenMS bundles the OpenMP runtime ${_openms_libomp}, but this project uses "
        "${OpenMP_libomp_LIBRARY} (OpenMP_libomp_LIBRARY). A program that loads both aborts "
        "with \"OMP: Error #15\"; unset OpenMP_libomp_LIBRARY and OpenMP_CXX_INCLUDE_DIR to "
        "use the bundled runtime.")
  endif()
  unset(_openms_libomp)
endif()
unset(_openms_include_dir)
if(OpenMS_WITH_OPENMP)
  find_dependency(OpenMP COMPONENTS CXX)
endif()

#------------------------------------------------------------------------------
# The imported targets: one file per layer. The core file is always present. The
# CLI file is installed by the component cmake_cli (with the library in
# library_cli), so it exists only when the installation includes that layer. It
# refers to the targets of the core layer and is therefore included after it.
include("${CMAKE_CURRENT_LIST_DIR}/@_OPENMS_EXPORT_FILE@")
set(OpenMS_CLI_FOUND FALSE)
if(EXISTS "${CMAKE_CURRENT_LIST_DIR}/@_OPENMS_CLI_EXPORT_FILE@")
  include("${CMAKE_CURRENT_LIST_DIR}/@_OPENMS_CLI_EXPORT_FILE@")
  set(OpenMS_CLI_FOUND TRUE)
endif()

#------------------------------------------------------------------------------
# Components. Core and OpenSwathAlgo are always present, CLI when the installation
# includes the CLI layer. GUI is delegated to the OpenMSGUI package of
# OpenMS-TOPP-GUI, searched only next to this file (the same installation prefix
# or build tree), so consumers of the core library never need Qt6. The core and
# CLI targets exist at this point, so OpenMSGUIConfig.cmake does not search OpenMS
# again.
set(_openms_known_components Core OpenSwathAlgo CLI GUI)
set(OpenMS_Core_FOUND TRUE)
set(OpenMS_OpenSwathAlgo_FOUND TRUE)
if("CLI" IN_LIST OpenMS_FIND_COMPONENTS AND NOT OpenMS_CLI_FOUND AND OpenMS_FIND_REQUIRED_CLI)
  set(OpenMS_NOT_FOUND_MESSAGE
      "This OpenMS installation does not include the TOPP tool framework library OpenMS::OpenMS_CLI (install components library_cli and cmake_cli).")
endif()
set(OpenMS_GUI_FOUND FALSE)
if("GUI" IN_LIST OpenMS_FIND_COMPONENTS AND OpenMS_CLI_FOUND)
  find_package(OpenMSGUI ${OpenMS_VERSION} EXACT CONFIG QUIET NO_DEFAULT_PATH
               PATHS "${CMAKE_CURRENT_LIST_DIR}/../OpenMSGUI" "${CMAKE_CURRENT_LIST_DIR}")
  if(OpenMSGUI_FOUND AND TARGET OpenMS::OpenMS_GUI)
    set(OpenMS_GUI_FOUND TRUE)
  endif()
endif()
set(OpenMS_WITH_GUI ${OpenMS_GUI_FOUND})
## Not requested: as before the GUI moved to OpenMS-TOPP-GUI, the targets of an
## installed GUI layer are provided anyway, without a Qt lookup. Only a GUI layer of
## exactly this version is included (read from its package version file).
if(NOT "GUI" IN_LIST OpenMS_FIND_COMPONENTS AND OpenMS_CLI_FOUND AND NOT OpenMS_IGNORE_GUI_LAYER)
  function(_openms_gui_layer_version _dir _result)
    set(PACKAGE_FIND_VERSION "${OpenMS_VERSION}")
    set(PACKAGE_FIND_VERSION_MAJOR "${OpenMS_VERSION_MAJOR}")
    set(PACKAGE_FIND_VERSION_MINOR "${OpenMS_VERSION_MINOR}")
    set(PACKAGE_FIND_VERSION_PATCH "${OpenMS_VERSION_PATCH}")
    set(PACKAGE_FIND_VERSION_COUNT 3)
    include("${_dir}/OpenMSGUIConfigVersion.cmake")
    if(PACKAGE_VERSION_UNSUITABLE)
      set(PACKAGE_VERSION "")
    endif()
    set(${_result} "${PACKAGE_VERSION}" PARENT_SCOPE)
  endfunction()
  foreach(_openms_gui_dir IN ITEMS "${CMAKE_CURRENT_LIST_DIR}/../OpenMSGUI" "${CMAKE_CURRENT_LIST_DIR}")
    if(EXISTS "${_openms_gui_dir}/OpenMSGUITargets.cmake"
       AND EXISTS "${_openms_gui_dir}/OpenMSGUIConfigVersion.cmake")
      _openms_gui_layer_version("${_openms_gui_dir}" _openms_gui_version)
      if(_openms_gui_version VERSION_EQUAL OpenMS_VERSION)
        if(NOT TARGET OpenMS::OpenMS_GUI)
          include("${_openms_gui_dir}/OpenMSGUITargets.cmake")
        endif()
        set(OpenMS_WITH_GUI TRUE)
        break()
      endif()
    endif()
  endforeach()
  unset(_openms_gui_dir)
  unset(_openms_gui_version)
endif()
if("GUI" IN_LIST OpenMS_FIND_COMPONENTS AND NOT OpenMS_GUI_FOUND AND OpenMS_FIND_REQUIRED_GUI)
  if(NOT OpenMS_CLI_FOUND)
    set(OpenMS_NOT_FOUND_MESSAGE
        "The OpenMS GUI component needs the CLI layer, which this OpenMS installation does not include (install components library_cli and cmake_cli).")
  elseif(OpenMSGUI_NOT_FOUND_MESSAGE)
    ## the package exists but failed, e.g. Qt6 was not found
    string(CONCAT OpenMS_NOT_FOUND_MESSAGE
        "The OpenMS GUI component (${OpenMSGUI_CONSIDERED_CONFIGS}) was found but cannot be "
        "used: ${OpenMSGUI_NOT_FOUND_MESSAGE}")
  elseif(OpenMSGUI_CONSIDERED_VERSIONS)
    string(CONCAT OpenMS_NOT_FOUND_MESSAGE
        "The OpenMS GUI component needs the OpenMSGUI package of exactly this OpenMS version "
        "(${OpenMS_VERSION}), but found ${OpenMSGUI_CONSIDERED_VERSIONS} "
        "(${OpenMSGUI_CONSIDERED_CONFIGS}).")
  else()
    string(CONCAT OpenMS_NOT_FOUND_MESSAGE
        "The OpenMS GUI library OpenMS::OpenMS_GUI is built by the separate repository "
        "OpenMS-TOPP-GUI (https://github.com/OpenMS/OpenMS-TOPP-GUI). No OpenMSGUI package was "
        "found next to this OpenMS installation (${CMAKE_CURRENT_LIST_DIR}): install the GUI "
        "layer of version ${OpenMS_VERSION} into the same prefix.")
  endif()
endif()
foreach(_openms_component IN LISTS OpenMS_FIND_COMPONENTS)
  if(NOT _openms_component IN_LIST _openms_known_components
     AND OpenMS_FIND_REQUIRED_${_openms_component})
    set(OpenMS_NOT_FOUND_MESSAGE
        "Unknown OpenMS component '${_openms_component}' (known components: ${_openms_known_components}).")
  endif()
endforeach()
unset(_openms_component)
unset(_openms_known_components)

#------------------------------------------------------------------------------
# Aliases for projects that link the un-namespaced names of earlier releases.
if(NOT TARGET OpenMS)
  add_library(OpenMS ALIAS OpenMS::OpenMS)
endif()
if(NOT TARGET OpenSwathAlgo)
  add_library(OpenSwathAlgo ALIAS OpenMS::OpenSwathAlgo)
endif()
if(TARGET OpenMS::OpenMS_CLI AND NOT TARGET OpenMS_CLI)
  add_library(OpenMS_CLI ALIAS OpenMS::OpenMS_CLI)
endif()
if(TARGET OpenMS::OpenMS_GUI AND NOT TARGET OpenMS_GUI)
  add_library(OpenMS_GUI ALIAS OpenMS::OpenMS_GUI)
endif()

check_required_components(OpenMS)
