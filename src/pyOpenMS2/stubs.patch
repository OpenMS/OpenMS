# nanobind stubgen pattern file for pyOpenMS2
#
# Fixes types that stubgen cannot resolve automatically.
# See: https://nanobind.readthedocs.io/en/latest/typing.html#pattern-files

# Singleton DB classes: stubgen emits the internal CallableSingleton wrapper
# type which is not valid Python syntax. Replace with a callable that returns
# the singleton instance.
pyopenms\.ElementDB$:
    def ElementDB() -> _pyopenms2_1.ElementDB: ...

pyopenms\.ModificationsDB$:
    def ModificationsDB() -> _pyopenms2_1.ModificationsDB: ...

pyopenms\.ResidueDB$:
    def ResidueDB() -> _pyopenms2_2.ResidueDB: ...

pyopenms\.ProteaseDB$:
    def ProteaseDB() -> _pyopenms2_1.ProteaseDB: ...

pyopenms\.RNaseDB$:
    def RNaseDB() -> _pyopenms2_2.RNaseDB: ...

pyopenms\.RibonucleotideDB$:
    def RibonucleotideDB() -> _pyopenms2_2.RibonucleotideDB: ...
