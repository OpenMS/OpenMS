+  std::sort(combined.begin(), combined.end(),
+            [](const pair<double, bool>& a, const pair<double, bool>& b) {
+              return a.first > b.first;
+            });
+  return countPositivesOfPairs(combined, fdr, skipDecoysPlusOne);
