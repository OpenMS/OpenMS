+                           bool skipDecoysPlusOne) const {
+  std::vector<pair<double, bool> > combined;
+  combined.reserve(scores_.size());
+  for (const ScoreHolder& sh : scores_) {
+    combined.emplace_back(calcScore(sh.pPSM->features, w), sh.isTarget());
