+-void Scores::weedOutRedundant() {
+-  std::map<std::string, unsigned int> peptideSpecCounts;
+-  double specCountQvalThreshold = -1.0;
+-  weedOutRedundant(peptideSpecCounts, specCountQvalThreshold);
+-}
