+      deltaLow(deltL), deltaHigh(deltH), doLogit(dLt), doLog(dL) {
+      ;
+    }
+    ~Transform() {
+      ;
+    }
+    double operator()(double xx) {
+      if ((!doLogit) && (!doLog)) {
+        return xx;
+      }
+      if ((deltaLow > .0) || (deltaHigh > .0)) {
+        if (doLogit) {
+          xx *= (1. - deltaHigh - deltaLow);
+        }
+        xx += deltaLow;
+      }
+      if (doLogit) {
+        return log(xx / (1. - xx));
+      }
+      return log(xx);
+    }
+  private:
+    double deltaLow, deltaHigh;
+    bool doLogit, doLog;
+};
+
+}}}  // namespace OpenMS::Internal::Percolator
+
+#endif /*TRANSFORM_H_*/
