+-Array<T> Array<T>::operator [](const Array<int> & rhs) const
+-{
+-  Array<T> result(static_cast<int>(rhs.size()));
+-
+-  int counter = 0;
+-  for (Array<int>::Iterator iter = rhs.begin(); iter != rhs.end(); iter++, counter++)
+-    {
+-      result[ counter ] = (*this)[ *iter ];
+-    }
+-
+-  return result;
+-}
