-    return gx;
-  }
-  // if (rix==0)
-  double derr = (g[1] - g[0]) / (x[1] - x[0]) - (x[1] - x[0]) / 6
-      * gamma[0];
-  double gx = g[0] - (x[0] - xx) * derr;
-  return gx;
