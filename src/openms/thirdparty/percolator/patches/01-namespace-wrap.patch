+-void StdvNormalizer::normalizeweight(const std::vector<double>& in, 
+-    std::vector<double>& out) const {
+-  double sum = 0;
+-  size_t i = 0;
+-  for (; i < numFeatures; i++) {
+-    out[i] = in[i] * div[i];
+-    sum += sub[i] * in[i];
+-  }
+-  out[i] = in[i] + sum;
+-}
