+-double PackedVector::packedDotProd(const PackedVector& rhs) const{
+-  double tot = 0;
+-  int kL, kR;
+-  for (kL = 0, kR = 0; kL < numberEntries() && kR < rhs.numberEntries();) {
+-    int iL = index(kL);
+-    int iR = rhs.index(kR);
+-    if (iL < iR) {
+-      kL++;
+-    } else if (iL > iR) {
+-      kR++;
+-    } else {
+-      // equality case
