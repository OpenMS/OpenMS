+-void SetHandler::normalizeFeatures(Normalizer*& pNorm) {
+-  std::vector<double*> featuresV, rtFeaturesV;
+-  for (unsigned int ix = 0; ix < subsets_.size(); ++ix) {
+-    subsets_[ix]->fillFeatures(featuresV);
+-  }
+-  pNorm = Normalizer::getNormalizer();
