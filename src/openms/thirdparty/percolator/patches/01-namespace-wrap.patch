++template <typename T>
++std::istream & operator >>(std::istream & is, Array<T> & rhs)
++{
++  char delim;
++  is >> delim;
++
++  rhs.clear();
++
++  // the character for an empty array
++  if ( delim == '0')
++    return is;
++
++  if ( delim != '{' )
++    {
++      throw typename Array<T>::FormatException();
++    }
++  T element;
++  
++  // now that a { character has been read
++  // it is guaranteed that at least one
++  // element will occur
++
++  do
++    {
++      is >> element;
++      rhs.add(element);
++      is >> delim;
++      
++      if ( delim != ',' && delim != '}')
++	throw typename Array<T>::FormatException();
++
++    } while ( delim != '}' );
++  return is;
