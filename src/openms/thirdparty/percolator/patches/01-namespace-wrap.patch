+-string getRidOfUnprintablesAndUnicode(string inpString) {
+-  string outputs = "";
+-  for (unsigned int jj = 0; jj < inpString.size(); jj++) {
+-    signed char ch = inpString[jj];
+-    // NOTE signed char ranges -128 to 127
+-    if (((int)ch) >= 32) {
+-      outputs += ch;
+-    }
+-  }
+-  return outputs;
+-}
