-void Scores::getScoreLabelPairs(std::vector<pair<double, bool> >& combined) {
-  combined.clear();
-  transform(scores_.begin(), scores_.end(), back_inserter(combined),
-            mem_fn(&ScoreHolder::toPair));
-}
