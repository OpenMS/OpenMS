+-std::vector<double> IsplineRegression::fit_y(const std::vector<double>& y, double min_val, double max_val) const {
+-    std::vector<double> x(y.size());
+-    std::iota(x.begin(), x.end(), 0.0);
+-    return fit_xy(x, y, min_val, max_val);
+-}
