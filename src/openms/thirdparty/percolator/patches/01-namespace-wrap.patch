+-
+-// error checking
+-template <typename T, typename R>
+-void sizeCheck(const Array<T> & lhs, const Array<R> & rhs)
+-{
+-#ifdef SAFE_ARRAYS
+-  if ( lhs.size() != rhs.size() )
+-    {
+-      throw typename Array<T>::SizeException();
+-    }
+-#else
+-  // Mark them unused in release or non-SAFE mode
+-  (void)lhs;
+-  (void)rhs;
+-#endif
+-}
