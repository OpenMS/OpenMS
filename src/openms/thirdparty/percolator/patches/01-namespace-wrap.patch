++double IsplineRegression::cubic_ispline(double x, double left, double right) const {
++    if (x < left) return 0.0;
++    if (x >= right) return 1.0;
++    double u = (x - left) / (right - left);
++    return 3 * u * u - 2 * u * u * u;
++}
