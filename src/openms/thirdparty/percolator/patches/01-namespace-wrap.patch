+-unsigned Scores::getQvaluesBelowLevel(double level) {
+-  unsigned hits = 0;
+-  std::vector<ScoreHolder>::const_iterator scoreIt = scores_.begin();
+-  for (; scoreIt != scores_.end(); ++scoreIt) {
+-    if (scoreIt->isTarget() && scoreIt->q < level) {
+-      hits++;
+-    }
+-  }
+-  return hits;
+-}
