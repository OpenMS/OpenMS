+-// concatonate arrays together lhs to rhs
+-template <typename T>
+-Array<T> concatonate(const Array<T> & lhs, const Array<T> & rhs)
+-{
+-  Array<T> result(lhs.size() + rhs.size());
+-  int k;
+-  for (k=0; k<lhs.size(); k++)
+-    {
+-      result[k] = lhs[k];
+-    }
+-  
+-  for (k=0; k<rhs.size(); k++)
+-    {
+-      result[ k + lhs.size() ] = rhs[k];
+-    }
+-  return result;
+-}
