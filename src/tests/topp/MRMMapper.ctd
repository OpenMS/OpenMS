<?xml version="1.0" encoding="UTF-8"?>
<tool ctdVersion="1.8" version="3.5.0-pre-nuc-dia-2025-07-24" name="MRMMapper" docurl="http://www.openms.de/doxygen/nightly/html/TOPP_MRMMapper.html" category="Targeted Experiments and OpenSWATH" >
<description><![CDATA[MRMMapper maps measured chromatograms (mzML) and the transitions used (TraML)]]></description>
<manual><![CDATA[MRMMapper maps measured chromatograms (mzML) and the transitions used (TraML)]]></manual>
<citations>
  <citation doi="10.1038/s41592-024-02197-7" url="" />
</citations>
<PARAMETERS version="1.8.0" xsi:noNamespaceSchemaLocation="https://raw.githubusercontent.com/OpenMS/OpenMS/develop/share/OpenMS/SCHEMAS/Param_1_8_0.xsd" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <NODE name="MRMMapper" description="MRMMapper maps measured chromatograms (mzML) and the transitions used (TraML)">
    <ITEM name="version" value="3.5.0-pre-nuc-dia-2025-07-24" type="string" description="Version of the tool that generated this parameters file." required="false" advanced="true" />
    <NODE name="1" description="Instance &apos;1&apos; section for &apos;MRMMapper&apos;">
      <ITEM name="in" value="" type="input-file" description="Input file containing chromatograms (converted mzXML file)" required="true" advanced="false" supported_formats="*.mzML" />
      <ITEM name="tr" value="" type="input-file" description="transition file" required="true" advanced="false" supported_formats="*.traML" />
      <ITEM name="out" value="" type="output-file" description="Output file containing mapped chromatograms" required="true" advanced="false" supported_formats="*.mzML" />
      <ITEM name="log" value="" type="string" description="Name of log file (created only when specified)" required="false" advanced="true" />
      <ITEM name="debug" value="0" type="int" description="Sets the debug level" required="false" advanced="true" />
      <ITEM name="threads" value="1" type="int" description="Sets the number of threads allowed to be used by the TOPP tool" required="false" advanced="false" />
      <ITEM name="no_progress" value="false" type="bool" description="Disables progress logging to command line" required="false" advanced="true" />
      <ITEM name="force" value="false" type="bool" description="Overrides tool-specific checks" required="false" advanced="true" />
      <ITEM name="test" value="false" type="bool" description="Enables the test mode (needed for internal use only)" required="false" advanced="true" />
      <NODE name="algorithm" description="Algorithm parameters section">
        <ITEM name="precursor_tolerance" value="0.1" type="double" description="Precursor tolerance when mapping (in Th)" required="false" advanced="false" />
        <ITEM name="product_tolerance" value="0.1" type="double" description="Product tolerance when mapping (in Th)" required="false" advanced="false" />
        <ITEM name="map_multiple_assays" value="false" type="bool" description="Allow to map multiple assays to chromatograms and duplicate these chromatograms in the output." required="false" advanced="false" />
        <ITEM name="error_on_unmapped" value="false" type="bool" description="Treat remaining, unmapped chromatograms as an error" required="false" advanced="false" />
      </NODE>
    </NODE>
  </NODE>
</PARAMETERS>
</tool>
