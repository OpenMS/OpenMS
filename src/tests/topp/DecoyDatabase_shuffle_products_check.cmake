# Checks the output of DecoyDatabase -type RNA -method shuffle_products -enzyme RNase_T1 (oligos: cut after G).
# Usage: cmake -DIN=<target+decoy FASTA> -DMIN_LENGTH=<n> [-DMISSED=<n>] [-DBLACKLIST=<FASTA>] [-DEXPECT_DECOY_OLIGO=<oligo>] -P <this file>
#  - every decoy has its target's length, G positions and terminal phosphates (cleavage sites in place)
#  - balance: as many distinct decoy oligos (>= MIN_LENGTH) as distinct target oligos
#  - no decoy oligo (>= MIN_LENGTH) equals a target oligo or an oligo of BLACKLIST; with MISSED, this also holds for
#    oligos with up to MISSED missed cleavages (also those made of products shorter than MIN_LENGTH)
#  - EXPECT_DECOY_OLIGO (if given) is a decoy oligo

function(read_fasta file ids_var seqs_var)
  file(STRINGS "${file}" lines)
  set(ids "")
  set(seqs "")
  set(seq "")
  foreach(line IN LISTS lines)
    if(line MATCHES "^>([^ ]*)")
      if(NOT ids STREQUAL "")
        list(APPEND seqs "${seq}")
      endif()
      list(APPEND ids "${CMAKE_MATCH_1}")
      set(seq "")
    else()
      string(STRIP "${line}" line)
      string(APPEND seq "${line}")
    endif()
  endforeach()
  list(APPEND seqs "${seq}")
  set(${ids_var} "${ids}" PARENT_SCOPE)
  set(${seqs_var} "${seqs}" PARENT_SCOPE)
endfunction()

# oligos (RNase T1, no missed cleavages) of at least MIN_LENGTH residues, without terminal phosphates
function(oligos seq out_var)
  string(REGEX REPLACE "^p" "" seq "${seq}")
  string(REGEX REPLACE "p$" "" seq "${seq}")
  string(REGEX MATCHALL "[^G]*G|[^G]+$" products "${seq}")
  set(result "")
  foreach(product IN LISTS products)
    string(LENGTH "${product}" len)
    if(len GREATER_EQUAL MIN_LENGTH)
      list(APPEND result "${product}")
    endif()
  endforeach()
  set(${out_var} "${result}" PARENT_SCOPE)
endfunction()

# oligos with up to MISSED missed cleavages (combinations of consecutive products) of at least MIN_LENGTH residues
function(oligos_missed seq out_var)
  string(REGEX REPLACE "^p" "" seq "${seq}")
  string(REGEX REPLACE "p$" "" seq "${seq}")
  string(REGEX MATCHALL "[^G]*G|[^G]+$" products "${seq}")
  list(LENGTH products n)
  set(result "")
  if(n GREATER 0)
    math(EXPR last "${n} - 1")
    foreach(i RANGE ${last})
      set(joined "")
      math(EXPR stop "${i} + ${MISSED}")
      if(stop GREATER last)
        set(stop ${last})
      endif()
      foreach(j RANGE ${i} ${stop})
        list(GET products ${j} product)
        string(APPEND joined "${product}")
        string(LENGTH "${joined}" len)
        if(len GREATER_EQUAL MIN_LENGTH)
          list(APPEND result "${joined}")
        endif()
      endforeach()
    endforeach()
  endif()
  set(${out_var} "${result}" PARENT_SCOPE)
endfunction()

function(g_mask seq out_var)
  string(REGEX REPLACE "[ACU]" "." mask "${seq}")
  set(${out_var} "${mask}" PARENT_SCOPE)
endfunction()

read_fasta("${IN}" ids seqs)
list(LENGTH ids n)
math(EXPR last "${n} - 1")
set(target_oligos "")
set(decoy_oligos "")
set(target_seqs "")
set(n_decoys 0)
foreach(i RANGE ${last})
  list(GET ids ${i} id)
  list(GET seqs ${i} seq)
  if(id MATCHES "^DECOY_(.*)$")
    math(EXPR n_decoys "${n_decoys} + 1")
    set(target_id "${CMAKE_MATCH_1}")
    list(FIND ids "${target_id}" t)
    if(t EQUAL -1)
      message(FATAL_ERROR "No target for decoy ${id}")
    endif()
    list(GET seqs ${t} target)
    g_mask("${target}" target_mask)
    g_mask("${seq}" decoy_mask)
    if(NOT target_mask STREQUAL decoy_mask)
      message(FATAL_ERROR "Decoy ${id} does not keep the G positions/length of its target:\n${target}\n${seq}")
    endif()
    oligos("${seq}" o)
    list(APPEND decoy_oligos ${o})
  else()
    oligos("${seq}" o)
    list(APPEND target_oligos ${o})
  endif()
endforeach()
if(n_decoys EQUAL 0)
  message(FATAL_ERROR "No decoys in ${IN}")
endif()
list(REMOVE_DUPLICATES target_oligos)
list(REMOVE_DUPLICATES decoy_oligos)
list(LENGTH target_oligos n_target)
list(LENGTH decoy_oligos n_decoy)
message(STATUS "${n_target} distinct target oligos, ${n_decoy} distinct decoy oligos (>= ${MIN_LENGTH} nt)")
if(NOT n_target EQUAL n_decoy)
  message(FATAL_ERROR "Unbalanced: ${n_target} distinct target oligos, ${n_decoy} distinct decoy oligos")
endif()

set(forbidden ${target_oligos})
if(DEFINED BLACKLIST)
  read_fasta("${BLACKLIST}" bl_ids bl_seqs)
  foreach(seq IN LISTS bl_seqs)
    oligos("${seq}" o)
    list(APPEND forbidden ${o})
  endforeach()
endif()
foreach(oligo IN LISTS decoy_oligos)
  if(oligo IN_LIST forbidden)
    message(FATAL_ERROR "Decoy oligo ${oligo} equals a target or blacklist oligo")
  endif()
endforeach()

if(DEFINED EXPECT_DECOY_OLIGO AND NOT EXPECT_DECOY_OLIGO IN_LIST decoy_oligos)
  message(FATAL_ERROR "Expected decoy oligo ${EXPECT_DECOY_OLIGO} not found")
endif()

if(DEFINED MISSED)
  set(target_missed "")
  set(decoy_missed "")
  foreach(i RANGE ${last})
    list(GET ids ${i} id)
    list(GET seqs ${i} seq)
    oligos_missed("${seq}" o)
    if(id MATCHES "^DECOY_")
      list(APPEND decoy_missed ${o})
    else()
      list(APPEND target_missed ${o})
    endif()
  endforeach()
  list(REMOVE_DUPLICATES target_missed)
  list(REMOVE_DUPLICATES decoy_missed)
  list(LENGTH target_missed n_target_missed)
  list(LENGTH decoy_missed n_decoy_missed)
  if(NOT n_target_missed EQUAL n_decoy_missed)
    message(FATAL_ERROR "Unbalanced searchable products with missed cleavages: ${n_target_missed} targets, ${n_decoy_missed} decoys")
  endif()
  if(DEFINED BLACKLIST)
    foreach(seq IN LISTS bl_seqs)
      oligos_missed("${seq}" o)
      list(APPEND target_missed ${o})
    endforeach()
  endif()
  foreach(oligo IN LISTS decoy_missed)
    if(oligo IN_LIST target_missed)
      message(FATAL_ERROR "Decoy oligo ${oligo} (up to ${MISSED} missed cleavages) equals a target or blacklist oligo")
    endif()
  endforeach()
endif()
