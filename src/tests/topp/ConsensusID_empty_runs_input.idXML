	<SearchParameters id="SP_0" db="test.fasta" db_version="2020-01" taxonomy="9606" mass_type="monoisotopic" charges="2:3" enzyme="trypsin" missed_cleavages="1" precursor_peak_tolerance="10" precursor_peak_tolerance_ppm="true" peak_mass_tolerance="0.02" peak_mass_tolerance_ppm="false" >
		<FixedModification name="Carbamidomethyl (C)" />
		<VariableModification name="Oxidation (M)" />
				<UserParam type="string" name="custom_search_setting" value="first"/>
	</SearchParameters>
