		<FixedModification name="Carbamidomethyl (C)" />
		<VariableModification name="Phospho (S)" />
				<UserParam type="string" name="custom_search_setting" value="second"/>
	</SearchParameters>
	<IdentificationRun date="2020-01-01T12:00:00" search_engine="Engine1" search_engine_version="1.0" search_parameters_ref="SP_0" >
		<ProteinIdentification score_type="" higher_score_better="true" significance_threshold="0.0" >
