# Usage: cmake -DPIN=<a Percolator input of ProSE (-out_pin)> -DDECOY=<decoy accession prefix> -P check_pin_later_decoys.cmake
#
# The precondition of a test of a skipped protein FDR: the best hit (highest 'score') of every spectrum refers to target
# proteins only, and some later hit refers to a decoy protein. The protein inference uses the best hit of each PSM only,
# so no decoy protein is left for the picked-protein FDR. -out_pin holds all reported hits of each spectrum with ProSE's
# own scores, i.e. what the protein FDR gets when the search neither rescores nor filters by PSM FDR. A spectrum is its
# SpecId and ExpMass (a native ID may have several spectra).
foreach(_required PIN DECOY)
  if (NOT DEFINED ${_required})
    message(FATAL_ERROR "${_required} is required")
  endif()
endforeach()
file(STRINGS "${PIN}" _lines)
list(POP_FRONT _lines _header)
string(REPLACE "\t" ";" _header "${_header}")
foreach(_name SpecId ExpMass score Proteins)
  list(FIND _header "${_name}" _c_${_name})
  if (_c_${_name} EQUAL -1)
    message(FATAL_ERROR "${PIN}: no column '${_name}'")
  endif()
endforeach()
set(_spectra)
set(_decoy_hits 0)
foreach(_line IN LISTS _lines)
  # (brackets and semicolons would change how CMake splits lists)
  string(REPLACE ";" "," _line "${_line}")
  string(REPLACE "[" "<" _line "${_line}")
  string(REPLACE "]" ">" _line "${_line}")
  string(REPLACE "\t" ";" _cells "${_line}")
  list(GET _cells ${_c_SpecId} _id)
  list(GET _cells ${_c_ExpMass} _mass)
  list(GET _cells ${_c_score} _score)
  # the proteins: the last columns
  list(SUBLIST _cells ${_c_Proteins} -1 _proteins)
  set(_decoy OFF)
  foreach(_protein IN LISTS _proteins)
    string(FIND "${_protein}" "${DECOY}" _at)
    if (_at EQUAL 0)
      set(_decoy ON)
    endif()
  endforeach()
  if (_decoy)
    math(EXPR _decoy_hits "${_decoy_hits} + 1")
  endif()
  string(MAKE_C_IDENTIFIER "${_id}_${_mass}" _key)
  if (NOT DEFINED _best_${_key} OR _score GREATER _best_${_key})
    set(_best_${_key} "${_score}")
    set(_best_decoy_${_key} ${_decoy})
    set(_best_id_${_key} "${_id} (${_mass})")
    list(APPEND _spectra ${_key})
  elseif (_score EQUAL _best_${_key} AND _decoy)
    set(_best_decoy_${_key} ON) # (a tie: the decoy may come first)
  endif()
endforeach()
list(REMOVE_DUPLICATES _spectra)
foreach(_key IN LISTS _spectra)
  if (_best_decoy_${_key})
    message(FATAL_ERROR "${PIN}: precondition not met: the best hit of spectrum ${_best_id_${_key}} refers to a decoy"
                        " protein, so the inference keeps a decoy protein and the protein FDR is not skipped. The fixture"
                        " or the search changed: choose a case whose decoys are only among the later hits.")
  endif()
endforeach()
if (_decoy_hits EQUAL 0)
  message(FATAL_ERROR "${PIN}: precondition not met: no hit refers to a decoy protein, so the test would not show that"
                      " decoys among the later hits leave the protein FDR skipped. The fixture or the search changed:"
                      " choose a case with decoys among the later hits.")
endif()
list(LENGTH _spectra _n)
message(STATUS "${PIN}: ${_n} spectra, the best hit of each a target; ${_decoy_hits} later hit(s) of decoy proteins")
