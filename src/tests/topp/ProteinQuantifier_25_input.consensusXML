		<PeptideIdentification identification_run_ref="PI_0" score_type="" higher_score_better="true" significance_threshold="0" MZ="150" RT="150">
			<PeptideHit score="1" sequence="CCCCCK" charge="2" protein_refs="PH_0"/>
		</PeptideIdentification>
	</consensusElement>
	<consensusElement id="e_6" quality="1" charge="2">
		<centroid rt="160" mz="160" it="50"/>
		<groupedElementList>
			<element map="2" id="6" rt="160" mz="160" it="50" charge="2"/>
		</groupedElementList>
		<PeptideIdentification identification_run_ref="PI_0" score_type="" higher_score_better="true" significance_threshold="0" MZ="160" RT="160">
			<PeptideHit score="1" sequence="PEPTIDEK" charge="2" protein_refs="PH_0"/>
		</PeptideIdentification>
	</consensusElement>
	<consensusElement id="e_7" quality="1" charge="2">
		<centroid rt="170" mz="170" it="5"/>
		<groupedElementList>
			<element map="3" id="7" rt="170" mz="170" it="5" charge="2"/>
		</groupedElementList>
		<PeptideIdentification identification_run_ref="PI_0" score_type="" higher_score_better="true" significance_threshold="0" MZ="170" RT="170">
			<PeptideHit score="1" sequence="PEPTIDEK" charge="2" protein_refs="PH_0"/>
		</PeptideIdentification>
	</consensusElement>
	</consensusElementList>
</consensusXML>
