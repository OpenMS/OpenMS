# TEMPORARY (scratch branch only): print every line of FILE that contains PATTERN (plain substring),
# prefixed with TAG and the 1-based line number, so that golden files can be regenerated from a real run.
# The test fails on purpose so that ctest --output-on-failure shows the output.
if(NOT EXISTS "${FILE}")
  message(FATAL_ERROR "missing ${FILE}")
endif()
file(READ "${FILE}" content)
# protect characters that have a meaning in CMake lists before splitting into lines
string(REPLACE "\\" "@BS@" content "${content}")
string(REPLACE ";" "@SC@" content "${content}")
string(REPLACE "[" "@LB@" content "${content}")
string(REPLACE "]" "@RB@" content "${content}")
string(REPLACE "\r" "" content "${content}")
string(REPLACE "\n" ";" lines "${content}")
set(line_no 0)
set(count 0)
message("${TAG}_BEGIN")
foreach(l IN LISTS lines)
  math(EXPR line_no "${line_no} + 1")
  string(FIND "${l}" "${PATTERN}" pos)
  if(NOT pos EQUAL -1)
    string(REPLACE "@RB@" "]" l "${l}")
    string(REPLACE "@LB@" "[" l "${l}")
    string(REPLACE "@SC@" ";" l "${l}")
    string(REPLACE "@BS@" "\\" l "${l}")
    message("${TAG}|${line_no}|${l}")
    math(EXPR count "${count} + 1")
  endif()
endforeach()
message("${TAG}_END ${count}")
message(FATAL_ERROR "intentional failure so that ctest prints the output above")
