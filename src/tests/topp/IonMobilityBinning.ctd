<?xml version="1.0" encoding="UTF-8"?>
<tool ctdVersion="1.8" version="3.5.0-pre-nuc-dia-2025-07-24" name="IonMobilityBinning" docurl="http://www.openms.de/doxygen/nightly/html/TOPP_IonMobilityBinning.html" category="File Filtering, Extraction and Merging" >
<description><![CDATA[Splits an mzML file with IonMobility frames into multiple mzML files by binning(merging) spectra by their IM values]]></description>
<manual><![CDATA[Splits an mzML file with IonMobility frames into multiple mzML files by binning(merging) spectra by their IM values]]></manual>
<citations>
  <citation doi="10.1038/s41592-024-02197-7" url="" />
</citations>
<PARAMETERS version="1.8.0" xsi:noNamespaceSchemaLocation="https://raw.githubusercontent.com/OpenMS/OpenMS/develop/share/OpenMS/SCHEMAS/Param_1_8_0.xsd" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <NODE name="IonMobilityBinning" description="Splits an mzML file with IonMobility frames into multiple mzML files by binning(merging) spectra by their IM values">
    <ITEM name="version" value="3.5.0-pre-nuc-dia-2025-07-24" type="string" description="Version of the tool that generated this parameters file." required="false" advanced="true" />
    <NODE name="1" description="Instance &apos;1&apos; section for &apos;IonMobilityBinning&apos;">
      <ITEM name="in" value="" type="input-file" description="Input file (containing RT, IM, m/z, i.e. IM-frames)." required="true" advanced="false" supported_formats="*.mzML" />
      <ITEM name="out" value="" type="output-prefix" description="Path to the output directory to write the binned mzML files to." required="true" advanced="false" />
      <ITEM name="bins" value="5" type="int" description="Number of ion mobility bins to split the input file into" required="false" advanced="false" />
      <ITEM name="bin_extension_abs" value="0.0" type="double" description="Absolute extension of the bin in IM dimension (causes bins to overlap by 2x this value)" required="false" advanced="false" />
      <ITEM name="log" value="" type="string" description="Name of log file (created only when specified)" required="false" advanced="true" />
      <ITEM name="debug" value="0" type="int" description="Sets the debug level" required="false" advanced="true" />
      <ITEM name="threads" value="1" type="int" description="Sets the number of threads allowed to be used by the TOPP tool" required="false" advanced="false" />
      <ITEM name="no_progress" value="false" type="bool" description="Disables progress logging to command line" required="false" advanced="true" />
      <ITEM name="force" value="false" type="bool" description="Overrides tool-specific checks" required="false" advanced="true" />
      <ITEM name="test" value="false" type="bool" description="Enables the test mode (needed for internal use only)" required="false" advanced="true" />
      <NODE name="SpectraMerging" description="Options for merging spectra within the same IM bin (from the same IM-frame)">
        <ITEM name="mz_binning_width" value="0.01" type="double" description="Width of the m/z bins" required="false" advanced="false" />
        <ITEM name="mz_binning_width_unit" value="Da" type="string" description="Unit of the m/z bin width" required="false" advanced="false" restrictions="Da,ppm" />
      </NODE>
    </NODE>
  </NODE>
</PARAMETERS>
</tool>
