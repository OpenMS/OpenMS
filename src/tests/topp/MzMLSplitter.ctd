<?xml version="1.0" encoding="UTF-8"?>
<tool ctdVersion="1.8" version="3.5.0-pre-nuc-dia-2025-07-24" name="MzMLSplitter" docurl="http://www.openms.de/doxygen/nightly/html/TOPP_MzMLSplitter.html" category="File Filtering, Extraction and Merging" >
<description><![CDATA[Splits an mzML file into multiple parts]]></description>
<manual><![CDATA[Splits an mzML file into multiple parts]]></manual>
<citations>
  <citation doi="10.1038/s41592-024-02197-7" url="" />
</citations>
<PARAMETERS version="1.8.0" xsi:noNamespaceSchemaLocation="https://raw.githubusercontent.com/OpenMS/OpenMS/develop/share/OpenMS/SCHEMAS/Param_1_8_0.xsd" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <NODE name="MzMLSplitter" description="Splits an mzML file into multiple parts">
    <ITEM name="version" value="3.5.0-pre-nuc-dia-2025-07-24" type="string" description="Version of the tool that generated this parameters file." required="false" advanced="true" />
    <NODE name="1" description="Instance &apos;1&apos; section for &apos;MzMLSplitter&apos;">
      <ITEM name="in" value="" type="input-file" description="Input file" required="true" advanced="false" supported_formats="*.mzML" />
      <ITEM name="out" value="" type="output-prefix" description="Prefix for output files (&apos;_part1of2.mzML&apos; etc. will be appended; default: same as &apos;in&apos; without the file extension)" required="false" advanced="false" />
      <ITEM name="parts" value="1" type="int" description="Number of parts to split into (takes precedence over &apos;size&apos; if set)" required="false" advanced="false" restrictions="1:" />
      <ITEM name="size" value="0" type="int" description="Approximate upper limit for resulting file sizes (in &apos;unit&apos;)" required="false" advanced="false" restrictions="0:" />
      <ITEM name="unit" value="MB" type="string" description="Unit for &apos;size&apos; (base 1024)" required="false" advanced="false" restrictions="KB,MB,GB" />
      <ITEM name="no_chrom" value="false" type="bool" description="Remove chromatograms, keep only spectra." required="false" advanced="false" />
      <ITEM name="no_spec" value="false" type="bool" description="Remove spectra, keep only chromatograms." required="false" advanced="false" />
      <ITEM name="log" value="" type="string" description="Name of log file (created only when specified)" required="false" advanced="true" />
      <ITEM name="debug" value="0" type="int" description="Sets the debug level" required="false" advanced="true" />
      <ITEM name="threads" value="1" type="int" description="Sets the number of threads allowed to be used by the TOPP tool" required="false" advanced="false" />
      <ITEM name="no_progress" value="false" type="bool" description="Disables progress logging to command line" required="false" advanced="true" />
      <ITEM name="force" value="false" type="bool" description="Overrides tool-specific checks" required="false" advanced="true" />
      <ITEM name="test" value="false" type="bool" description="Enables the test mode (needed for internal use only)" required="false" advanced="true" />
    </NODE>
  </NODE>
</PARAMETERS>
</tool>
