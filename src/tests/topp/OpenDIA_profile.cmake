# Native TOPP regression, using the same tiny prepared library as the success tests.
if(NOT WORK MATCHES "/OpenDIA_profile$")
  message(FATAL_ERROR "Expected a dedicated OpenDIA_profile test directory")
endif()
file(REMOVE_RECURSE "${WORK}")
file(MAKE_DIRECTORY "${WORK}")
function(run_case name expected)
  set(args ${COMMON_ARGS})
  foreach(option IN LISTS ARGN)
    if(option MATCHES "^-[A-Za-z]")
      list(FIND args "${option}" index)
      if(NOT index EQUAL -1)
        list(REMOVE_AT args ${index})
        list(REMOVE_AT args ${index})
      endif()
    endif()
  endforeach()
  execute_process(COMMAND "${TOOL}" ${args}
    -workflow:intermediate_dir "${WORK}/${name}_intermediates"
    -out_dir "${WORK}/${name}_out" ${ARGN}
    WORKING_DIRECTORY "${WORK}"
    RESULT_VARIABLE result OUTPUT_VARIABLE stdout ERROR_VARIABLE stderr)
  file(WRITE "${WORK}/${name}.log" "${stdout}\n${stderr}")
  if(expected STREQUAL "success" AND NOT result STREQUAL "0")
    message(FATAL_ERROR "${name} failed (${result}): ${stdout}\n${stderr}")
  elseif(expected STREQUAL "failure" AND result STREQUAL "0")
    message(FATAL_ERROR "${name} unexpectedly succeeded")
  endif()
endfunction()

function(check_events path expected)
  file(STRINGS "${path}" lines)
  list(POP_FRONT lines header)
  if(NOT header STREQUAL "stage\tevent\telapsed_seconds\tunix_seconds")
    message(FATAL_ERROR "Invalid profile header: ${header}")
  endif()
  set(actual)
  set(previous 0)
  foreach(line IN LISTS lines)
    string(REPLACE "\t" ";" fields "${line}")
    list(LENGTH fields count)
    if(NOT count EQUAL 4)
      message(FATAL_ERROR "Malformed profile event: ${line}")
    endif()
    list(GET fields 0 stage)
    list(GET fields 1 event)
    list(GET fields 2 elapsed)
    list(GET fields 3 unix_seconds)
    set(number "^[0-9]+([.][0-9]+)?([eE][-+]?[0-9]+)?$")
    if(NOT stage MATCHES "^[a-z_]+$" OR NOT event MATCHES "^(start|end)$" OR
       NOT elapsed MATCHES "${number}" OR NOT unix_seconds MATCHES "${number}")
      message(FATAL_ERROR "Malformed or nonfinite profile event: ${line}")
    endif()
    if(elapsed LESS 0 OR elapsed LESS previous OR elapsed GREATER 1e12 OR
       unix_seconds LESS_EQUAL 0 OR unix_seconds GREATER 1e12)
      message(FATAL_ERROR "Nonmonotonic time: ${line}")
    endif()
    set(previous "${elapsed}")
    list(APPEND actual "${stage}/${event}")
  endforeach()
  if(NOT "${actual}" STREQUAL "${expected}")
    message(FATAL_ERROR "Unexpected events: ${actual}, expected ${expected}")
  endif()
endfunction()

set(events)
foreach(stage library_preparation extraction rescoring inference export)
  list(APPEND events "${stage}/start" "${stage}/end")
endforeach()
run_case(sqlite success -workflow:working_format sqlite -workflow:profile "${WORK}/sqlite.tsv")
check_events("${WORK}/sqlite.tsv" "${events}")
run_case(parquet success -workflow:working_format parquet -workflow:keep_intermediate_files true
  -workflow:profile "${WORK}/parquet.tsv")
check_events("${WORK}/parquet.tsv" "${events};archive_commit/start;archive_commit/end")

# A non-path enum value must not reserve a same-named relative profile file.
run_case(auto success -workflow:library_mode auto -workflow:profile ./auto)
check_events("${WORK}/auto" "${events}")

# The default remains empty and must not create any timeline output.
run_case(default success -workflow:working_format sqlite)
file(GLOB default_profiles "${WORK}/default_out/*profile*" "${WORK}/default_out/*stage*")
if(default_profiles)
  message(FATAL_ERROR "Default workflow created profiling files: ${default_profiles}")
endif()
execute_process(COMMAND "${CMAKE_COMMAND}" -E compare_files
  "${WORK}/sqlite_out/${BASENAME}.results.tsv" "${WORK}/default_out/${BASENAME}.results.tsv"
  RESULT_VARIABLE different)
if(different)
  message(FATAL_ERROR "Profiling changed the result export")
endif()

# Force a library-stage failure after the start event, before extraction.
run_case(failed failure -tr "${TARGET_LIBRARY}" -workflow:library_mode prepared_pqp
  -workflow:profile "${WORK}/failed.tsv")
check_events("${WORK}/failed.tsv" "library_preparation/start")

# Disabled exports and single-run manual outputs must not reserve fabricated
# paths. Stop in library preparation, before these test outputs could be used.
file(MAKE_DIRECTORY "${WORK}/disabled_out")
set(disabled_profile "${WORK}/disabled_out/${BASENAME}.protein.matrix.tsv")
run_case(disabled failure -tr "${TARGET_LIBRARY}" -workflow:profile "${disabled_profile}")
check_events("${disabled_profile}" "library_preparation/start")
set(unexpanded_profile "${WORK}/${BASENAME}_manual.sqMass")
run_case(unexpanded failure -tr "${TARGET_LIBRARY}"
  -TargetedDataExtraction:out_chrom "${WORK}/manual.sqMass" -workflow:profile "${unexpanded_profile}")
check_events("${unexpanded_profile}" "library_preparation/start")

# Reject generated output paths before opening/truncating the profile.
file(MAKE_DIRECTORY "${WORK}/collision_out")
set(collision "${WORK}/collision_out/${BASENAME}.results.tsv")
file(WRITE "${collision}" "must survive\n")
run_case(collision failure -workflow:profile "${collision}")
file(READ "${WORK}/collision.log" diagnostic)
if(NOT diagnostic MATCHES "workflow:profile aliases")
  message(FATAL_ERROR "Output collision failed for the wrong reason: ${diagnostic}")
endif()
file(READ "${collision}" preserved)
if(NOT preserved STREQUAL "must survive\n")
  message(FATAL_ERROR "Output collision truncated a workflow file")
endif()
# Copy inputs locally so even a regression cannot damage checked-in fixtures.
file(COPY_FILE "${LIBRARY}" "${WORK}/input.pqp")
file(SHA256 "${WORK}/input.pqp" before)
run_case(input_collision failure -tr "${WORK}/input.pqp" -workflow:profile "${WORK}/input.pqp")
file(SHA256 "${WORK}/input.pqp" after)
if(NOT before STREQUAL after)
  message(FATAL_ERROR "Input collision modified the library")
endif()
file(MAKE_DIRECTORY "${WORK}/path with spaces")
set(nonlinear "${WORK}/path with spaces/irt.pqp")
file(COPY_FILE "${LIBRARY}" "${nonlinear}")
file(SHA256 "${nonlinear}" before_nonlinear)
run_case(nonlinear_collision failure
  -TargetedDataExtraction:Calibration:files:linear_irt_file "${LIBRARY}"
  -TargetedDataExtraction:Calibration:files:nonlinear_irt_file "${nonlinear}"
  -workflow:profile "${nonlinear}")
file(SHA256 "${nonlinear}" after_nonlinear)
file(READ "${WORK}/nonlinear_collision.log" diagnostic)
if(NOT before_nonlinear STREQUAL after_nonlinear OR NOT diagnostic MATCHES "workflow:profile aliases")
  message(FATAL_ERROR "Calibration path with spaces was not safely rejected: ${diagnostic}")
endif()
set(log_path "${WORK}/shared.log")
file(WRITE "${log_path}" "must survive\n")
run_case(log_collision failure -log "${log_path}" -workflow:profile "${log_path}")
file(READ "${WORK}/log_collision.log" diagnostic)
file(READ "${log_path}" preserved_log)
string(FIND "${preserved_log}" "must survive\n" sentinel_position)
# TOPPBase appends diagnostics before main_, but the profiler must not truncate.
if(NOT sentinel_position EQUAL 0 OR NOT diagnostic MATCHES "workflow:profile aliases")
  message(FATAL_ERROR "Log collision was not safely rejected: ${diagnostic}")
endif()
file(REMOVE "${WORK}/input_alias.pqp")
file(CREATE_LINK "${WORK}/input.pqp" "${WORK}/input_alias.pqp" SYMBOLIC RESULT link_result)
if(link_result STREQUAL "0")
  run_case(alias_collision failure -tr "${WORK}/input.pqp" -workflow:profile "${WORK}/input_alias.pqp")
endif()
file(SHA256 "${WORK}/input.pqp" after)
if(NOT before STREQUAL after)
  message(FATAL_ERROR "Symlink collision modified the library")
endif()
file(CREATE_LINK "${WORK}/input.pqp" "${WORK}/input_hardlink.pqp" RESULT link_result)
if(link_result STREQUAL "0")
  run_case(hardlink_collision failure -tr "${WORK}/input.pqp" -workflow:profile "${WORK}/input_hardlink.pqp")
  file(SHA256 "${WORK}/input.pqp" after)
  if(NOT before STREQUAL after)
    message(FATAL_ERROR "Hardlink collision modified the library")
  endif()
endif()
list(FIND COMMON_ARGS "-in" input_index)
math(EXPR input_index "${input_index} + 1")
list(GET COMMON_ARGS ${input_index} raw_input)
set(expanded_profile "${WORK}/${BASENAME}_multirun.sqMass")
file(WRITE "${expanded_profile}" "must survive\n")
run_case(expanded_collision failure -in "${raw_input}" "${raw_input}"
  -TargetedDataExtraction:out_chrom "${WORK}/multirun.sqMass" -workflow:profile "${expanded_profile}")
file(READ "${WORK}/expanded_collision.log" diagnostic)
if(NOT diagnostic MATCHES "workflow:profile aliases")
  message(FATAL_ERROR "Multi-run collision failed for the wrong reason: ${diagnostic}")
endif()
file(READ "${expanded_profile}" preserved)
if(NOT preserved STREQUAL "must survive\n")
  message(FATAL_ERROR "Multi-run output collision truncated a workflow file")
endif()
file(COPY_FILE "${raw_input}" "${WORK}/raw.mzML")
file(SHA256 "${WORK}/raw.mzML" before)
run_case(raw_collision failure -in "${WORK}/raw.mzML" -workflow:profile "${WORK}/raw.mzML")
file(SHA256 "${WORK}/raw.mzML" after)
if(NOT before STREQUAL after)
  message(FATAL_ERROR "Input collision modified the raw file")
endif()
# A directory-valued raw input owns all of its children. Use a universally
# accepted suffix to exercise preflight without optional vendor-reader support.
set(raw_directory "${WORK}/raw_directory.mzML")
file(MAKE_DIRECTORY "${raw_directory}")
file(WRITE "${raw_directory}/analysis.tdf" "raw marker must survive\n")
run_case(directory_collision failure -in "${raw_directory}"
  -workflow:profile "${raw_directory}/analysis.tdf")
file(READ "${raw_directory}/analysis.tdf" preserved)
file(READ "${WORK}/directory_collision.log" diagnostic)
if(NOT preserved STREQUAL "raw marker must survive\n" OR NOT diagnostic MATCHES "workflow:profile aliases")
  message(FATAL_ERROR "Raw-directory child collision was not safely rejected: ${diagnostic}")
endif()

# Existing targets are refused atomically, including aliases outside the raw
# directory and child symlinks whose targets resolve outside that directory.
file(CREATE_LINK "${raw_directory}/analysis.tdf" "${WORK}/outside_raw_hardlink.tsv" RESULT link_result)
if(link_result STREQUAL "0")
  run_case(raw_child_hardlink failure -in "${raw_directory}" -workflow:profile "${WORK}/outside_raw_hardlink.tsv")
  file(READ "${raw_directory}/analysis.tdf" preserved)
  file(READ "${WORK}/raw_child_hardlink.log" diagnostic)
  if(NOT preserved STREQUAL "raw marker must survive\n" OR NOT diagnostic MATCHES "not writable")
    message(FATAL_ERROR "Outside raw-child hardlink was not safely refused: ${diagnostic}")
  endif()
endif()
file(WRITE "${WORK}/outside_raw_target.tdf" "outside raw marker must survive\n")
file(CREATE_LINK "${WORK}/outside_raw_target.tdf" "${raw_directory}/outside.tdf" SYMBOLIC RESULT link_result)
if(link_result STREQUAL "0")
  run_case(raw_child_symlink failure -in "${raw_directory}" -workflow:profile "${raw_directory}/outside.tdf")
  file(READ "${WORK}/outside_raw_target.tdf" preserved)
  file(READ "${WORK}/raw_child_symlink.log" diagnostic)
  if(NOT preserved STREQUAL "outside raw marker must survive\n" OR NOT diagnostic MATCHES "not writable")
    message(FATAL_ERROR "Raw-child symlink was not safely refused: ${diagnostic}")
  endif()
endif()
file(WRITE "${WORK}/existing_profile.tsv" "existing profile must survive\n")
run_case(existing_profile failure -workflow:profile "${WORK}/existing_profile.tsv")
file(READ "${WORK}/existing_profile.tsv" preserved)
file(READ "${WORK}/existing_profile.log" diagnostic)
if(NOT preserved STREQUAL "existing profile must survive\n" OR NOT diagnostic MATCHES "not writable")
  message(FATAL_ERROR "Existing ordinary profile was not safely refused: ${diagnostic}")
endif()

# Missing parent and existing special files are also refused on open.
run_case(open_failure failure -workflow:profile "${WORK}/missing/profile.tsv")
if(EXISTS "/dev/full")
  run_case(existing_special_file failure -workflow:profile /dev/full)
endif()
