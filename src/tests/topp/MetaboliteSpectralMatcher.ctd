<?xml version="1.0" encoding="UTF-8"?>
<tool ctdVersion="1.8" version="3.5.0-pre-nuc-dia-2025-07-24" name="MetaboliteSpectralMatcher" docurl="http://www.openms.de/doxygen/nightly/html/TOPP_MetaboliteSpectralMatcher.html" category="Metabolite Identification" >
<description><![CDATA[Perform a spectral library search.]]></description>
<manual><![CDATA[Perform a spectral library search.]]></manual>
<citations>
  <citation doi="10.1038/s41592-024-02197-7" url="" />
</citations>
<PARAMETERS version="1.8.0" xsi:noNamespaceSchemaLocation="https://raw.githubusercontent.com/OpenMS/OpenMS/develop/share/OpenMS/SCHEMAS/Param_1_8_0.xsd" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <NODE name="MetaboliteSpectralMatcher" description="Perform a spectral library search.">
    <ITEM name="version" value="3.5.0-pre-nuc-dia-2025-07-24" type="string" description="Version of the tool that generated this parameters file." required="false" advanced="true" />
    <NODE name="1" description="Instance &apos;1&apos; section for &apos;MetaboliteSpectralMatcher&apos;">
      <ITEM name="in" value="" type="input-file" description="Input spectra." required="true" advanced="false" supported_formats="*.mzML" />
      <ITEM name="database" value="" type="input-file" description="Default spectral database." required="true" advanced="false" supported_formats="*.mzML,*.msp,*.mgf" />
      <ITEM name="out" value="" type="output-file" description="mzTab file" required="true" advanced="false" supported_formats="*.mzTab" />
      <ITEM name="out_spectra" value="" type="output-file" description="Output spectra as mzML file. Can be useful to inspect the peak map after spectra merging." required="false" advanced="false" supported_formats="*.mzML" />
      <ITEM name="log" value="" type="string" description="Name of log file (created only when specified)" required="false" advanced="true" />
      <ITEM name="debug" value="0" type="int" description="Sets the debug level" required="false" advanced="true" />
      <ITEM name="threads" value="1" type="int" description="Sets the number of threads allowed to be used by the TOPP tool" required="false" advanced="false" />
      <ITEM name="no_progress" value="false" type="bool" description="Disables progress logging to command line" required="false" advanced="true" />
      <ITEM name="force" value="false" type="bool" description="Overrides tool-specific checks" required="false" advanced="true" />
      <ITEM name="test" value="false" type="bool" description="Enables the test mode (needed for internal use only)" required="false" advanced="true" />
      <NODE name="algorithm" description="Algorithm parameters section">
        <ITEM name="prec_mass_error_value" value="100.0" type="double" description="Error allowed for precursor ion mass." required="false" advanced="false" />
        <ITEM name="frag_mass_error_value" value="500.0" type="double" description="Error allowed for product ions." required="false" advanced="false" />
        <ITEM name="mass_error_unit" value="ppm" type="string" description="Unit of mass error (ppm or Da)" required="false" advanced="false" restrictions="ppm,Da" />
        <ITEM name="report_mode" value="top3" type="string" description="Which results shall be reported: the top-three scoring ones or the best scoring one?" required="false" advanced="false" restrictions="top3,best" />
        <ITEM name="ionization_mode" value="positive" type="string" description="Positive or negative ionization mode?" required="false" advanced="false" restrictions="positive,negative" />
        <ITEM name="merge_spectra" value="true" type="string" description="Merge MS2 spectra with the same precursor mass." required="false" advanced="false" restrictions="true,false" />
      </NODE>
    </NODE>
  </NODE>
</PARAMETERS>
</tool>
