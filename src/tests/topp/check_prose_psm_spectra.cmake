# Checks the sidecar that ProSE writes with -out_psm_spectra (<stem>.psm_spectra.parquet), from text dumps
# (ParquetDiff -out_tsv, in file order). Usage:
#
#   cmake -DSIDECAR=<sidecar dump> -DPSMS=<dump of the OpenMS psm.parquet of the same input (-out_parquet)>
#         -DMZML=<the searched mzML, uncompressed> [-DQPX=<dump of the QPX psm.parquet of the same input>]
#         [-DPEAKS=ON|OFF] [-DPREDICTIONS=ON|OFF] [-DTWIN=<sidecar dump whose peaks must be the same>]
#         [-DYAML=<-summary_out> [-DYAML_FILE=<position of the input, default 0>] [-DNCE=<expected NCE>]
#          [-DLOG=<output of the run> -DNCE_SOURCE=<"from PeptDeep rescoring", "selected" or "set">]
#          [-DPEPTIDE=<peptidoform> -DCHARGE=<z> -DREFERENCE=<tsv: nce, ion, mz, intensity>
#           -DOUT_PREDICTED=<file> -DOUT_REFERENCE=<file>]]
#         -P check_prose_psm_spectra.cmake
#
# - The sidecar has the key psm_id and the five columns, and as many rows as the psm view (QPX, and the OpenMS psm
#   table, whose rows it follows: the best hit of each identification, in order).
# - PEAKS ON (default): every row has the peaks of its spectrum, as many as the spectrum with the row's native ID has in
#   the mzML (defaultArrayLength). OFF: every peak column is null.
# - PREDICTIONS ON (default): every row of precursor charge 1 to 6 has a non-empty prediction, with as many ions as m/z
#   and intensities. OFF: every prediction column is null.
# - TWIN: the peak columns equal those of TWIN, row by row (the same spectra read from another copy of the file).
# - YAML: the summary reports a number as the NCE of the input (equal to NCE if given). With LOG, the run logged that
#   NCE with its source NCE_SOURCE, and for "from PeptDeep rescoring" PeptDeep rescoring logged the same NCE ("NCE=").
# - PEPTIDE: the predicted ions of the first row of that peptidoform and CHARGE go to OUT_PREDICTED, the rows of
#   REFERENCE of the reported NCE to OUT_REFERENCE, as "ion<TAB>m/z<TAB>intensity" lines, for FuzzyDiff.
foreach(_required SIDECAR PSMS MZML)
  if (NOT DEFINED ${_required})
    message(FATAL_ERROR "${_required} is required")
  endif()
endforeach()
foreach(_flag PEAKS PREDICTIONS)
  if (NOT DEFINED ${_flag})
    set(${_flag} ON)
  endif()
endforeach()
if (NOT DEFINED YAML_FILE)
  set(YAML_FILE 0)
endif()

# Peak counts of the spectra, by native ID.
file(STRINGS "${MZML}" _spectra REGEX "<spectrum [^>]*defaultArrayLength=")
foreach(_s IN LISTS _spectra)
  if (_s MATCHES "id=\"([^\"]*)\"")
    set(_id "${CMAKE_MATCH_1}")
    if (_s MATCHES "defaultArrayLength=\"([0-9]+)\"")
      string(MAKE_C_IDENTIFIER "${_id}" _key)
      set(_peaks_${_key} "${CMAKE_MATCH_1}")
    endif()
  endif()
endforeach()

# A dump as a list of lines, with its header as a list of column names (brackets and semicolons would change how CMake
# splits lists, so the list brackets of the dump become '<' '>').
macro(read_dump file prefix)
  file(READ "${file}" _dump)
  string(REPLACE ";" "," _dump "${_dump}")
  string(REPLACE "[" "<" _dump "${_dump}")
  string(REPLACE "]" ">" _dump "${_dump}")
  string(REPLACE "\n" ";" ${prefix}_lines "${_dump}")
  list(FILTER ${prefix}_lines EXCLUDE REGEX "^$")
  list(POP_FRONT ${prefix}_lines ${prefix}_header)
  string(REPLACE "\t" ";" ${prefix}_header "${${prefix}_header}")
  list(LENGTH ${prefix}_lines ${prefix}_rows)
endmacro()
macro(column prefix name out)
  list(FIND ${prefix}_header "${name}" ${out})
  if (${out} EQUAL -1)
    message(FATAL_ERROR "no column '${name}' in the dump (${${prefix}_header})")
  endif()
endmacro()
# The number of values of a dumped list "<a, b, c>"; -1 for null.
function(list_length value out)
  if (value STREQUAL "null")
    set(${out} -1 PARENT_SCOPE)
    return()
  endif()
  string(REGEX REPLACE "^<(.*)>$" "\\1" _inner "${value}")
  if (_inner STREQUAL "")
    set(${out} 0 PARENT_SCOPE)
    return()
  endif()
  string(REPLACE ", " ";" _items "${_inner}")
  list(LENGTH _items _n)
  set(${out} ${_n} PARENT_SCOPE)
endfunction()

read_dump("${SIDECAR}" sc)
read_dump("${PSMS}" psm)
column(sc psm_id _c_id)
column(sc peak_mz_array _c_peak_mz)
column(sc peak_intensity_array _c_peak_intensity)
column(sc predicted_ion_type_array _c_ions)
column(sc predicted_mz_array _c_mz)
column(sc predicted_intensity_array _c_intensity)
list(LENGTH sc_header _n_columns)
if (NOT _n_columns EQUAL 6)
  message(FATAL_ERROR "${SIDECAR}: ${_n_columns} columns (${sc_header}), expected psm_id and the five")
endif()
column(psm spectrum_reference _c_ref)
column(psm peptidoform _c_peptidoform)
column(psm precursor_charge _c_charge)
column(psm hit_index _c_hit)
# the rows of the psm view: the best hit (hit_index 0) of each identification
set(_view_lines "")
foreach(_line IN LISTS psm_lines)
  string(REPLACE "\t" ";" _cells "${_line}")
  list(GET _cells ${_c_hit} _hit)
  if (_hit EQUAL 0)
    list(APPEND _view_lines "${_line}")
  endif()
endforeach()
list(LENGTH _view_lines _view_rows)
if (NOT sc_rows EQUAL _view_rows)
  message(FATAL_ERROR "${SIDECAR}: ${sc_rows} rows, the psm view of ${PSMS} has ${_view_rows}")
endif()
if (DEFINED QPX)
  read_dump("${QPX}" qpx)
  if (NOT sc_rows EQUAL qpx_rows)
    message(FATAL_ERROR "${SIDECAR}: ${sc_rows} rows, ${QPX} has ${qpx_rows}")
  endif()
endif()
if (DEFINED TWIN)
  read_dump("${TWIN}" twin)
  if (NOT sc_rows EQUAL twin_rows)
    message(FATAL_ERROR "${SIDECAR}: ${sc_rows} rows, the twin ${TWIN} has ${twin_rows}")
  endif()
endif()

set(_predicted_rows 0)
set(_found_peptide OFF)
math(EXPR _last "${sc_rows} - 1")
foreach(_row RANGE 0 ${_last})
  list(GET sc_lines ${_row} _line)
  string(REPLACE "\t" ";" _cells "${_line}")
  list(GET _cells ${_c_peak_mz} _peak_mz)
  list(GET _cells ${_c_peak_intensity} _peak_intensity)
  list(GET _cells ${_c_ions} _ions)
  list(GET _cells ${_c_mz} _mz)
  list(GET _cells ${_c_intensity} _intensity)
  list(GET _view_lines ${_row} _psm)
  string(REPLACE "\t" ";" _psm "${_psm}")
  list(GET _psm ${_c_ref} _ref)
  list(GET _psm ${_c_peptidoform} _peptidoform)
  list(GET _psm ${_c_charge} _charge)

  # peaks
  list_length("${_peak_mz}" _n_mz)
  list_length("${_peak_intensity}" _n_intensity)
  if (PEAKS)
    string(MAKE_C_IDENTIFIER "${_ref}" _key)
    if (NOT DEFINED _peaks_${_key})
      message(FATAL_ERROR "${SIDECAR}: row ${_row} (${_peptidoform}): no spectrum '${_ref}' in ${MZML}")
    endif()
    if (NOT _n_mz EQUAL _peaks_${_key} OR NOT _n_intensity EQUAL _peaks_${_key})
      message(FATAL_ERROR "${SIDECAR}: row ${_row} (${_peptidoform}, ${_ref}): ${_n_mz} m/z and ${_n_intensity} "
                          "intensities, but the spectrum has ${_peaks_${_key}} peaks")
    endif()
  elseif (NOT _n_mz EQUAL -1 OR NOT _n_intensity EQUAL -1)
    message(FATAL_ERROR "${SIDECAR}: row ${_row} (${_peptidoform}): peaks, expected none")
  endif()
  if (DEFINED TWIN)
    list(GET twin_lines ${_row} _twin)
    string(REPLACE "\t" ";" _twin "${_twin}")
    list(GET _twin ${_c_peak_mz} _twin_mz)
    list(GET _twin ${_c_peak_intensity} _twin_intensity)
    if (NOT _twin_mz STREQUAL _peak_mz OR NOT _twin_intensity STREQUAL _peak_intensity)
      message(FATAL_ERROR "${SIDECAR}: row ${_row} (${_peptidoform}): other peaks than in ${TWIN}")
    endif()
  endif()

  # predictions
  list_length("${_ions}" _n_ions)
  list_length("${_mz}" _n_pred_mz)
  list_length("${_intensity}" _n_pred_intensity)
  if (PREDICTIONS)
    if (_charge GREATER_EQUAL 1 AND _charge LESS_EQUAL 6)
      if (_n_ions LESS 1 OR NOT _n_pred_mz EQUAL _n_ions OR NOT _n_pred_intensity EQUAL _n_ions)
        message(FATAL_ERROR "${SIDECAR}: row ${_row} (${_peptidoform}, charge ${_charge}): ${_n_ions} predicted ions, "
                            "${_n_pred_mz} m/z, ${_n_pred_intensity} intensities")
      endif()
      math(EXPR _predicted_rows "${_predicted_rows} + 1")
    endif()
  elseif (NOT _n_ions EQUAL -1 OR NOT _n_pred_mz EQUAL -1 OR NOT _n_pred_intensity EQUAL -1)
    message(FATAL_ERROR "${SIDECAR}: row ${_row} (${_peptidoform}): a prediction, expected none")
  endif()

  if (DEFINED PEPTIDE AND NOT _found_peptide AND _peptidoform STREQUAL PEPTIDE AND _charge EQUAL CHARGE)
    set(_found_peptide ON)
    foreach(_v _ions _mz _intensity)
      string(REGEX REPLACE "^<(.*)>$" "\\1" ${_v} "${${_v}}")
      string(REPLACE ", " ";" ${_v} "${${_v}}")
    endforeach()
    set(_predicted "")
    foreach(_ion _m _i IN ZIP_LISTS _ions _mz _intensity)
      string(APPEND _predicted "${_ion}\t${_m}\t${_i}\n")
    endforeach()
    file(WRITE "${OUT_PREDICTED}" "${_predicted}")
  endif()
endforeach()

if (sc_rows EQUAL 0)
  message(FATAL_ERROR "${SIDECAR}: no rows")
endif()
if (PREDICTIONS AND _predicted_rows EQUAL 0)
  message(FATAL_ERROR "${SIDECAR}: no row of charge 1 to 6")
endif()

if (DEFINED YAML)
  # the NCE of the input, as the summary reports it
  file(STRINGS "${YAML}" _nce REGEX "^ +peptdeep_nce: ")
  list(LENGTH _nce _n_nce)
  if (_n_nce LESS_EQUAL YAML_FILE)
    message(FATAL_ERROR "${YAML}: no 'peptdeep_nce' of input ${YAML_FILE}")
  endif()
  list(GET _nce ${YAML_FILE} _nce)
  string(REGEX REPLACE "^ +peptdeep_nce: " "" _nce "${_nce}")
  if (NOT _nce MATCHES "^[0-9.]+$")
    message(FATAL_ERROR "${YAML}: the NCE of input ${YAML_FILE} is '${_nce}'")
  endif()
  if (DEFINED NCE AND NOT _nce EQUAL NCE)
    message(FATAL_ERROR "${YAML}: the NCE of input ${YAML_FILE} is ${_nce}, expected ${NCE}")
  endif()
  if (DEFINED LOG)
    file(READ "${LOG}" _log)
    string(FIND "${_log}" "at NCE ${_nce} (${NCE_SOURCE})" _at)
    if (_at EQUAL -1)
      message(FATAL_ERROR "${LOG}: no prediction 'at NCE ${_nce} (${NCE_SOURCE})'")
    endif()
    if (NCE_SOURCE STREQUAL "from PeptDeep rescoring")
      # the NCE PeptDeep rescoring logged when it added its features
      if (NOT _log MATCHES "Predicted features added: [^\n]*NCE=([0-9.]+)")
        message(FATAL_ERROR "${LOG}: PeptDeep rescoring logged no NCE")
      endif()
      if (NOT CMAKE_MATCH_1 EQUAL _nce)
        message(FATAL_ERROR "PeptDeep rescoring used NCE ${CMAKE_MATCH_1}, the summary reports ${_nce}")
      endif()
    endif()
  endif()
  if (DEFINED PEPTIDE)
    if (NOT _found_peptide)
      message(FATAL_ERROR "${SIDECAR}: no row of ${PEPTIDE} with charge ${CHARGE}")
    endif()
    set(_reference "")
    file(STRINGS "${REFERENCE}" _reference_lines)
    foreach(_r IN LISTS _reference_lines)
      string(REPLACE "\t" ";" _r "${_r}")
      list(POP_FRONT _r _r_nce)
      if (_r_nce EQUAL _nce)
        string(REPLACE ";" "\t" _r "${_r}")
        string(APPEND _reference "${_r}\n")
      endif()
    endforeach()
    if (_reference STREQUAL "")
      message(FATAL_ERROR "${REFERENCE}: no prediction for NCE ${_nce}")
    endif()
    file(WRITE "${OUT_REFERENCE}" "${_reference}")
  endif()
endif()

message(STATUS "${SIDECAR}: ${sc_rows} rows, ${_predicted_rows} with a prediction")
