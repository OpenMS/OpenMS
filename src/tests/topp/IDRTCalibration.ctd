<?xml version="1.0" encoding="UTF-8"?>
<tool ctdVersion="1.8" version="3.5.0-pre-nuc-dia-2025-07-24" name="IDRTCalibration" docurl="http://www.openms.de/doxygen/nightly/html/TOPP_IDRTCalibration.html" category="Mass Correction and Calibration" >
<description><![CDATA[Calibrate RTs of peptide hits linearly to standards.]]></description>
<manual><![CDATA[Calibrate RTs of peptide hits linearly to standards.]]></manual>
<citations>
  <citation doi="10.1038/s41592-024-02197-7" url="" />
</citations>
<PARAMETERS version="1.8.0" xsi:noNamespaceSchemaLocation="https://raw.githubusercontent.com/OpenMS/OpenMS/develop/share/OpenMS/SCHEMAS/Param_1_8_0.xsd" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <NODE name="IDRTCalibration" description="Calibrate RTs of peptide hits linearly to standards.">
    <ITEM name="version" value="3.5.0-pre-nuc-dia-2025-07-24" type="string" description="Version of the tool that generated this parameters file." required="false" advanced="true" />
    <NODE name="1" description="Instance &apos;1&apos; section for &apos;IDRTCalibration&apos;">
      <ITEM name="in" value="" type="input-file" description="input file " required="true" advanced="false" supported_formats="*.idXML" />
      <ITEM name="out" value="" type="output-file" description="output file " required="true" advanced="false" supported_formats="*.idXML" />
      <ITEM name="calibrant_1_reference" value="0.1" type="double" description="The RT of the first calibrant in the reference file." required="false" advanced="false" />
      <ITEM name="calibrant_2_reference" value="0.9" type="double" description="The RT of the second calibrant in the reference file." required="false" advanced="false" />
      <ITEM name="calibrant_1_input" value="-1.0" type="double" description="The RT of the first calibrant in the input file. Please note that this value needs to be set. The default value -1.0 is not allowed." required="false" advanced="false" />
      <ITEM name="calibrant_2_input" value="-1.0" type="double" description="The RT of the second calibrant in the input file. Please note that this value needs to be set. The default value -1.0 is not allowed." required="false" advanced="false" />
      <ITEM name="log" value="" type="string" description="Name of log file (created only when specified)" required="false" advanced="true" />
      <ITEM name="debug" value="0" type="int" description="Sets the debug level" required="false" advanced="true" />
      <ITEM name="threads" value="1" type="int" description="Sets the number of threads allowed to be used by the TOPP tool" required="false" advanced="false" />
      <ITEM name="no_progress" value="false" type="bool" description="Disables progress logging to command line" required="false" advanced="true" />
      <ITEM name="force" value="false" type="bool" description="Overrides tool-specific checks" required="false" advanced="true" />
      <ITEM name="test" value="false" type="bool" description="Enables the test mode (needed for internal use only)" required="false" advanced="true" />
    </NODE>
  </NODE>
</PARAMETERS>
</tool>
