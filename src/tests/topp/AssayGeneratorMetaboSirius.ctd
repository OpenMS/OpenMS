<?xml version="1.0" encoding="UTF-8"?>
<tool ctdVersion="1.8" version="3.5.0-pre-nuc-dia-2025-07-24" name="AssayGeneratorMetaboSirius" docurl="http://www.openms.de/doxygen/nightly/html/TOPP_AssayGeneratorMetaboSirius.html" category="Targeted Experiments and OpenSWATH" >
<description><![CDATA[Assay library generation from a SIRIUS project directory (Metabolomics)]]></description>
<manual><![CDATA[Assay library generation from a SIRIUS project directory (Metabolomics)]]></manual>
<citations>
  <citation doi="10.1038/s41592-024-02197-7" url="" />
</citations>
<PARAMETERS version="1.8.0" xsi:noNamespaceSchemaLocation="https://raw.githubusercontent.com/OpenMS/OpenMS/develop/share/OpenMS/SCHEMAS/Param_1_8_0.xsd" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <NODE name="AssayGeneratorMetaboSirius" description="Assay library generation from a SIRIUS project directory (Metabolomics)">
    <ITEM name="version" value="3.5.0-pre-nuc-dia-2025-07-24" type="string" description="Version of the tool that generated this parameters file." required="false" advanced="true" />
    <NODE name="1" description="Instance &apos;1&apos; section for &apos;AssayGeneratorMetaboSirius&apos;">
      <ITEM name="in" value="" type="input-file" description="SIRIUS project directory" required="true" advanced="false" />
      <ITEM name="in_compoundinfo" value="" type="input-file" description="Compound info table (.tsv file)" required="true" advanced="false" supported_formats="*.tsv" />
      <ITEM name="out" value="" type="output-file" description="Assay library output file" required="true" advanced="false" supported_formats="*.tsv,*.traML,*.pqp" />
      <ITEM name="ambiguity_resolution_mz_tolerance" value="10.0" type="double" description="Mz tolerance for the resolution of identification ambiguity over multiple files" required="false" advanced="false" />
      <ITEM name="ambiguity_resolution_mz_tolerance_unit" value="ppm" type="string" description="Unit of the ambiguity_resolution_mz_tolerance" required="false" advanced="true" restrictions="ppm,Da" />
      <ITEM name="ambiguity_resolution_rt_tolerance" value="10.0" type="double" description="RT tolerance in seconds for the resolution of identification ambiguity over multiple files" required="false" advanced="false" />
      <ITEM name="total_occurrence_filter" value="0.1" type="double" description="Filter compound based on total occurrence in analysed samples" required="false" advanced="false" restrictions="0.000000:1.000000" />
      <ITEM name="fragment_annotation_score_threshold" value="0.8" type="double" description="Filters annotations based on the explained intensity of the peaks in a spectrum" required="false" advanced="false" restrictions="0.000000:1.000000" />
      <ITEM name="method" value="highest_intensity" type="string" description="Spectrum with the highest precursor intensity or a consensus spectrum is used for assay library construction (if no fragment annotation is used)." required="false" advanced="false" restrictions="highest_intensity,consensus_spectrum" />
      <ITEM name="use_exact_mass" value="false" type="bool" description="Use exact mass for precursor and fragment annotations" required="false" advanced="false" />
      <ITEM name="exclude_ms2_precursor" value="false" type="bool" description="Excludes precursor in ms2 from transition list" required="false" advanced="false" />
      <ITEM name="use_known_unknowns" value="false" type="bool" description="Use features without identification information" required="false" advanced="false" />
      <ITEM name="min_transitions" value="3" type="int" description="Minimal number of transitions" required="false" advanced="false" />
      <ITEM name="max_transitions" value="6" type="int" description="Maximal number of transitions" required="false" advanced="false" />
      <ITEM name="transition_threshold" value="5.0" type="double" description="Further transitions need at least x% of the maximum intensity (default 5%)" required="false" advanced="false" />
      <ITEM name="min_fragment_mz" value="0.0" type="double" description="Minimal m/z of a fragment ion choosen as a transition" required="false" advanced="true" />
      <ITEM name="max_fragment_mz" value="2000.0" type="double" description="Maximal m/z of a fragment ion choosen as a transition" required="false" advanced="true" />
      <ITEM name="decoy_generation" value="false" type="bool" description="Decoys will be generated using the fragmentation tree re-rooting approach. This option does only work in combination with the fragment annotation via Sirius." required="false" advanced="false" />
      <ITEM name="decoy_generation_method" value="original" type="string" description="Uses different methods for decoy generation. Basis for the method is the fragmentation-tree re-rooting approach (&apos;original&apos;). This approach can be extended by using &apos;resolve_overlap&apos;, which will resolve overlapping target/decoy fragments by adding -CH2 mass to the overlapping decoy fragments. &apos;generate_missing_decoys&apos; will add a -CH2 mass shift to the target fragments and use them as decoys if fragmentation-tree re-rooting failed. &apos;Both&apos; combines the extended methods (resolve_overlap, generate_missing_decoys)." required="false" advanced="false" restrictions="original,resolve_overlap,generate_missing_decoys,both" />
      <ITEM name="decoy_resolution_mz_tolerance" value="10.0" type="double" description="Mz tolerance for the resolution of overlapping m/z values for targets and decoys of one compound." required="false" advanced="false" />
      <ITEM name="decoy_resolution_mz_tolerance_unit" value="ppm" type="string" description="Unit of the decoy_resolution_mz_tolerance" required="false" advanced="true" restrictions="ppm,Da" />
      <ITEM name="log" value="" type="string" description="Name of log file (created only when specified)" required="false" advanced="true" />
      <ITEM name="debug" value="0" type="int" description="Sets the debug level" required="false" advanced="true" />
      <ITEM name="threads" value="1" type="int" description="Sets the number of threads allowed to be used by the TOPP tool" required="false" advanced="false" />
      <ITEM name="no_progress" value="false" type="bool" description="Disables progress logging to command line" required="false" advanced="true" />
      <ITEM name="force" value="false" type="bool" description="Overrides tool-specific checks" required="false" advanced="true" />
      <ITEM name="test" value="false" type="bool" description="Enables the test mode (needed for internal use only)" required="false" advanced="true" />
    </NODE>
  </NODE>
</PARAMETERS>
</tool>
