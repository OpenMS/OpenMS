# Checks the QPX mz view that OpenNuXL writes with -out_qpx, from its ParquetDiff -out_tsv dump.
#
# Usage: cmake -DIDXML=<-out of the run> -DMZ_TSV=<dump of the mz view> -DMZML=<-in of the run>
#              [-DALL_PEAKS=ON] [-DMZ_PARQUET=<the mz view>] -P OpenNuXL_qpx_test.cmake
#
# Requires:
# - one row per native ID (spectrum_reference) of the PeptideIdentifications with hits of the idXML, and no other row;
# - every row keeps a peak within 0.01 Th of each fragment annotation of every hit of its spectrum (the peak filter
#   keeps the annotated peaks);
# - with ALL_PEAKS, every row has all peaks of its spectrum in the mzML (-qpx_peak_top 0); otherwise at least one row
#   has fewer peaks than its spectrum (the filter is applied);
# - with MZ_PARQUET, the footer keys of the peak filter in that file (nuxl_peak_window, nuxl_peak_top,
#   nuxl_peak_annotated = kept; the footer of a Parquet file is not compressed).
cmake_minimum_required(VERSION 3.21) # (policies: list elements, IN_LIST)
foreach(_var IDXML MZ_TSV MZML)
  if(NOT DEFINED ${_var})
    message(FATAL_ERROR "${_var} is required")
  endif()
endforeach()

# An m/z (e.g. "112.050621032714844") in units of 1e-4 Th, as an integer (CMake's math() has no floating point)
function(_to_units value out)
  string(STRIP "${value}" value)
  if(NOT value MATCHES "^([0-9]+)(\\.([0-9]*))?$")
    message(FATAL_ERROR "cannot read the m/z '${value}'")
  endif()
  set(_int "${CMAKE_MATCH_1}")
  set(_frac "${CMAKE_MATCH_3}0000")
  string(SUBSTRING "${_frac}" 0 4 _frac)
  # (the leading 1 keeps the fraction's leading zeros)
  math(EXPR _units "${_int} * 10000 + 1${_frac} - 10000")
  set(${out} ${_units} PARENT_SCOPE)
endfunction()

# Makes text safe for CMake lists: ';' is the list separator, and brackets would group list elements
macro(_safe_text var)
  string(REPLACE ";" "," ${var} "${${var}}")
  string(REPLACE "[" "<" ${var} "${${var}}")
  string(REPLACE "]" ">" ${var} "${${var}}")
endmacro()

# -- the PSMs of the idXML: per native ID the m/z of the fragment annotations of all its hits --
file(READ "${IDXML}" _idxml)
_safe_text(_idxml)
string(REPLACE "<PeptideIdentification " ";<PeptideIdentification " _blocks "${_idxml}")
set(_native_ids "")
foreach(_block IN LISTS _blocks)
  if(NOT _block MATCHES "^<PeptideIdentification ")
    continue()
  endif()
  if(NOT _block MATCHES "<PeptideHit ")
    continue() # (no PSM)
  endif()
  if(NOT _block MATCHES "spectrum_reference=\"([^\"]*)\"")
    message(FATAL_ERROR "a PeptideIdentification with hits has no spectrum_reference")
  endif()
  set(_id "${CMAKE_MATCH_1}")
  string(MAKE_C_IDENTIFIER "${_id}" _key)
  list(APPEND _native_ids "${_id}")
  string(REGEX MATCHALL "name=\"fragment_annotation\" value=\"[^\"]*\"" _annotations "${_block}")
  foreach(_annotation IN LISTS _annotations)
    string(REGEX REPLACE "^name=\"fragment_annotation\" value=\"" "" _annotation "${_annotation}")
    string(REGEX REPLACE "\"$" "" _annotation "${_annotation}")
    string(REPLACE "|" ";" _fragments "${_annotation}")
    foreach(_fragment IN LISTS _fragments)
      string(REGEX MATCH "^[^,]*" _mz "${_fragment}")
      if(NOT _mz STREQUAL "")
        list(APPEND _annotated_${_key} "${_mz}")
      endif()
    endforeach()
  endforeach()
endforeach()
list(REMOVE_DUPLICATES _native_ids)
list(LENGTH _native_ids _psm_spectra)
if(_psm_spectra EQUAL 0)
  message(FATAL_ERROR "${IDXML} has no PSM")
endif()

# -- the peak counts of the spectra of the mzML --
file(READ "${MZML}" _mzml)
_safe_text(_mzml)
string(REGEX MATCHALL "<spectrum id=\"[^\"]*\"[^>]*defaultArrayLength=\"[0-9]+\"" _spectra "${_mzml}")
foreach(_spectrum IN LISTS _spectra)
  string(REGEX MATCH "id=\"([^\"]*)\"" _ "${_spectrum}")
  string(MAKE_C_IDENTIFIER "${CMAKE_MATCH_1}" _key)
  string(REGEX MATCH "defaultArrayLength=\"([0-9]+)\"" _ "${_spectrum}")
  set(_peaks_${_key} "${CMAKE_MATCH_1}")
endforeach()

# -- the rows of the mz view --
file(READ "${MZ_TSV}" _tsv)
_safe_text(_tsv)
string(REPLACE "\n" ";" _lines "${_tsv}")
list(POP_FRONT _lines _header)
string(REPLACE "\t" ";" _header "${_header}")
list(FIND _header "id" _id_column)
list(FIND _header "mz" _mz_column)
if(_id_column EQUAL -1 OR _mz_column EQUAL -1)
  message(FATAL_ERROR "${MZ_TSV}: no 'id' or 'mz' column in the header: ${_header}")
endif()
set(_row_ids "")
set(_filtered_rows 0)
foreach(_line IN LISTS _lines)
  if(_line STREQUAL "")
    continue()
  endif()
  string(REPLACE "\t" ";" _cells "${_line}")
  list(GET _cells ${_id_column} _id)
  list(GET _cells ${_mz_column} _mz_cell)
  if(_id IN_LIST _row_ids)
    message(FATAL_ERROR "${MZ_TSV}: the id '${_id}' has two rows")
  endif()
  if(NOT _id IN_LIST _native_ids)
    message(FATAL_ERROR "${MZ_TSV}: the row '${_id}' is of no PSM of ${IDXML}")
  endif()
  list(APPEND _row_ids "${_id}")
  string(MAKE_C_IDENTIFIER "${_id}" _key)

  # the peaks of the row, in 1e-4 Th
  string(REGEX REPLACE "^<|>$" "" _mz_cell "${_mz_cell}")
  string(REPLACE "," ";" _mzs "${_mz_cell}")
  set(_row_units "")
  foreach(_mz IN LISTS _mzs)
    _to_units("${_mz}" _units)
    list(APPEND _row_units ${_units})
  endforeach()
  list(LENGTH _row_units _row_peaks)
  if(NOT DEFINED _peaks_${_key})
    message(FATAL_ERROR "${MZML} has no spectrum '${_id}'")
  endif()
  if(ALL_PEAKS)
    if(NOT _row_peaks EQUAL _peaks_${_key})
      message(FATAL_ERROR "${MZ_TSV}: the row '${_id}' has ${_row_peaks} peaks, its spectrum ${_peaks_${_key}} (all expected)")
    endif()
  elseif(_row_peaks LESS _peaks_${_key})
    math(EXPR _filtered_rows "${_filtered_rows} + 1")
  endif()

  # every annotated m/z keeps a peak within 0.01 Th (100 units; +1 for the 4-digit truncation)
  foreach(_mz IN LISTS _annotated_${_key})
    _to_units("${_mz}" _annotated)
    set(_found FALSE)
    foreach(_peak IN LISTS _row_units)
      math(EXPR _difference "${_peak} - ${_annotated}")
      if(_difference GREATER_EQUAL -101 AND _difference LESS_EQUAL 101)
        set(_found TRUE)
        break()
      endif()
    endforeach()
    if(NOT _found)
      message(FATAL_ERROR "${MZ_TSV}: the row '${_id}' has no peak of the annotated m/z ${_mz}")
    endif()
  endforeach()
endforeach()

foreach(_id IN LISTS _native_ids)
  if(NOT _id IN_LIST _row_ids)
    message(FATAL_ERROR "${MZ_TSV}: no row of the PSM spectrum '${_id}'")
  endif()
endforeach()
if(NOT ALL_PEAKS AND _filtered_rows EQUAL 0)
  message(FATAL_ERROR "${MZ_TSV}: no row has fewer peaks than its spectrum (the peak filter was not applied)")
endif()
if(DEFINED MZ_PARQUET)
  file(STRINGS "${MZ_PARQUET}" _footer REGEX "nuxl_peak_|kept")
  foreach(_key nuxl_peak_window nuxl_peak_top nuxl_peak_annotated kept)
    string(FIND "${_footer}" "${_key}" _position)
    if(_position EQUAL -1)
      message(FATAL_ERROR "${MZ_PARQUET}: the footer has no '${_key}'")
    endif()
  endforeach()
endif()
list(LENGTH _row_ids _rows)
message(STATUS "${MZ_TSV}: ${_rows} rows, one per PSM spectrum of ${IDXML}, the annotated peaks kept")
