<?xml version="1.0" encoding="UTF-8"?>
<tool ctdVersion="1.8" version="3.5.0-pre-nuc-dia-2025-07-24" name="QCShrinker" docurl="http://www.openms.de/doxygen/nightly/html/TOPP_QCShrinker.html" category="Quality Control" >
<description><![CDATA[Remove unneeded or verbose table attachments from a qcml file.]]></description>
<manual><![CDATA[Remove unneeded or verbose table attachments from a qcml file.]]></manual>
<citations>
  <citation doi="10.1038/s41592-024-02197-7" url="" />
  <citation doi="10.1074/mcp.M113.035907" url="" />
</citations>
<PARAMETERS version="1.8.0" xsi:noNamespaceSchemaLocation="https://raw.githubusercontent.com/OpenMS/OpenMS/develop/share/OpenMS/SCHEMAS/Param_1_8_0.xsd" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <NODE name="QCShrinker" description="Remove unneeded or verbose table attachments from a qcml file.">
    <ITEM name="version" value="3.5.0-pre-nuc-dia-2025-07-24" type="string" description="Version of the tool that generated this parameters file." required="false" advanced="true" />
    <NODE name="1" description="Instance &apos;1&apos; section for &apos;QCShrinker&apos;">
      <ITEM name="in" value="" type="input-file" description="Input qcml file" required="true" advanced="false" supported_formats="*.qcML" />
      <ITEMLIST name="qp_accessions" type="string" description="A list of cv accessions that should be removed. If empty, the usual suspects will be removed!" required="false" advanced="false" >
      </ITEMLIST>
      <ITEM name="name" value="" type="string" description="The name of the target run or set that contains the requested quality parameter." required="false" advanced="false" />
      <ITEM name="run" value="" type="input-file" description="The file from which the name of the target run that contains the requested quality parameter is taken. This overrides the name parameter!" required="false" advanced="false" supported_formats="*.mzML" />
      <ITEM name="out" value="" type="output-file" description="Output extended/reduced qcML file" required="true" advanced="false" supported_formats="*.qcML" />
      <ITEM name="log" value="" type="string" description="Name of log file (created only when specified)" required="false" advanced="true" />
      <ITEM name="debug" value="0" type="int" description="Sets the debug level" required="false" advanced="true" />
      <ITEM name="threads" value="1" type="int" description="Sets the number of threads allowed to be used by the TOPP tool" required="false" advanced="false" />
      <ITEM name="no_progress" value="false" type="bool" description="Disables progress logging to command line" required="false" advanced="true" />
      <ITEM name="force" value="false" type="bool" description="Overrides tool-specific checks" required="false" advanced="true" />
      <ITEM name="test" value="false" type="bool" description="Enables the test mode (needed for internal use only)" required="false" advanced="true" />
    </NODE>
  </NODE>
</PARAMETERS>
</tool>
