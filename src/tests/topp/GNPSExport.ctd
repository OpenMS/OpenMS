<?xml version="1.0" encoding="UTF-8"?>
<tool ctdVersion="1.8" version="3.5.0-pre-nuc-dia-2025-07-24" name="GNPSExport" docurl="http://www.openms.de/doxygen/nightly/html/TOPP_GNPSExport.html" category="File Converter" >
<description><![CDATA[Export representative consensus MS/MS scan per consensusElement into a .MGF file format.
See the documentation on https://ccms-ucsd.github.io/GNPSDocumentation/featurebasedmolecularnetworking-with-openms]]></description>
<manual><![CDATA[Export representative consensus MS/MS scan per consensusElement into a .MGF file format.
See the documentation on https://ccms-ucsd.github.io/GNPSDocumentation/featurebasedmolecularnetworking-with-openms]]></manual>
<citations>
  <citation doi="10.1038/s41592-024-02197-7" url="" />
  <citation doi="10.1101/812404" url="" />
</citations>
<PARAMETERS version="1.8.0" xsi:noNamespaceSchemaLocation="https://raw.githubusercontent.com/OpenMS/OpenMS/develop/share/OpenMS/SCHEMAS/Param_1_8_0.xsd" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <NODE name="GNPSExport" description="Export representative consensus MS/MS scan per consensusElement into a .MGF file format.#br#See the documentation on https://ccms-ucsd.github.io/GNPSDocumentation/featurebasedmolecularnetworking-with-openms">
    <ITEM name="version" value="3.5.0-pre-nuc-dia-2025-07-24" type="string" description="Version of the tool that generated this parameters file." required="false" advanced="true" />
    <NODE name="1" description="Instance &apos;1&apos; section for &apos;GNPSExport&apos;">
      <ITEM name="in_cm" value="" type="input-file" description="Input consensusXML file containing only consensusElements with &quot;peptide&quot; annotations." required="true" advanced="false" supported_formats="*.consensusXML" />
      <ITEMLIST name="in_mzml" type="input-file" description="Original mzml files containing the ms2 spectra (aka peptide annotation). #br#Must be in order that the consensusXML file maps the original mzML files." required="true" advanced="false" supported_formats="*.mzML" >
      </ITEMLIST>
      <ITEM name="out" value="" type="output-file" description="Output MGF file." required="true" advanced="false" supported_formats="*.mgf" />
      <ITEM name="out_quantification" value="" type="output-file" description="Output feature quantification table." required="true" advanced="false" supported_formats="*.txt" />
      <ITEM name="out_pairs" value="" type="output-file" description="Output supplementary pairs table for IIMN." required="false" advanced="false" supported_formats="*.csv" />
      <ITEM name="out_meta_values" value="" type="output-file" description="Output meta value file." required="false" advanced="false" supported_formats="*.tsv" />
      <ITEM name="output_type" value="most_intense" type="string" description="specificity of mgf output information" required="false" advanced="false" restrictions="merged_spectra,most_intense" />
      <ITEM name="peptide_cutoff" value="5" type="int" description="Number of most intense peptides to consider per consensus element; &apos;-1&apos; to consider all identifications." required="false" advanced="false" restrictions="-1:" />
      <ITEM name="ms2_bin_size" value="0.019999999552965" type="double" description="Bin size (Da) for fragment ions when merging ms2 scans." required="false" advanced="false" restrictions="0.000000:" />
      <ITEM name="log" value="" type="string" description="Name of log file (created only when specified)" required="false" advanced="true" />
      <ITEM name="debug" value="0" type="int" description="Sets the debug level" required="false" advanced="true" />
      <ITEM name="threads" value="1" type="int" description="Sets the number of threads allowed to be used by the TOPP tool" required="false" advanced="false" />
      <ITEM name="no_progress" value="false" type="bool" description="Disables progress logging to command line" required="false" advanced="true" />
      <ITEM name="force" value="false" type="bool" description="Overrides tool-specific checks" required="false" advanced="true" />
      <ITEM name="test" value="false" type="bool" description="Enables the test mode (needed for internal use only)" required="false" advanced="true" />
      <NODE name="merged_spectra" description="Options for exporting mgf file with merged spectra per consensusElement">
        <ITEM name="cos_similarity" value="0.9" type="double" description="Cosine similarity threshold for merged_spectra output." required="false" advanced="false" restrictions="0.000000:" />
      </NODE>
    </NODE>
  </NODE>
</PARAMETERS>
</tool>
