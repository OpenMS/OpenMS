# Checks the QPX psm view that ProSE writes with -qpx_extended, from a text dump of <stem>.psm.parquet (ParquetDiff
# -out_tsv) and, for the footer, the Parquet file itself. Usage:
#
#   cmake -DQPX=<dump of the QPX psm.parquet> -DMZML=<the searched mzML, uncompressed>
#         [-DMZ=<dump of the input's mz.parquet> [-DMZ_PARQUET=<the mz.parquet>]] [-DSHARED_ID=ON] [-DMERGED=ON] [-DPEAKS=ALL|FILTERED|OFF] [-DSOME_FEWER=ON] [-DCONVERTED=ON] [-DUNKNOWN_CHARGE=ON] [-DPREDICTIONS=ON|OFF]
#         [-DTWIN=<dump whose peaks must be the same>] [-DISOTOPE_TWIN=<dump whose isotope errors must be the same>]
#         [-DISOTOPE_VALUES=<the isotope errors allowed, comma-separated, e.g. 0,1>]
#         [-DROWS=<n>] [-DSUM_OF=<dumps, comma-separated, whose rows the dump has together>]
#         [-DPARQUET=<the psm.parquet>] [-DRUN=<dump of quantms.run.parquet> [-DFILES=<inputs, default 1>]
#          [-DFILE_INDEX=<position of the input, default 0>] [-DNCE=<expected NCE>] [-DLOG=<output of the run> -DNCE_SOURCE=<"from PeptDeep rescoring", "selected" or "set">]
#          [-DPEPTIDE=<peptidoform> -DCHARGE=<z> -DREFERENCE=<tsv: nce, ion, mz, intensity>
#           -DOUT_PREDICTED=<file> -DOUT_REFERENCE=<file>]]
#         -P check_prose_qpx_extended.cmake
#
# - The dump has the columns of -qpx_extended (spectrum_reference, isotope_error, protein_mappings and, unless MERGED,
#   predicted_ion_type_array, predicted_mz_array, predicted_intensity_array; with MERGED, quantms.psm.parquet, none of
#   these three; never peak columns); every row a spectrum_reference of a spectrum of the mzML (null only with
#   SHARED_ID), an integer isotope_error equal to the 'isotope_error' of its additional_scores, and (not MERGED) as many
#   peak intensities as peak m/z.
# - PEAKS ALL (default): every row has all peaks of its spectrum (defaultArrayLength). FILTERED: at most as many, and
#   for every m/z of the fragment annotation (mz_array) the peak at that m/z or, for a fragment that deisotoping moved
#   to its 1+ m/z, its monoisotopic peak at charge 2 or 3 (within 0.01 Th) among them (with SOME_FEWER ON, some row has
#   fewer than its spectrum; with CONVERTED ON, some annotated m/z is no peak and was found at charge 2 or 3; with
#   UNKNOWN_CHARGE ON, some annotated m/z of a PSM of charge 2 whose spectrum has no precursor charge (selected_ion_charge
#   null) was found at charge 3: the deisotoper's charge cap of a spectrum of unknown charge is 3, whatever its PSMs').
#   OFF: every peak column is null.
# - PREDICTIONS ON (default): every row of precursor charge 1 to 6 has a non-empty prediction, with as many ions as m/z
#   and intensities. OFF: every prediction column is null.
# - MZ (with PEAKS ALL or FILTERED): the mz view has one row per spectrum of the PSMs (a dump is sorted, so its order
#   is not checked), with the QPX columns; a PSM's peaks are those of the row whose id is its spectrum_reference, which
#   must be its own spectrum: the row's scan_start_time is the PSM's rt (within 50 ms), else the join gives another
#   spectrum of that native ID and the check fails.
# - SHARED_ID ON (requires MZ, also with MERGED: the input's mz view): some PSM has a null spectrum_reference, and every
#   such PSM is of the later spectrum of a shared native ID: the mz row of its run and scan is another spectrum's, of an
#   earlier scan_start_time than its rt (by more than 50 ms), and its native ID has several spectra in the mzML. Without
#   SHARED_ID, a null spectrum_reference fails.
# - TWIN: a dump of another mz view with the same rows (the same spectra read from another copy of the file).
#   ISOTOPE_TWIN: the isotope_error column equals that of ISOTOPE_TWIN, row by row, and some row has one other than 0.
#   ISOTOPE_VALUES: every isotope_error is one of these.
# - ROWS: the dump has exactly that many rows; 0 checks only the columns (and the footer). Without ROWS, at least one.
#   SUM_OF: as many rows as these dumps together (a merged file).
# - PARQUET: the footer has the 'prose_' keys of the prediction model (MERGED: no 'prose_' key); MZ_PARQUET those of
#   the peak filter.
#   RUN: the run view has FILES rows with the spec's columns and those of -qpx_extended and one LFQ sample each; with MERGED their psm_rows add up to the rows
#   of the dump. With PREDICTIONS, the input FILE_INDEX reports a number as the NCE (prediction_nce; equal to NCE if
#   given). With LOG, the run logged that NCE with its source NCE_SOURCE, and for "from PeptDeep rescoring" PeptDeep
#   rescoring logged the same NCE.
# - PEPTIDE: the predicted ions of the first row of that peptidoform and CHARGE go to OUT_PREDICTED, the rows of
#   REFERENCE of the reported NCE to OUT_REFERENCE, as "ion<TAB>m/z<TAB>intensity" lines, for FuzzyDiff.
cmake_policy(SET CMP0057 NEW) # if(... IN_LIST ...)
foreach(_required QPX MZML)
  if (NOT DEFINED ${_required})
    message(FATAL_ERROR "${_required} is required")
  endif()
endforeach()
if (NOT DEFINED PEAKS)
  set(PEAKS ALL)
endif()
if (NOT DEFINED PREDICTIONS)
  set(PREDICTIONS ON)
endif()
if (NOT DEFINED FILE_INDEX)
  set(FILE_INDEX 0)
endif()
if (NOT DEFINED FILES)
  set(FILES 1)
endif()
if (DEFINED ISOTOPE_VALUES)
  string(REPLACE "," ";" ISOTOPE_VALUES "${ISOTOPE_VALUES}")
endif()
if (MERGED)
  set(PEAKS OFF)
  set(PREDICTIONS OFF)
endif()

# Peak counts of the spectra, and the number of spectra, by native ID.
file(STRINGS "${MZML}" _spectra REGEX "<spectrum [^>]*defaultArrayLength=")
foreach(_s IN LISTS _spectra)
  if (_s MATCHES "id=\"([^\"]*)\"")
    set(_id "${CMAKE_MATCH_1}")
    if (_s MATCHES "defaultArrayLength=\"([0-9]+)\"")
      string(MAKE_C_IDENTIFIER "${_id}" _key)
      set(_peaks_${_key} "${CMAKE_MATCH_1}")
      # the spectra of that native ID
      if (DEFINED _copies_${_key})
        math(EXPR _copies_${_key} "${_copies_${_key}} + 1")
      else()
        set(_copies_${_key} 1)
      endif()
    endif()
  endif()
endforeach()

# A dump as a list of lines, with its header as a list of column names (brackets and semicolons would change how CMake
# splits lists, so the list brackets of the dump become '<' '>').
macro(read_dump file prefix)
  file(READ "${file}" _dump)
  string(REPLACE ";" "," _dump "${_dump}")
  string(REPLACE "[" "<" _dump "${_dump}")
  string(REPLACE "]" ">" _dump "${_dump}")
  string(REPLACE "\n" ";" ${prefix}_lines "${_dump}")
  list(FILTER ${prefix}_lines EXCLUDE REGEX "^$")
  list(POP_FRONT ${prefix}_lines ${prefix}_header)
  string(REPLACE "\t" ";" ${prefix}_header "${${prefix}_header}")
  list(LENGTH ${prefix}_lines ${prefix}_rows)
endmacro()
macro(column prefix name out)
  list(FIND ${prefix}_header "${name}" ${out})
  if (${out} EQUAL -1)
    message(FATAL_ERROR "no column '${name}' in the dump (${${prefix}_header})")
  endif()
endmacro()
# The values of a dumped list "<a, b, c>" as a CMake list, and their number; -1 for null.
function(list_items value items count)
  if (value STREQUAL "null")
    set(${items} "" PARENT_SCOPE)
    set(${count} -1 PARENT_SCOPE)
    return()
  endif()
  string(REGEX REPLACE "^<(.*)>$" "\\1" _inner "${value}")
  if (_inner STREQUAL "")
    set(${items} "" PARENT_SCOPE)
    set(${count} 0 PARENT_SCOPE)
    return()
  endif()
  string(REPLACE ", " ";" _items "${_inner}")
  list(LENGTH _items _n)
  set(${items} "${_items}" PARENT_SCOPE)
  set(${count} ${_n} PARENT_SCOPE)
endfunction()

read_dump("${QPX}" q)
column(q peptidoform _c_peptidoform)
column(q run_file_name _c_run)
column(q scan _c_scan)
column(q charge _c_charge)
column(q rt _c_rt)
column(q mz_array _c_annotated)
column(q spectrum_reference _c_ref)
column(q isotope_error _c_isotope)
column(q protein_mappings _c_mappings)
column(q additional_scores _c_scores)
# (the peaks are in the mz view, not in any psm file)
foreach(_name peak_mz_array peak_intensity_array)
  list(FIND q_header "${_name}" _at)
  if (NOT _at EQUAL -1)
    message(FATAL_ERROR "${QPX}: the column '${_name}' is in the psm file")
  endif()
endforeach()
set(_spectrum_columns predicted_ion_type_array predicted_mz_array predicted_intensity_array)
if (MERGED)
  foreach(_name IN LISTS _spectrum_columns)
    list(FIND q_header "${_name}" _at)
    if (NOT _at EQUAL -1)
      message(FATAL_ERROR "${QPX}: the column '${_name}' is in the merged file")
    endif()
  endforeach()
else()
  column(q predicted_ion_type_array _c_ions)
  column(q predicted_mz_array _c_mz)
  column(q predicted_intensity_array _c_intensity)
endif()
if (DEFINED ISOTOPE_TWIN)
  read_dump("${ISOTOPE_TWIN}" itwin)
  if (NOT q_rows EQUAL itwin_rows)
    message(FATAL_ERROR "${QPX}: ${q_rows} rows, the isotope twin ${ISOTOPE_TWIN} has ${itwin_rows}")
  endif()
endif()
# The mz view: its rows by id (and by run and scan); one row per spectrum of the PSMs, in the order of its first PSM
if (NOT DEFINED MZ AND (SHARED_ID OR (NOT MERGED AND NOT PEAKS STREQUAL "OFF")))
  message(FATAL_ERROR "MZ (the dump of the mz view) is required for the peaks and with SHARED_ID")
endif()
if (DEFINED MZ)
  read_dump("${MZ}" m)
  foreach(_name id run_file_name scan ms_level centroid scan_start_time inverse_ion_mobility ion_injection_time
          total_ion_current precursors mz intensity cv_params)
    column(m "${_name}" _c_m_${_name})
  endforeach()
  set(_m_ids)
  if (m_rows GREATER 0)
    math(EXPR _last_m "${m_rows} - 1")
    foreach(_k RANGE 0 ${_last_m})
      list(GET m_lines ${_k} _line)
      string(REPLACE "\t" ";" _cells "${_line}")
      list(GET _cells ${_c_m_id} _id)
      string(MAKE_C_IDENTIFIER "${_id}" _key)
      if (DEFINED _mz_row_${_key})
        message(FATAL_ERROR "${MZ}: the spectrum '${_id}' has two rows")
      endif()
      set(_mz_row_${_key} ${_k})
      list(APPEND _m_ids "${_key}")
      list(GET _cells ${_c_m_run_file_name} _run)
      list(GET _cells ${_c_m_scan} _scan)
      string(MAKE_C_IDENTIFIER "${_run}_${_scan}" _key)
      set(_mz_scan_row_${_key} ${_k})
      list(GET _cells ${_c_m_ms_level} _level)
      if (NOT _level STREQUAL "2")
        message(FATAL_ERROR "${MZ}: row ${_k}: ms_level ${_level}")
      endif()
    endforeach()
  endif()
endif()
if (NOT MERGED AND NOT PEAKS STREQUAL "OFF")
  # the spectra of the PSMs, each once (ParquetDiff's dumps are sorted: the order, that of each spectrum's first PSM,
  # is checked by the app's reader tests)
  set(_psm_ids)
  foreach(_line IN LISTS q_lines)
    string(REPLACE "\t" ";" _cells "${_line}")
    list(GET _cells ${_c_ref} _id)
    if (_id STREQUAL "null")
      continue() # (unresolved: no spectrum of its own in the mz view, checked below)
    endif()
    string(MAKE_C_IDENTIFIER "${_id}" _key)
    if (NOT "${_key}" IN_LIST _psm_ids)
      list(APPEND _psm_ids "${_key}")
    endif()
  endforeach()
  list(SORT _psm_ids)
  list(SORT _m_ids)
  if (NOT "${_psm_ids}" STREQUAL "${_m_ids}")
    message(FATAL_ERROR "${MZ}: the spectra are not those of the PSMs, each once")
  endif()
endif()
if (DEFINED TWIN)
  read_dump("${TWIN}" twin)
  if (NOT m_rows EQUAL twin_rows)
    message(FATAL_ERROR "${MZ}: ${m_rows} spectra, the twin ${TWIN} has ${twin_rows}")
  endif()
  foreach(_line _twin IN ZIP_LISTS m_lines twin_lines)
    string(REPLACE "\t" ";" _cells "${_line}")
    string(REPLACE "\t" ";" _twin_cells "${_twin}")
    foreach(_c id mz intensity)
      list(GET _cells ${_c_m_${_c}} _a)
      list(GET _twin_cells ${_c_m_${_c}} _b)
      if (NOT _a STREQUAL _b)
        message(FATAL_ERROR "${MZ}: other ${_c} than in ${TWIN}: ${_a}")
      endif()
    endforeach()
  endforeach()
endif()

# The footer: the 'prose_' keys of the spectrum columns of -qpx_extended (the peak filter, the prediction model) in a
# per-input file, none in the merged file (which has no such columns).
if (DEFINED PARQUET)
  file(STRINGS "${PARQUET}" _footer REGEX "prose_")
  if (MERGED)
    if (NOT _footer STREQUAL "")
      message(FATAL_ERROR "${PARQUET}: footer keys of spectrum columns in the merged file: ${_footer}")
    endif()
  else()
    foreach(_key prediction_ms2_model prediction_instrument)
      if (NOT _footer MATCHES "prose_${_key}")
        message(FATAL_ERROR "${PARQUET}: no footer key prose_${_key}")
      endif()
    endforeach()
  endif()
endif()
# the footer of the mz view: the peak filter
if (DEFINED MZ_PARQUET)
  file(STRINGS "${MZ_PARQUET}" _footer REGEX "prose_")
  foreach(_key peak_window peak_top peak_annotated)
    if (NOT _footer MATCHES "prose_${_key}")
      message(FATAL_ERROR "${MZ_PARQUET}: no footer key prose_${_key}")
    endif()
  endforeach()
endif()
# The run view: FILES rows; with MERGED their psm_rows add up to the rows of the dump; the NCE of input FILE_INDEX.
if (DEFINED RUN)
  read_dump("${RUN}" run)
  if (NOT run_rows EQUAL FILES)
    message(FATAL_ERROR "${RUN}: ${run_rows} runs, expected ${FILES}")
  endif()
  # (the spec's columns, also those ProSE leaves null: QPX's validator requires them; then ProSE's)
  foreach(_name run_accession run_file_name file_name samples fraction instrument enzymes dissociation_method
          acquisition_method additional_terms modification_parameters search_status
          ms2_spectra_count identified_spectra_count decoy_psm_count psm_rows rescoring_applied rescoring_skipped_reason
          rescoring_warning prediction_nce precursor_error_median_ppm fragment_tolerance_recommended_ppm search_seconds)
    column(run "${_name}" _c_run_${_name})
  endforeach()
  set(_psm_rows 0)
  math(EXPR _last_run "${run_rows} - 1")
  foreach(_k RANGE 0 ${_last_run})
    list(GET run_lines ${_k} _line)
    string(REPLACE "\t" ";" _cells "${_line}")
    list(GET _cells ${_c_run_psm_rows} _n)
    math(EXPR _psm_rows "${_psm_rows} + ${_n}")
    list(GET _cells ${_c_run_samples} _samples)
    if (NOT _samples MATCHES "^<{sample_accession:string = [^,]+, label:string = LFQ, ")
      message(FATAL_ERROR "${RUN}: run ${_k}: samples '${_samples}'")
    endif()
    if (_k EQUAL FILE_INDEX)
      list(GET _cells ${_c_run_prediction_nce} _nce)
    endif()
  endforeach()
  if (NOT MERGED)
    unset(_psm_rows)
  endif()
endif()

if (DEFINED SUM_OF)
  set(ROWS 0)
  string(REPLACE "," ";" SUM_OF "${SUM_OF}")
  foreach(_part IN LISTS SUM_OF)
    read_dump("${_part}" part)
    math(EXPR ROWS "${ROWS} + ${part_rows}")
  endforeach()
endif()
if (DEFINED _psm_rows AND NOT q_rows EQUAL _psm_rows)
  message(FATAL_ERROR "${QPX}: ${q_rows} rows, the run view says ${_psm_rows}")
endif()
if (DEFINED ROWS)
  if (NOT q_rows EQUAL ROWS)
    message(FATAL_ERROR "${QPX}: ${q_rows} rows, expected ${ROWS}")
  endif()
  if (ROWS EQUAL 0)
    message(STATUS "${QPX}: no rows, as expected")
    return()
  endif()
endif()

# A number of the dump (e.g. "-1", "120", "-0.016666668") as an integer in millionths (truncated)
function(to_micro value out)
  if (NOT value MATCHES "^(-?)([0-9]+)(\\.([0-9]*))?$")
    message(FATAL_ERROR "not a plain number: '${value}'")
  endif()
  set(_frac "${CMAKE_MATCH_4}000000")
  string(SUBSTRING "${_frac}" 0 6 _frac)
  math(EXPR _milli "${CMAKE_MATCH_2} * 1000000 + 1${_frac} - 1000000")
  if (CMAKE_MATCH_1 STREQUAL "-")
    math(EXPR _milli "0 - ${_milli}")
  endif()
  set(${out} ${_milli} PARENT_SCOPE)
endfunction()

# An m/z of the dump as an integer in 1e-4 Th (truncated)
function(to_units value out)
  if (NOT value MATCHES "^([0-9]+)(\\.([0-9]*))?$")
    message(FATAL_ERROR "not an m/z: '${value}'")
  endif()
  set(_frac "${CMAKE_MATCH_3}0000")
  string(SUBSTRING "${_frac}" 0 4 _frac)
  math(EXPR _units "${CMAKE_MATCH_1} * 10000 + 1${_frac} - 10000")
  set(${out} ${_units} PARENT_SCOPE)
endfunction()

set(_predicted_rows 0)
set(_fewer_rows 0)
set(_converted 0)
set(_nonzero_isotope OFF)
set(_found_peptide OFF)
set(_unresolved 0)
set(_converted_unknown_charge 0)
set(_cols ref peptidoform charge annotated isotope mappings scores rt run scan)
if (NOT MERGED)
  list(APPEND _cols ions mz intensity)
endif()
math(EXPR _last "${q_rows} - 1")
foreach(_row RANGE 0 ${_last})
  list(GET q_lines ${_row} _line)
  string(REPLACE "\t" ";" _cells "${_line}")
  foreach(_c IN LISTS _cols)
    list(GET _cells ${_c_${_c}} _${_c})
  endforeach()
  foreach(_c ions mz intensity)
    if (MERGED)
      set(_${_c} null)
    endif()
  endforeach()
  # unresolved: no spectrum_reference, as another spectrum of its native ID has the mz row of that native ID; the PSM is
  # of the later spectrum: the mz row of its run and scan is another spectrum's, of an earlier RT, of a shared native ID
  set(_unresolved_row OFF)
  if (_ref STREQUAL "null")
    if (NOT SHARED_ID)
      message(FATAL_ERROR "${QPX}: row ${_row} (${_peptidoform}): no spectrum_reference")
    endif()
    string(MAKE_C_IDENTIFIER "${_run}_${_scan}" _key)
    if (NOT DEFINED _mz_scan_row_${_key})
      message(FATAL_ERROR "${QPX}: row ${_row} (${_peptidoform}): no spectrum_reference, and the mz view has no row of its"
                          " scan ${_run} ${_scan}")
    endif()
    list(GET m_lines ${_mz_scan_row_${_key}} _mz_line)
    string(REPLACE "\t" ";" _mz_cells "${_mz_line}")
    list(GET _mz_cells ${_c_m_id} _id)
    list(GET _mz_cells ${_c_m_scan_start_time} _minutes)
    to_micro("${_minutes}" _start)
    math(EXPR _start "${_start} * 60")
    to_micro("${_rt}" _rt_micro)
    math(EXPR _rt_diff "${_rt_micro} - ${_start}")
    string(MAKE_C_IDENTIFIER "${_id}" _key)
    if (_rt_diff LESS_EQUAL 50000 OR NOT _copies_${_key} GREATER 1)
      message(FATAL_ERROR "${QPX}: row ${_row} (${_peptidoform}, rt ${_rt} s): no spectrum_reference, but it is not the PSM of"
                          " a later spectrum of a shared native ID: the mz row of its scan, '${_id}' (${_copies_${_key}}"
                          " spectra in ${MZML}), is at ${_minutes} min")
    endif()
    set(_unresolved_row ON)
    math(EXPR _unresolved "${_unresolved} + 1")
  endif()
  # the peaks: of the PSM's spectrum in the mz view, the row whose id is its spectrum_reference
  set(_peak_mz null)
  set(_peak_intensity null)
  set(_precursors "")
  if (NOT MERGED AND NOT PEAKS STREQUAL "OFF" AND NOT _unresolved_row)
    string(MAKE_C_IDENTIFIER "${_ref}" _key)
    if (NOT DEFINED _mz_row_${_key})
      message(FATAL_ERROR "${QPX}: row ${_row}: the mz view has no spectrum '${_ref}'")
    endif()
    list(GET m_lines ${_mz_row_${_key}} _mz_line)
    string(REPLACE "\t" ";" _mz_cells "${_mz_line}")
    list(GET _mz_cells ${_c_m_mz} _peak_mz)
    list(GET _mz_cells ${_c_m_intensity} _peak_intensity)
    list(GET _mz_cells ${_c_m_precursors} _precursors)
    # the join must give the PSM's own spectrum, not another one of that native ID (at another RT)
    list(GET _mz_cells ${_c_m_scan_start_time} _minutes)
    # (in microseconds: minutes * 60 against seconds, within 50 ms)
    to_micro("${_minutes}" _start)
    math(EXPR _start "${_start} * 60")
    to_micro("${_rt}" _rt_micro)
    math(EXPR _rt_diff "${_start} - ${_rt_micro}")
    if (_rt_diff GREATER 50000 OR _rt_diff LESS -50000)
      message(FATAL_ERROR "${QPX}: row ${_row} (${_peptidoform}, rt ${_rt} s): its spectrum_reference '${_ref}' joins to the"
                          " mz row of another spectrum (scan_start_time ${_minutes} min)")
    endif()
  endif()

  # the spectrum, the isotope error and the proteins
  string(MAKE_C_IDENTIFIER "${_ref}" _key)
  if (NOT _unresolved_row AND NOT DEFINED _peaks_${_key})
    message(FATAL_ERROR "${QPX}: row ${_row} (${_peptidoform}): no spectrum '${_ref}' in ${MZML}")
  endif()
  if (NOT _isotope MATCHES "^-?[0-9]+$")
    message(FATAL_ERROR "${QPX}: row ${_row} (${_peptidoform}): isotope_error '${_isotope}'")
  endif()
  if (NOT _isotope STREQUAL "0")
    set(_nonzero_isotope ON)
  endif()
  if (DEFINED ISOTOPE_VALUES AND NOT _isotope IN_LIST ISOTOPE_VALUES)
    message(FATAL_ERROR "${QPX}: row ${_row} (${_peptidoform}): isotope_error ${_isotope}, expected one of ${ISOTOPE_VALUES}")
  endif()
  if (_scores MATCHES "score_name:string = isotope_error, score_value:double = ([^,]*),")
    if (NOT CMAKE_MATCH_1 STREQUAL _isotope)
      message(FATAL_ERROR "${QPX}: row ${_row} (${_peptidoform}): isotope_error ${_isotope}, in additional_scores ${CMAKE_MATCH_1}")
    endif()
  endif()
  if (DEFINED ISOTOPE_TWIN)
    list(GET itwin_lines ${_row} _twin)
    string(REPLACE "\t" ";" _twin "${_twin}")
    list(GET _twin ${_c_isotope} _twin_isotope)
    if (NOT _twin_isotope STREQUAL _isotope)
      message(FATAL_ERROR "${QPX}: row ${_row} (${_peptidoform}): isotope_error ${_isotope}, in ${ISOTOPE_TWIN} ${_twin_isotope}")
    endif()
  endif()
  if (NOT _mappings MATCHES "^<{accession:string = [^,]+, start:int32 = [0-9]+, end:int32 = [0-9]+, aa_before:string = [A-Z-], aa_after:string = [A-Z-]}")
    message(FATAL_ERROR "${QPX}: row ${_row} (${_peptidoform}): protein_mappings '${_mappings}'")
  endif()

  # peaks
  list_items("${_peak_mz}" _peak_mz_items _n_mz)
  list_items("${_peak_intensity}" _unused _n_intensity)
  if (_unresolved_row)
    # (no spectrum of its own in the mz view, see above)
  elseif (PEAKS STREQUAL "OFF")
    if (NOT _n_mz EQUAL -1 OR NOT _n_intensity EQUAL -1)
      message(FATAL_ERROR "${QPX}: row ${_row} (${_peptidoform}): peaks, expected none")
    endif()
  else()
    if (NOT _n_mz EQUAL _n_intensity OR _n_mz LESS 1)
      message(FATAL_ERROR "${QPX}: row ${_row} (${_peptidoform}, ${_ref}): ${_n_mz} m/z and ${_n_intensity} intensities")
    endif()
    if (PEAKS STREQUAL "ALL" AND NOT _n_mz EQUAL _peaks_${_key})
      message(FATAL_ERROR "${QPX}: row ${_row} (${_peptidoform}, ${_ref}): ${_n_mz} peaks, but the spectrum has ${_peaks_${_key}}")
    endif()
    if (PEAKS STREQUAL "FILTERED")
      if (_n_mz GREATER _peaks_${_key})
        message(FATAL_ERROR "${QPX}: row ${_row} (${_peptidoform}, ${_ref}): ${_n_mz} peaks, more than the spectrum's ${_peaks_${_key}}")
      endif()
      if (_n_mz LESS _peaks_${_key})
        math(EXPR _fewer_rows "${_fewer_rows} + 1")
      endif()
      # the filter keeps the peak of every annotated fragment: at its m/z, or (deisotoped spectra) at charge 2 or 3
      list_items("${_annotated}" _annotated_items _n_annotated)
      set(_peak_units)
      foreach(_m IN LISTS _annotated_items)
        list(FIND _peak_mz_items "${_m}" _at)
        if (NOT _at EQUAL -1)
          continue()
        endif()
        if (NOT _peak_units)
          foreach(_p IN LISTS _peak_mz_items)
            to_units("${_p}" _u)
            list(APPEND _peak_units ${_u})
          endforeach()
        endif()
        to_units("${_m}" _mu)
        set(_found OFF)
        foreach(_z 2 3)
          math(EXPR _target "(${_mu} + (${_z} - 1) * 10073) / ${_z}")
          foreach(_u IN LISTS _peak_units)
            math(EXPR _d "${_u} - ${_target}")
            if (_d LESS_EQUAL 100 AND _d GREATER_EQUAL -100)
              set(_found ON)
              set(_found_z ${_z})
              break()
            endif()
          endforeach()
          if (_found)
            break()
          endif()
        endforeach()
        if (NOT _found)
          message(FATAL_ERROR "${QPX}: row ${_row} (${_peptidoform}): the annotated peak ${_m} is not among the peaks (at charge 1 to 3)")
        endif()
        math(EXPR _converted "${_converted} + 1")
        if (_found_z EQUAL 3 AND _charge EQUAL 2 AND _precursors MATCHES "selected_ion_charge:int32 = null")
          math(EXPR _converted_unknown_charge "${_converted_unknown_charge} + 1")
        endif()
      endforeach()
    endif()
  endif()

  # predictions
  list_items("${_ions}" _ion_items _n_ions)
  list_items("${_mz}" _mz_items _n_pred_mz)
  list_items("${_intensity}" _intensity_items _n_pred_intensity)
  if (PREDICTIONS)
    if (_charge GREATER_EQUAL 1 AND _charge LESS_EQUAL 6)
      if (_n_ions LESS 1 OR NOT _n_pred_mz EQUAL _n_ions OR NOT _n_pred_intensity EQUAL _n_ions)
        message(FATAL_ERROR "${QPX}: row ${_row} (${_peptidoform}, charge ${_charge}): ${_n_ions} predicted ions, "
                            "${_n_pred_mz} m/z, ${_n_pred_intensity} intensities")
      endif()
      math(EXPR _predicted_rows "${_predicted_rows} + 1")
    endif()
  elseif (NOT _n_ions EQUAL -1 OR NOT _n_pred_mz EQUAL -1 OR NOT _n_pred_intensity EQUAL -1)
    message(FATAL_ERROR "${QPX}: row ${_row} (${_peptidoform}): a prediction, expected none")
  endif()

  if (DEFINED PEPTIDE AND NOT _found_peptide AND _peptidoform STREQUAL PEPTIDE AND _charge EQUAL CHARGE)
    set(_found_peptide ON)
    set(_predicted "")
    foreach(_ion _m _i IN ZIP_LISTS _ion_items _mz_items _intensity_items)
      string(APPEND _predicted "${_ion}\t${_m}\t${_i}\n")
    endforeach()
    file(WRITE "${OUT_PREDICTED}" "${_predicted}")
  endif()
endforeach()

if (q_rows EQUAL 0)
  message(FATAL_ERROR "${QPX}: no rows")
endif()
if (PREDICTIONS AND _predicted_rows EQUAL 0)
  message(FATAL_ERROR "${QPX}: no row of charge 1 to 6")
endif()
if (PEAKS STREQUAL "FILTERED" AND SOME_FEWER AND _fewer_rows EQUAL 0)
  message(FATAL_ERROR "${QPX}: the filter kept every peak of every spectrum")
endif()
if (SHARED_ID AND _unresolved EQUAL 0)
  message(FATAL_ERROR "${QPX}: every PSM has a spectrum_reference; expected some unresolved (null) whose native ID has the mz row of another spectrum")
endif()
if (CONVERTED AND _converted EQUAL 0)
  message(FATAL_ERROR "${QPX}: every annotated m/z is a peak of the file: no fragment was moved by deisotoping")
endif()
if (UNKNOWN_CHARGE AND _converted_unknown_charge EQUAL 0)
  message(FATAL_ERROR "${QPX}: no annotated m/z of a 2+ PSM of a spectrum without precursor charge was found at charge 3")
endif()
if (DEFINED ISOTOPE_TWIN AND NOT _nonzero_isotope)
  message(FATAL_ERROR "${QPX}: every isotope_error is 0")
endif()

if (DEFINED RUN AND PREDICTIONS)
  if (NOT _nce MATCHES "^[0-9.]+$")
    message(FATAL_ERROR "${RUN}: the NCE of input ${FILE_INDEX} is '${_nce}'")
  endif()
  if (DEFINED NCE AND NOT _nce EQUAL NCE)
    message(FATAL_ERROR "${RUN}: the NCE of input ${FILE_INDEX} is ${_nce}, expected ${NCE}")
  endif()
  if (DEFINED LOG)
    file(READ "${LOG}" _log)
    string(FIND "${_log}" "at NCE ${_nce} (${NCE_SOURCE})" _at)
    if (_at EQUAL -1)
      message(FATAL_ERROR "${LOG}: no prediction 'at NCE ${_nce} (${NCE_SOURCE})'")
    endif()
    if (NCE_SOURCE STREQUAL "from PeptDeep rescoring")
      # the NCE PeptDeep rescoring logged when it added its features
      if (NOT _log MATCHES "Predicted features added: [^\n]*NCE=([0-9.]+)")
        message(FATAL_ERROR "${LOG}: PeptDeep rescoring logged no NCE")
      endif()
      if (NOT CMAKE_MATCH_1 EQUAL _nce)
        message(FATAL_ERROR "PeptDeep rescoring used NCE ${CMAKE_MATCH_1}, the footer reports ${_nce}")
      endif()
    endif()
  endif()
  if (DEFINED PEPTIDE)
    if (NOT _found_peptide)
      message(FATAL_ERROR "${QPX}: no row of ${PEPTIDE} with charge ${CHARGE}")
    endif()
    set(_reference "")
    file(STRINGS "${REFERENCE}" _reference_lines)
    foreach(_r IN LISTS _reference_lines)
      string(REPLACE "\t" ";" _r "${_r}")
      list(POP_FRONT _r _r_nce)
      if (_r_nce EQUAL _nce)
        string(REPLACE ";" "\t" _r "${_r}")
        string(APPEND _reference "${_r}\n")
      endif()
    endforeach()
    if (_reference STREQUAL "")
      message(FATAL_ERROR "${REFERENCE}: no prediction for NCE ${_nce}")
    endif()
    file(WRITE "${OUT_REFERENCE}" "${_reference}")
  endif()
endif()

message(STATUS "${QPX}: ${q_rows} rows, ${_predicted_rows} with a prediction, ${_fewer_rows} with filtered peaks, ${_converted} annotated peaks found at charge 2 or 3 (${_converted_unknown_charge} at 3 of 2+ PSMs of unknown precursor charge), ${_unresolved} unresolved")
