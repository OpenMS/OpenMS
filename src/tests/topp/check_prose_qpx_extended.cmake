# Checks a ProSE run with -out_qpx -qpx_extended end to end, on text dumps (ParquetDiff -out_tsv) of its QPX files and on
# their footers; the rules of the views (the peak filter and its charge cap, spectra of a shared native ID, the isotope
# error convention) are QPXDatasetExport_test's. Usage: cmake -DQPX=<dump> -DMZML=<mzML> [-D...] -P <this file>
# - QPX: a psm.parquet (MERGED=ON: quantms.psm.parquet, no predicted_* columns): rows, no peak columns; each row the
#   spectrum_reference of a spectrum of MZML (uncompressed), an integer isotope_error (that of additional_scores) and
#   protein_mappings. PARQUET (the file): the footer keys prose_prediction_* (MERGED: no prose_ key). SUM_OF=<dumps,...>:
#   their rows together. PREDICTIONS (default ON, OFF with MERGED): each row of charge 1 to 6 a prediction; OFF: none.
# - MZ (required unless MERGED): the input's mz view, one row per spectrum of the PSMs (ms_level 2, 1 to its spectrum's
#   peaks, as many intensities); MZ_PARQUET: footer keys prose_peak_*; TWIN: an mz view of the same rows.
# - RUN: quantms.run.parquet, FILES (1) runs with the spec's and ProSE's columns and one LFQ sample each (MERGED: their
#   psm_rows those of QPX); with PREDICTIONS the prediction_nce of input FILE_INDEX (0) a number (NCE if given), with LOG
#   (the run's output) logged as 'at NCE <nce> (<NCE_SOURCE>)'. PEPTIDE, CHARGE, REFERENCE (tsv: nce, ion, mz, intensity):
#   to OUT_PREDICTED the prediction of the first such row, to OUT_REFERENCE REFERENCE at the NCE (ion, m/z, intensity).
cmake_policy(SET CMP0057 NEW) # if(... IN_LIST ...)
foreach(_default QPX MZML PREDICTIONS=ON FILE_INDEX=0 FILES=1)
  string(REGEX MATCH "^([^=]+)(=(.*))?$" _ "${_default}")
  if (NOT DEFINED ${CMAKE_MATCH_1} AND NOT CMAKE_MATCH_2)
    message(FATAL_ERROR "${CMAKE_MATCH_1} is required")
  elseif (NOT DEFINED ${CMAKE_MATCH_1})
    set(${CMAKE_MATCH_1} ${CMAKE_MATCH_3})
  endif()
endforeach()
if (MERGED)
  set(PREDICTIONS OFF)
elseif (NOT DEFINED MZ)
  message(FATAL_ERROR "MZ (the dump of the input's mz view) is required")
endif()
# A dump as a list of lines and its header as a list of column names (its brackets become '<' '>', its ';' ',').
macro(read_dump file prefix)
  file(READ "${file}" _dump)
  string(REPLACE ";" "," _dump "${_dump}")
  string(REPLACE "[" "<" _dump "${_dump}")
  string(REPLACE "]" ">" _dump "${_dump}")
  string(REPLACE "\n" ";" ${prefix}_lines "${_dump}")
  list(FILTER ${prefix}_lines EXCLUDE REGEX "^$")
  list(POP_FRONT ${prefix}_lines ${prefix}_header)
  string(REPLACE "\t" ";" ${prefix}_header "${${prefix}_header}")
  list(LENGTH ${prefix}_lines ${prefix}_rows)
endmacro()
# columns(<prefix> <out> <name>...): the position of column <name> of a dump in <out><name>
macro(columns prefix out)
  foreach(_name ${ARGN})
    list(FIND ${prefix}_header "${_name}" ${out}${_name})
    if (${out}${_name} EQUAL -1)
      message(FATAL_ERROR "no column '${_name}' in the dump (${${prefix}_header})")
    endif()
  endforeach()
endmacro()
# The values of a dumped list "<a, b, c>" as a CMake list, and their number; -1 for null.
function(list_items value items count)
  string(REGEX REPLACE "^<(.*)>$" "\\1" _inner "${value}")
  string(REPLACE ", " ";" _items "${_inner}")
  list(LENGTH _items _n)
  if (value STREQUAL "null")
    set(_n -1)
  endif()
  set(${items} "${_items}" PARENT_SCOPE)
  set(${count} ${_n} PARENT_SCOPE)
endfunction()
# the peak counts of the spectra of the mzML, by native ID
file(STRINGS "${MZML}" _spectra REGEX "<spectrum [^>]*defaultArrayLength=")
foreach(_s IN LISTS _spectra)
  string(REGEX MATCH " id=\"([^\"]*)\".* defaultArrayLength=\"([0-9]+)\"" _ "${_s}")
  string(MAKE_C_IDENTIFIER "${CMAKE_MATCH_1}" _key)
  set(_peaks_${_key} "${CMAKE_MATCH_2}")
endforeach()
read_dump("${QPX}" q)
set(_cols peptidoform charge spectrum_reference isotope_error protein_mappings additional_scores)
set(_absent peak_mz_array peak_intensity_array) # (the peaks are in the mz view, not in any psm file)
set(_predictions predicted_ion_type_array predicted_mz_array predicted_intensity_array)
if (MERGED)
  list(APPEND _absent ${_predictions})
else()
  list(APPEND _cols ${_predictions})
endif()
columns(q _c_ ${_cols})
foreach(_name IN LISTS _absent)
  if ("${_name}" IN_LIST q_header)
    message(FATAL_ERROR "${QPX}: the column '${_name}' is in the file")
  endif()
endforeach()
# The mz view: its spectra (ids), each once, with their peaks; TWIN the same rows (ids and peaks)
macro(mz_rows file prefix)
  read_dump("${file}" ${prefix})
  columns(${prefix} _c_m_ id run_file_name scan ms_level centroid scan_start_time inverse_ion_mobility
          ion_injection_time total_ion_current precursors mz intensity cv_params)
  foreach(_line IN LISTS ${prefix}_lines)
    string(REPLACE "\t" ";" _cells "${_line}")
    foreach(_c id ms_level mz intensity)
      list(GET _cells ${_c_m_${_c}} _${_c})
    endforeach()
    string(MAKE_C_IDENTIFIER "${_id}" _key)
    list_items("${_mz}" _unused _n_mz)
    list_items("${_intensity}" _unused _n_intensity)
    if (NOT _ms_level STREQUAL "2" OR NOT _n_mz EQUAL _n_intensity OR _n_mz LESS 1 OR NOT _n_mz LESS_EQUAL _peaks_${_key})
      message(FATAL_ERROR "${file}: '${_id}': ms_level ${_ms_level}, ${_n_mz} m/z, ${_n_intensity} intensities")
    endif()
    list(APPEND ${prefix}_ids "${_key}")
    list(APPEND ${prefix}_peaks "${_id} ${_mz} ${_intensity}")
  endforeach()
endmacro()
if (DEFINED MZ)
  mz_rows("${MZ}" m)
endif()
if (DEFINED TWIN)
  mz_rows("${TWIN}" twin)
  if (NOT "${m_peaks}" STREQUAL "${twin_peaks}")
    message(FATAL_ERROR "${MZ}: other spectra or peaks than ${TWIN}")
  endif()
endif()
# The footers: the 'prose_' keys of the prediction model (none in the merged file) and of the peak filter
if (DEFINED PARQUET)
  file(STRINGS "${PARQUET}" _footer REGEX "prose_")
  if (MERGED AND NOT _footer STREQUAL "" OR NOT MERGED AND NOT (_footer MATCHES "prose_prediction_ms2_model" AND _footer MATCHES "prose_prediction_instrument"))
    message(FATAL_ERROR "${PARQUET}: not the footer keys prose_prediction_ms2_model, prose_prediction_instrument (MERGED: none)")
  endif()
endif()
if (DEFINED MZ_PARQUET)
  file(STRINGS "${MZ_PARQUET}" _footer REGEX "prose_")
  if (NOT (_footer MATCHES "prose_peak_window" AND _footer MATCHES "prose_peak_top" AND _footer MATCHES "prose_peak_annotated"))
    message(FATAL_ERROR "${MZ_PARQUET}: not the footer keys prose_peak_window, prose_peak_top, prose_peak_annotated")
  endif()
endif()

# The run view: FILES rows, with the spec's columns (also those ProSE leaves null: the QPX validator requires them)
# and ProSE's; with MERGED their psm_rows add up to the rows of QPX; the NCE of input FILE_INDEX.
if (DEFINED RUN)
  read_dump("${RUN}" run)
  columns(run _c_run_ run_accession run_file_name file_name samples fraction instrument enzymes dissociation_method acquisition_method
          additional_terms modification_parameters search_status ms2_spectra_count identified_spectra_count decoy_psm_count psm_rows
          rescoring_applied rescoring_skipped_reason rescoring_warning prediction_nce precursor_error_median_ppm
          fragment_tolerance_recommended_ppm search_seconds)
  set(_psm_rows 0)
  set(_k 0)
  foreach(_line IN LISTS run_lines)
    string(REPLACE "\t" ";" _cells "${_line}")
    list(GET _cells ${_c_run_psm_rows} _n)
    math(EXPR _psm_rows "${_psm_rows} + ${_n}")
    list(GET _cells ${_c_run_samples} _samples)
    if (NOT _samples MATCHES "^<{sample_accession:string = [^,]+, label:string = LFQ, ")
      message(FATAL_ERROR "${RUN}: run ${_k}: samples '${_samples}'")
    endif()
    if (_k EQUAL FILE_INDEX)
      list(GET _cells ${_c_run_prediction_nce} _nce)
    endif()
    math(EXPR _k "${_k} + 1")
  endforeach()
  if (NOT run_rows EQUAL FILES OR MERGED AND NOT q_rows EQUAL _psm_rows)
    message(FATAL_ERROR "${RUN}: ${run_rows} runs (expected ${FILES}) of ${_psm_rows} psm_rows (${QPX}: ${q_rows} rows)")
  endif()
endif()
if (DEFINED SUM_OF)
  set(_rows 0)
  string(REPLACE "," ";" SUM_OF "${SUM_OF}")
  foreach(_part IN LISTS SUM_OF)
    read_dump("${_part}" part)
    math(EXPR _rows "${_rows} + ${part_rows}")
  endforeach()
  if (NOT q_rows EQUAL _rows)
    message(FATAL_ERROR "${QPX}: ${q_rows} rows, expected ${_rows} (${SUM_OF})")
  endif()
endif()

# The rows: spectrum, isotope error, proteins, prediction
set(_psm_ids)
set(_predicted_rows 0)
set(_found_peptide OFF)
foreach(_line IN LISTS q_lines)
  string(REPLACE "\t" ";" _cells "${_line}")
  foreach(_name IN LISTS _predictions _cols)
    set(_${_name} null)
    if ("${_name}" IN_LIST _cols)
      list(GET _cells ${_c_${_name}} _${_name})
    endif()
  endforeach()
  set(_row "${QPX}: row of ${_peptidoform} (${_charge}+, ${_spectrum_reference})")
  string(MAKE_C_IDENTIFIER "${_spectrum_reference}" _key)
  list(APPEND _psm_ids "${_key}")
  if (NOT DEFINED _peaks_${_key})
    message(FATAL_ERROR "${_row}: no such spectrum in ${MZML}")
  endif()
  if (NOT _isotope_error MATCHES "^-?[0-9]+$" OR (_additional_scores MATCHES "score_name:string = isotope_error, score_value:double = ([^,]*),"
                                                   AND NOT CMAKE_MATCH_1 STREQUAL _isotope_error))
    message(FATAL_ERROR "${_row}: isotope_error '${_isotope_error}', in additional_scores ${CMAKE_MATCH_1}")
  endif()
  if (NOT _protein_mappings MATCHES "^<{accession:string = [^,]+, start:int32 = [0-9]+, end:int32 = [0-9]+, aa_before:string = [A-Z-], aa_after:string = [A-Z-]}")
    message(FATAL_ERROR "${_row}: protein_mappings '${_protein_mappings}'")
  endif()
  list_items("${_predicted_ion_type_array}" _ion_items _n_ions)
  list_items("${_predicted_mz_array}" _mz_items _n_pred_mz)
  list_items("${_predicted_intensity_array}" _intensity_items _n_pred_intensity)
  if (NOT PREDICTIONS AND NOT "${_n_ions}${_n_pred_mz}${_n_pred_intensity}" STREQUAL "-1-1-1")
    message(FATAL_ERROR "${_row}: a prediction, expected none")
  elseif (PREDICTIONS AND _charge GREATER_EQUAL 1 AND _charge LESS_EQUAL 6)
    if (_n_ions LESS 1 OR NOT _n_pred_mz EQUAL _n_ions OR NOT _n_pred_intensity EQUAL _n_ions)
      message(FATAL_ERROR "${_row}: ${_n_ions} predicted ions, ${_n_pred_mz} m/z, ${_n_pred_intensity} intensities")
    endif()
    math(EXPR _predicted_rows "${_predicted_rows} + 1")
  endif()
  if (DEFINED PEPTIDE AND NOT _found_peptide AND _peptidoform STREQUAL PEPTIDE AND _charge EQUAL CHARGE)
    set(_found_peptide ON)
    set(_predicted "")
    foreach(_ion _m _i IN ZIP_LISTS _ion_items _mz_items _intensity_items)
      string(APPEND _predicted "${_ion}\t${_m}\t${_i}\n")
    endforeach()
    file(WRITE "${OUT_PREDICTED}" "${_predicted}")
  endif()
endforeach()
if (q_rows EQUAL 0 OR PREDICTIONS AND _predicted_rows EQUAL 0)
  message(FATAL_ERROR "${QPX}: no rows, or no row of charge 1 to 6")
endif()
# the spectra of the mz view: those of the PSMs, each once
list(REMOVE_DUPLICATES _psm_ids)
list(SORT _psm_ids)
list(SORT m_ids)
if (DEFINED MZ AND NOT "${_psm_ids}" STREQUAL "${m_ids}")
  message(FATAL_ERROR "${MZ}: the spectra are not those of the PSMs, each once")
endif()

# The NCE of the predictions: reported, logged with its source, and the reference predictions at it
if (DEFINED RUN AND PREDICTIONS)
  if (NOT _nce MATCHES "^[0-9.]+$" OR (DEFINED NCE AND NOT _nce EQUAL NCE))
    message(FATAL_ERROR "${RUN}: the NCE of input ${FILE_INDEX} is '${_nce}' (expected: ${NCE})")
  endif()
  if (DEFINED LOG)
    file(READ "${LOG}" _log)
    string(FIND "${_log}" "at NCE ${_nce} (${NCE_SOURCE})" _at)
    if (_at EQUAL -1)
      message(FATAL_ERROR "${LOG}: no prediction 'at NCE ${_nce} (${NCE_SOURCE})'")
    endif()
  endif()
  if (DEFINED PEPTIDE)
    if (NOT _found_peptide)
      message(FATAL_ERROR "${QPX}: no row of ${PEPTIDE} with charge ${CHARGE}")
    endif()
    set(_reference "")
    file(STRINGS "${REFERENCE}" _reference_lines)
    foreach(_r IN LISTS _reference_lines)
      if (_r MATCHES "^([^\t]+)\t(.*)$" AND CMAKE_MATCH_1 EQUAL _nce)
        string(APPEND _reference "${CMAKE_MATCH_2}\n")
      endif()
    endforeach()
    if (_reference STREQUAL "")
      message(FATAL_ERROR "${REFERENCE}: no prediction for NCE ${_nce}")
    endif()
    file(WRITE "${OUT_REFERENCE}" "${_reference}")
  endif()
endif()
message(STATUS "${QPX}: ${q_rows} rows, ${_predicted_rows} with a prediction")
