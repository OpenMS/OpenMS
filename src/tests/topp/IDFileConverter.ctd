<?xml version="1.0" encoding="UTF-8"?>
<tool ctdVersion="1.8" version="3.5.0-pre-nuc-dia-2025-07-24" name="IDFileConverter" docurl="http://www.openms.de/doxygen/nightly/html/TOPP_IDFileConverter.html" category="File Converter" >
<description><![CDATA[Converts identification engine file formats.]]></description>
<manual><![CDATA[Converts identification engine file formats.]]></manual>
<citations>
  <citation doi="10.1038/s41592-024-02197-7" url="" />
</citations>
<PARAMETERS version="1.8.0" xsi:noNamespaceSchemaLocation="https://raw.githubusercontent.com/OpenMS/OpenMS/develop/share/OpenMS/SCHEMAS/Param_1_8_0.xsd" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <NODE name="IDFileConverter" description="Converts identification engine file formats.">
    <ITEM name="version" value="3.5.0-pre-nuc-dia-2025-07-24" type="string" description="Version of the tool that generated this parameters file." required="false" advanced="true" />
    <NODE name="1" description="Instance &apos;1&apos; section for &apos;IDFileConverter&apos;">
      <ITEM name="in" value="" type="input-file" description="Input file or directory containing the data to convert. This may be:#br#- a single file in OpenMS database format (.oms),#br#- a single file in a multi-purpose XML format (.idXML, .mzid, .pepXML, .protXML),#br#- a single file in a search engine-specific format (Mascot: .mascotXML, OMSSA: .omssaXML, X! Tandem: .xml, Percolator: .psms, xQuest: .xquest.xml),#br#- a single file in fasta format (can only be used to generate a theoretical mzML),#br#- a single text file (tab separated) with one line for all peptide sequences matching a spectrum (top N hits),#br#- for Sequest results, a directory containing .out files.#br#" required="true" advanced="false" supported_formats="*.oms,*.idXML,*.mzid,*.fasta,*.pepXML,*.protXML,*.mascotXML,*.omssaXML,*.xml,*.psms,*.tsv,*.xquest.xml" />
      <ITEM name="out" value="" type="output-file" description="Output file" required="true" advanced="false" supported_formats="*.oms,*.idXML,*.mzid,*.pepXML,*.fasta,*.xquest.xml,*.mzML" />
      <ITEM name="out_type" value="" type="string" description="Output file type (default: determined from file extension)" required="false" advanced="false" restrictions="oms,idXML,mzid,pepXML,fasta,xquest.xml,mzML" />
      <ITEM name="mz_file" value="" type="input-file" description="[pepXML, Sequest, Mascot, X! Tandem, mzid, Percolator only] Retention times and native spectrum ids (spectrum_references) will be looked up in this file" required="false" advanced="false" supported_formats="*.mzML,*.mzXML,*.mzData" />
      <ITEM name="mz_name" value="" type="string" description="[pepXML only] Experiment filename/path (extension will be removed) to match in the pepXML file (&apos;base_name&apos; attribute). Only necessary if different from &apos;mz_file&apos;." required="false" advanced="false" />
      <ITEM name="peptideprophet_analyzed" value="false" type="bool" description="[pepXML output only] Write output in the format of a PeptideProphet analysis result. By default a &apos;raw&apos; pepXML is produced that contains only search engine results." required="false" advanced="false" />
      <ITEM name="score_type" value="qvalue" type="string" description="[Percolator only] Which of the Percolator scores to report as &apos;the&apos; score for a peptide hit" required="false" advanced="false" restrictions="qvalue,PEP,score" />
      <ITEM name="ignore_proteins_per_peptide" value="false" type="bool" description="[Sequest only] Workaround to deal with .out files that contain e.g. &quot;+1&quot; in references column,#br#but do not list extra references in subsequent lines (try -debug 3 or 4)" required="false" advanced="true" />
      <ITEM name="scan_regex" value="" type="string" description="[Mascot, pepXML, Percolator only] Regular expression used to extract the scan number or retention time. See documentation for details." required="false" advanced="true" />
      <ITEM name="no_spectra_data_override" value="false" type="bool" description="[+mz_file only] Avoid overriding &apos;spectra_data&apos; in protein identifications if &apos;mz_file&apos; is given and &apos;spectrum_reference&apos;s are added/updated. Use only if you are sure it is absolutely the same &apos;mz_file&apos; as used for identification." required="false" advanced="true" />
      <ITEM name="no_spectra_references_override" value="false" type="bool" description="[+mz_file only] Avoid overriding &apos;spectrum_reference&apos; in peptide identifications if &apos;mz_file&apos; is given and a &apos;spectrum_reference&apos; is already present." required="false" advanced="true" />
      <ITEM name="add_ionmatch_annotation" value="0.0" type="double" description="[+mz_file only] Annotate the identifications with ion matches from spectra in &apos;mz_file&apos; using the given tolerance (in Da). This will take quite some time." required="false" advanced="true" />
      <ITEM name="concatenate_peptides" value="false" type="bool" description="[FASTA output only] Will concatenate the top peptide hits to one peptide sequence, rather than write a new peptide for each hit." required="false" advanced="true" />
      <ITEM name="number_of_hits" value="1" type="int" description="[FASTA output only] Controls how many peptide hits will be exported. A value of 0 or less exports all hits." required="false" advanced="true" />
      <ITEM name="log" value="" type="string" description="Name of log file (created only when specified)" required="false" advanced="true" />
      <ITEM name="debug" value="0" type="int" description="Sets the debug level" required="false" advanced="true" />
      <ITEM name="threads" value="1" type="int" description="Sets the number of threads allowed to be used by the TOPP tool" required="false" advanced="false" />
      <ITEM name="no_progress" value="false" type="bool" description="Disables progress logging to command line" required="false" advanced="true" />
      <ITEM name="force" value="false" type="bool" description="Overrides tool-specific checks" required="false" advanced="true" />
      <ITEM name="test" value="false" type="bool" description="Enables the test mode (needed for internal use only)" required="false" advanced="true" />
      <NODE name="fasta_to_mzml" description="[FASTA input + MzML output only] Parameters used to adjust simulation of the theoretical spectra.">
        <ITEM name="isotope_model" value="none" type="string" description="Model to use for isotopic peaks (&apos;none&apos; means no isotopic peaks are added, &apos;coarse&apos; adds isotopic peaks in unit mass distance, &apos;fine&apos; uses the hyperfine isotopic generator to add accurate isotopic peaks. Note that adding isotopic peaks is very slow." required="false" advanced="false" restrictions="none,coarse,fine" />
        <ITEM name="max_isotope" value="2" type="int" description="Defines the maximal isotopic peak which is added if &apos;isotope_model&apos; is &apos;coarse&apos;" required="false" advanced="false" />
        <ITEM name="max_isotope_probability" value="0.05" type="double" description="Defines the maximal isotopic probability to cover if &apos;isotope_model&apos; is &apos;fine&apos;" required="false" advanced="false" />
        <ITEM name="add_metainfo" value="false" type="bool" description="Adds the type of peaks as metainfo to the peaks, like y8+, [M-H2O+2H]++" required="false" advanced="false" />
        <ITEM name="add_losses" value="false" type="bool" description="Adds common losses to those ion expect to have them, only water and ammonia loss is considered" required="false" advanced="false" />
        <ITEM name="add_term_losses" value="false" type="bool" description="Adds common N- and C-term losses (only if add_losses=true and isotope_model=none), only water and ammonia loss is considered." required="false" advanced="false" />
        <ITEM name="add_internal_fragments" value="false" type="bool" description="Add b and a type fragments from internal cleavage events." required="false" advanced="false" />
        <ITEM name="sort_by_position" value="true" type="string" description="Sort output by position" required="false" advanced="false" restrictions="true,false" />
        <ITEM name="add_precursor_peaks" value="false" type="bool" description="Adds peaks of the unfragmented precursor ion to the spectrum" required="false" advanced="false" />
        <ITEM name="add_all_precursor_charges" value="false" type="bool" description="Adds precursor peaks with all charges in the given range" required="false" advanced="false" />
        <ITEM name="add_abundant_immonium_ions" value="false" type="bool" description="Add most abundant immonium ions (for Proline, Cystein, Iso/Leucine, Histidin, Phenylalanin, Tyrosine, Tryptophan)" required="false" advanced="false" />
        <ITEM name="add_first_prefix_ion" value="false" type="bool" description="If set to true e.g. b1 ions are added" required="false" advanced="false" />
        <ITEM name="add_y_ions" value="true" type="string" description="Add peaks of y-ions to the spectrum" required="false" advanced="false" restrictions="true,false" />
        <ITEM name="add_b_ions" value="true" type="string" description="Add peaks of b-ions to the spectrum" required="false" advanced="false" restrictions="true,false" />
        <ITEM name="add_a_ions" value="false" type="bool" description="Add peaks of a-ions to the spectrum" required="false" advanced="false" />
        <ITEM name="add_c_ions" value="false" type="bool" description="Add peaks of c-ions to the spectrum" required="false" advanced="false" />
        <ITEM name="add_x_ions" value="false" type="bool" description="Add peaks of  x-ions to the spectrum" required="false" advanced="false" />
        <ITEM name="add_z_ions" value="false" type="bool" description="Add peaks of z-ions to the spectrum (sometimes observed in CID and for some AAs in ExD due to H abstraction)" required="false" advanced="false" />
        <ITEM name="add_zp1_ions" value="false" type="bool" description="Add peaks of z+1-radical cations (also [z+H]*^{+} or simply z*) to the spectrum (often observed in ExD)" required="false" advanced="false" />
        <ITEM name="add_zp2_ions" value="false" type="bool" description="Add peaks of z+2-radical cations (also [z+2H]*^{2+} or simply z&apos;) to the spectrum (often observed in ExD esp. with higher precursor charges &gt;3 and smaller z-ions.)" required="false" advanced="false" />
        <ITEM name="y_intensity" value="1.0" type="double" description="Intensity of the y-ions" required="false" advanced="false" restrictions="0.000000:" />
        <ITEM name="b_intensity" value="1.0" type="double" description="Intensity of the b-ions" required="false" advanced="false" restrictions="0.000000:" />
        <ITEM name="a_intensity" value="1.0" type="double" description="Intensity of the a-ions" required="false" advanced="false" restrictions="0.000000:" />
        <ITEM name="c_intensity" value="1.0" type="double" description="Intensity of the c-ions" required="false" advanced="false" restrictions="0.000000:" />
        <ITEM name="x_intensity" value="1.0" type="double" description="Intensity of the x-ions" required="false" advanced="false" restrictions="0.000000:" />
        <ITEM name="z_intensity" value="1.0" type="double" description="Intensity of the z-ions" required="false" advanced="false" restrictions="0.000000:" />
        <ITEM name="relative_loss_intensity" value="0.1" type="double" description="Intensity of loss ions, in relation to the intact ion intensity" required="false" advanced="false" restrictions="0.000000:1.000000" />
        <ITEM name="precursor_intensity" value="1.0" type="double" description="Intensity of the precursor peak" required="false" advanced="false" restrictions="0.000000:" />
        <ITEM name="precursor_H2O_intensity" value="1.0" type="double" description="Intensity of the H2O loss peak of the precursor" required="false" advanced="false" restrictions="0.000000:" />
        <ITEM name="precursor_NH3_intensity" value="1.0" type="double" description="Intensity of the NH3 loss peak of the precursor" required="false" advanced="false" restrictions="0.000000:" />
        <ITEM name="enzyme" value="Trypsin" type="string" description="Enzym used to digest the fasta proteins" required="false" advanced="false" restrictions="Chymotrypsin,Chymotrypsin/P,CNBr,Formic_acid,Asp-N,Asp-N/B,Asp-N_ambic,Trypsin,2-iodobenzoate,iodosobenzoate,staphylococcal protease/D,Arg-C,Arg-C/P,elastase-trypsin-chymotrypsin,no cleavage,unspecific cleavage,Lys-C,Lys-N,Lys-C/P,PepsinA,TrypChymo,Trypsin/P,V8-DE,V8-E,leukocyte elastase,proline endopeptidase,glutamyl endopeptidase,Alpha-lytic protease,proline-endopeptidase/HKR,Glu-C+P,PepsinA + P,cyanogen-bromide,Clostripain/P" />
        <ITEM name="missed_cleavages" value="0" type="int" description="Number of allowed missed cleavages while digesting the fasta proteins" required="false" advanced="false" />
        <ITEM name="min_charge" value="1" type="int" description="Minimum charge" required="false" advanced="false" />
        <ITEM name="max_charge" value="1" type="int" description="Maximum charge" required="false" advanced="false" />
        <ITEM name="precursor_charge" value="0" type="int" description="Manually set precursor charge. (default: 0, meaning max_charge + 1 will be used as precursor charge)" required="false" advanced="false" />
      </NODE>
    </NODE>
  </NODE>
</PARAMETERS>
</tool>
