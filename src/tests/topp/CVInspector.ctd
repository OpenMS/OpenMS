<?xml version="1.0" encoding="UTF-8"?>
<tool ctdVersion="1.8" version="3.5.0-pre-nuc-dia-2025-07-24" name="CVInspector" docurl="http://www.openms.de/doxygen/nightly/html/TOPP_CVInspector.html" category="[for Developers]" >
<description><![CDATA[Visualize and validate PSI mapping and CV files.]]></description>
<manual><![CDATA[Visualize and validate PSI mapping and CV files.]]></manual>
<citations>
  <citation doi="10.1038/s41592-024-02197-7" url="" />
</citations>
<PARAMETERS version="1.8.0" xsi:noNamespaceSchemaLocation="https://raw.githubusercontent.com/OpenMS/OpenMS/develop/share/OpenMS/SCHEMAS/Param_1_8_0.xsd" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <NODE name="CVInspector" description="Visualize and validate PSI mapping and CV files.">
    <ITEM name="version" value="3.5.0-pre-nuc-dia-2025-07-24" type="string" description="Version of the tool that generated this parameters file." required="false" advanced="true" />
    <NODE name="1" description="Instance &apos;1&apos; section for &apos;CVInspector&apos;">
      <ITEMLIST name="cv_files" type="input-file" description="List of ontology files in OBO format." required="true" advanced="false" supported_formats="*.obo" >
      </ITEMLIST>
      <ITEMLIST name="cv_names" type="string" description="List of identifiers (one for each ontology file)." required="true" advanced="false" >
      </ITEMLIST>
      <ITEM name="mapping_file" value="" type="input-file" description="Mapping file in CVMapping (XML) format." required="true" advanced="false" supported_formats="*.XML" />
      <ITEMLIST name="ignore_cv" type="string" description="A list of CV identifiers which should be ignored." required="false" advanced="false" >
        <LISTITEM value="UO"/>
        <LISTITEM value="PATO"/>
        <LISTITEM value="BTO"/>
      </ITEMLIST>
      <ITEM name="html" value="" type="output-file" description="Writes an HTML version of the mapping file with annotated CV terms" required="false" advanced="false" supported_formats="*.HTML" />
      <ITEM name="log" value="" type="string" description="Name of log file (created only when specified)" required="false" advanced="true" />
      <ITEM name="debug" value="0" type="int" description="Sets the debug level" required="false" advanced="true" />
      <ITEM name="threads" value="1" type="int" description="Sets the number of threads allowed to be used by the TOPP tool" required="false" advanced="false" />
      <ITEM name="no_progress" value="false" type="bool" description="Disables progress logging to command line" required="false" advanced="true" />
      <ITEM name="force" value="false" type="bool" description="Overrides tool-specific checks" required="false" advanced="true" />
      <ITEM name="test" value="false" type="bool" description="Enables the test mode (needed for internal use only)" required="false" advanced="true" />
    </NODE>
  </NODE>
</PARAMETERS>
</tool>
