<msms_pipeline_analysis date="2015-01-06T13:43:06" summary_xml="c:/tpp/data/interact.pep.xml" xmlns="http://regis-web.systemsbiology.net/pepXML" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://regis-web.systemsbiology.net/pepXML http://localhost/pepXML_v117.xsd">
<!-- Experiment name matching in PepXMLFile::load: runs with 'base_name's as written by the TPP on Windows ('/' as separator),
     two equally named spectra files in different folders ('light/run1', 'heavy/run1') and one whose name ends the same ('prerun1') -->
<msms_run_summary base_name="c:/tpp/data/light/run1" search_engine="X! Tandem" raw_data_type="raw" raw_data=".mzML">
<sample_enzyme name="trypsin">
<specificity cut="KR" no_cut="P" sense="C"/>
</sample_enzyme>
<search_summary base_name="c:/tpp/data/light/run1" search_engine="X! Tandem" precursor_mass_type="monoisotopic" fragment_mass_type="monoisotopic" search_id="1">
<search_database local_path="c:/tpp/data/db.fasta" type="AA"/>
<enzymatic_search_constraint enzyme="trypsin" max_num_internal_cleavages="1" min_number_termini="2"/>
</search_summary>
<spectrum_query spectrum="run1.00100.00100.2" start_scan="100" end_scan="100" precursor_neutral_mass="926.4549" assumed_charge="2" index="1" retention_time_sec="100">
<search_result>
<search_hit hit_rank="1" peptide="PEPTIDEK" peptide_prev_aa="K" peptide_next_aa="A" protein="LIGHT_RUN1" num_tot_proteins="1" calc_neutral_pep_mass="926.4549" massdiff="0.000" num_tol_term="2" num_missed_cleavages="0">
<search_score name="expect" value="0.01"/>
</search_hit>
</search_result>
</spectrum_query>
</msms_run_summary>
