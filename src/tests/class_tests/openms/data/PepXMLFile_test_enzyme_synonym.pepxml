<msms_pipeline_analysis date="2026-10-14T12:00:00" summary_xml="enzyme_synonym.pep.xml" xmlns="http://regis-web.systemsbiology.net/pepXML" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://regis-web.systemsbiology.net/pepXML http://localhost/pepXML_v117.xsd">
<!-- Enzyme given by a ProteaseDB synonym with uppercase letters ('Glu-C' for 'glutamyl endopeptidase'), see issue #10571 -->
<msms_run_summary base_name="enzyme_synonym" search_engine="X! Tandem" raw_data_type="raw" raw_data=".mzML">
<sample_enzyme name="Glu-C">
<specificity cut="E" no_cut="P" sense="C"/>
</sample_enzyme>
<search_summary base_name="enzyme_synonym" search_engine="X! Tandem" precursor_mass_type="monoisotopic" fragment_mass_type="monoisotopic" search_id="1">
<search_database local_path="db.fasta" type="AA"/>
<enzymatic_search_constraint enzyme="Glu-C" max_num_internal_cleavages="1" min_number_termini="2"/>
</search_summary>
<spectrum_query spectrum="enzyme_synonym.00100.00100.2" start_scan="100" end_scan="100" precursor_neutral_mass="799.3600" assumed_charge="2" index="1" retention_time_sec="100">
<search_result>
<search_hit hit_rank="1" peptide="PEPTIDE" peptide_prev_aa="E" peptide_next_aa="A" protein="PROT1" num_tot_proteins="1" calc_neutral_pep_mass="799.3600" massdiff="0.000" num_tol_term="2" num_missed_cleavages="0">
<search_score name="expect" value="0.01"/>
</search_hit>
</search_result>
</spectrum_query>
</msms_run_summary>
</msms_pipeline_analysis>
