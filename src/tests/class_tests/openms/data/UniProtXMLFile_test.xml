<?xml version="1.0" encoding="UTF-8"?>
<!-- Minimal UniProtKB XML fixture for UniProtXMLFile_test. Exercises the
     parser's main code paths: entry metadata, AltAC, gene primary vs. synonym,
     organism scientific name + NCBI taxonomy, proteinExistence, canonical
     sequence vs. isoform (length attribute discrimination), every routed
     feature type (modified residue, disulfide bond, sequence variant simple
     and range, signal peptide, splice variant with id), and the isoform
     definitions inside the alternative-products comment (first id / first name
     capture, displayed vs. described vs. external sequence types, multi-VSP
     refs). -->
<uniprot>
  <entry dataset="Swiss-Prot" version="42">
    <accession>P00001</accession>
    <accession>P99999</accession>
    <name>TEST1_HUMAN</name>
    <protein>
      <recommendedName>
        <fullName>Test protein one</fullName>
      </recommendedName>
    </protein>
    <gene>
      <name type="synonym">SYNGENE</name>
      <name type="primary">PRIMGENE</name>
    </gene>
    <organism>
      <name type="common">Human</name>
      <name type="scientific">Homo sapiens</name>
      <dbReference type="NCBI Taxonomy" id="9606"/>
    </organism>
    <proteinExistence type="evidence at protein level"/>
    <comment type="alternative products">
      <event type="alternative splicing"/>
      <isoform>
        <id>P00001-1</id>
        <name>1</name>
        <sequence type="displayed"/>
      </isoform>
      <isoform>
        <id>P00001-2</id>
        <id>P00001-4</id>
        <name>2</name>
        <name>Short</name>
        <sequence type="described" ref="VSP_001 VSP_002"/>
