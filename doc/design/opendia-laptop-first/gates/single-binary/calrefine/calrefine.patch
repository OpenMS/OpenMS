+  void CalibrationCollector::finishRefined_(CalibrationResult& result, const std::function<double(double)>& centre_of,
+                                            std::size_t half_window, CalibrationDiagnostics* diagnostics,
+                                            double support_low, double support_high) const
+  {
+    // Stages 3-4 around the given centre; throws like finish_ if too few anchors.
+    const CalibrationResult before = result;
+    finish_(result, centre_of, half_window, diagnostics, support_low, support_high);
+    // Once more around the final map (PLAN_CALREFINE): the stage-4 RT spread fit takes target residuals to the final
+    // map and its background in window coordinates, which agree only when the window is centred on that map. Same
+    // traces, half window, support and rules. If the second pass finds too few anchors, the first result stands.
+    const RTMap first_map = result.rt_map;
+    CalibrationResult refined = before;
+    try
+    {
+      finish_(refined, [&first_map](double library_rt) { return first_map(library_rt); }, half_window, diagnostics, support_low, support_high);
+    }
+    catch (const std::runtime_error&)
+    {
+      return;
+    }
+    refined.refined_on_final_map = true;
+    result = std::move(refined);
+  }
