diff --git a/src/topp/OpenDIA/source/OpenDIAGBM.cpp b/src/topp/OpenDIA/source/OpenDIAGBM.cpp
index 12d05eae94..42a63124b7 100644
--- a/src/topp/OpenDIA/source/OpenDIAGBM.cpp
+++ b/src/topp/OpenDIA/source/OpenDIAGBM.cpp
@@ -677,4 +677,93 @@ namespace OpenMS::OpenDIA
     for (std::size_t i = 0; i < comp.ranked.size(); ++i) res.q_value[comp.ranked[i]] = comp.q[i];
     return res;
