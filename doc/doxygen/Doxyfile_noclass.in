@INCLUDE = doxygen/Doxyfile

GENERATE_TODOLIST      = YES

# no tag file: OpenMS.tag (installed for projects that link to the class documentation)
# is written only by the full documentation
GENERATE_TAGFILE       =

# issue all possible warnings
QUIET                  = NO
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = YES
WARN_IF_DOC_ERROR      = YES
WARN_NO_PARAMDOC       = YES

FILE_PATTERNS          = *.doxygen \
												 *.cpp \
												 *.C
